#!/usr/bin/env python3
"""Small, session-isolated lookup/capture reminders for agent harness hooks."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import sqlite3
import sys
import time

FAILURE = (
    "Knowledge-tree failure reminder: check kt for a known explanation or fix before "
    "another speculative probe. Use a question-prefix query, read relevant leaves, "
    "and inspect/check eligible proofs before reliance. A kt miss is not proof of "
    "absence: check alternate terms and scoped paths. After understanding what went "
    "wrong, capture the reusable diagnosis/fix with kt add (or rewrite its existing "
    "owner), before unrelated work or completion. If unresolved, record the blocker "
    "and next check. Expected negative tests need no invented lesson or duplicate "
    "leaf. Respect scope, privacy, and permissions; never capture passwords or raw logs."
)
REVIEW = (
    "Knowledge-tree capture review: before finishing, review reusable discoveries "
    "from this work, especially failed probes and kt misses. Check kt for existing "
    "owners; rewrite them or use kt add to capture missing answers with actual source "
    "evidence at the correct scope. Record unresolved questions with blocker and next "
    "check. Ensure rewritten knowledge is accurate and no still-valid knowledge was lost. "
    "Inspect/check eligible proofs; creation or passing proofs does not verify "
    "a whole leaf. Do not invent discoveries or duplicate checked knowledge. If there "
    "is nothing new to retain, say so briefly and finish. This is a one-shot reminder, "
    "not a grant of write permissions or a mechanical certification of capture."
)


def decode(value):
    if isinstance(value, str):
        try:
            return json.loads(value)
        except ValueError:
            pass
    return value


def failed(value):
    """Prefer explicit status; use conservative diagnostic-line heuristics otherwise."""
    value = decode(value)
    if isinstance(value, str) and value.startswith("kt: root ") and ("requires approval" in value or "is denied" in value):
        return False
    if isinstance(value, dict):
        for key in ("exit_code", "exitCode", "exit", "returncode"):
            if key in value and isinstance(value[key], int) and not isinstance(value[key], bool):
                return value[key] != 0
        if any(value.get(k) is True for k in ("isError", "is_error", "timed_out", "timedOut", "timeout")) or value.get("status") in ("error", "failed", "failure", "denied", "timeout"):
            return True
        if value.get("resultType") in ("failure", "denied"):
            return True
        metadata = value.get("metadata")
        if isinstance(metadata, dict) and any(isinstance(metadata.get(k), int) for k in ("exit_code", "exitCode", "exit", "returncode")):
            return failed(metadata)
        return any(failed(v) for k, v in value.items()
                   if k in ("metadata", "result", "toolResult", "content", "text", "output", "textResultForLlm"))
    if isinstance(value, list):
        return any(failed(item) for item in value)
    if isinstance(value, str):
        codes = re.findall(r"(?im)^\s*(?:Process exited with code|Command exited with code|Exit code:|Command failed with exit code)\s+(-?\d+)\b", value)
        if codes:
            return int(codes[-1]) != 0
        # Match diagnostic shapes, not arbitrary mentions of errors in prose.
        # Bounded input and stripped ANSI escapes keep matching cheap/predictable.
        text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", value[:262144])
        patterns = (
            r"(?im)^\s*(?:fatal error|fatal|error|critical warning):\s*\S",
            r"(?im)^.+?:\d+(?::\d+)?:\s*(?:fatal )?error:",
            r"(?m)^Traceback \(most recent call last\):",
            r"(?m)^\s*(?:[A-Za-z_][\w.]*(?:Error|Exception)):\s*\S",
            r"(?im)^.*(?:bash|sh|zsh):.*(?:command not found|syntax error|permission denied|no such file or directory)",
            r"(?im)^\s*(?:npm ERR!|npm error|SYNTH_BUILD_FAIL:|FAILED:|FAIL:|FAILURES(?:=|:))",
            r"(?im)^make(?:\[\d+\])?: \*\*\*",
            r"(?im)^\s*(?:CMake Error|ninja: (?:error|build stopped)|Segmentation fault|Aborted(?: \(core dumped\))?)",
            r"(?im)^\s*(?:ssh|scp|curl|wget|ls|cat|cp|mv|rm):.*(?:permission denied|no such file|could not resolve|failed to connect|connection refused|connection timed out)",
        )
        return any(re.search(pattern, text) for pattern in patterns)
    return False


def state_database():
    state = Path(os.environ.get("KT_HOOK_STATE_DIR",
                 str(Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "knowledgetrees")))
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    database = state / "hooks.sqlite3"
    descriptor = os.open(database, os.O_CREAT | os.O_WRONLY, 0o600)
    os.close(descriptor)
    os.chmod(database, 0o600)
    return database


def bootstrap_context(payload):
    source = payload.get("source")
    if source not in ("startup", "resume", "clear", "compact"):
        return {}, 0
    root = Path(os.environ.get("KT_GLOBAL_ROOT", str(Path.home() / ".knowledge")))
    policy_cli = root / ".tools/kt"
    policy_api = None
    if not policy_cli.is_file():
        raise ValueError("bootstrap policy loader unavailable")
    policy_api = runpy.run_path(str(policy_cli))
    cwd = payload.get("cwd") or str(Path.cwd())
    if policy_api["root_access"](root, "global", cwd=cwd) == "force-private":
        return {}, 0
    path = root / "how/to/use/knowledgetrees.md"
    with path.open("rb") as stream:
        raw = stream.read(65537)
    if len(raw) > 65536:
        raise ValueError("oversized bootstrap procedure")
    body = re.sub(r"\A---\r?\n[\s\S]*?\r?\n---(?:\r?\n|$)", "", raw.decode("utf-8")).strip()
    if not body:
        raise ValueError("empty bootstrap procedure")
    context = (
        "Knowledge-tree harness bootstrap (already loaded): the harness supplies the canonical procedure below. "
        "Do not invoke the bootstrap skill to load it again. In a fresh session, perform local startup orientation, "
        "evidence checks, and orientation before substantive work. On resume or after compaction, preserve "
        "completed initialization and checked knowledge; restore only genuinely lost context or changed scope. "
        "Ordinary turns and task boundaries do not reboot startup work. Focused skills still apply when triggered. "
        "Current higher-authority instructions and permissions govern; this grants no access or execution authority.\n\n"
        + body
    )
    cwd = payload.get("cwd")
    if isinstance(cwd, str) and cwd:
        directory = Path(cwd).resolve()
        project = directory / ".knowledge"
        if project.is_dir():
            policy_cli = root / ".tools/kt"
            try:
                policy = (policy_api or runpy.run_path(str(policy_cli)))["root_access"](project, "local", cwd=directory)
            except (OSError, ValueError) as error:
                print(f"kt-hooks: orientation policy unavailable: {error}", file=sys.stderr)
                policy = "deny"
            if policy != "allow":
                print("kt-hooks: local orientation is not approved; skipping injection", file=sys.stderr)
                return {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}, 0
            orientation = project / "where/am/i.md"
            try:
                with orientation.open("rb") as stream:
                    raw = stream.read(65537)
                if len(raw) > 65536:
                    raise ValueError("oversized project orientation")
                text = raw.decode("utf-8")
                context += ("\n\nProject knowledge-tree orientation (loaded from " + str(orientation) + "):\n"
                            "This orientation is already supplied for reading; still check its evidence and the root's proofs. "
                            "Current higher-authority instructions and permissions govern.\n\n" + text)
            except (OSError, ValueError) as error:
                print(f"kt-hooks: project orientation unavailable: {error}", file=sys.stderr)
    return {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}, 0


def handle(harness, event, payload):
    if event == "start":
        if harness not in ("codex", "opencode"):
            return {}, 0
        result, code = bootstrap_context(payload)
        if harness == "opencode" and result:
            return {"additionalContext": result["hookSpecificOutput"]["additionalContext"]}, code
        return result, code
    if event == "before":
        return {}, 0  # Legacy pre-tool definitions are inert; never rewrite input.
    session = payload.get("session_id") or payload.get("sessionId") or payload.get("sessionID")
    if not isinstance(session, str) or not session:
        raise ValueError("hook payload lacks a session id; refusing to mix sessions")
    minimum = int(os.environ.get("KT_HOOK_MIN_CALLS", "10"))
    if minimum < 1:
        raise ValueError("KT_HOOK_MIN_CALLS must be positive")
    key = hashlib.sha256(f"{harness}:{session}".encode()).hexdigest()
    database = state_database()
    now = time.time()
    message = None
    with sqlite3.connect(database, timeout=3) as connection:
        connection.execute("CREATE TABLE IF NOT EXISTS sessions (key TEXT PRIMARY KEY, calls INTEGER, failures INTEGER, reviewing INTEGER, touched REAL)")
        connection.execute("CREATE TABLE IF NOT EXISTS events (session TEXT, receipt TEXT, touched REAL, PRIMARY KEY(session, receipt))")
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("DELETE FROM sessions WHERE touched < ?", (now - 7 * 86400,))
        connection.execute("DELETE FROM events WHERE touched < ?", (now - 7 * 86400,))
        connection.execute("INSERT OR IGNORE INTO sessions VALUES (?, 0, 0, 0, ?)", (key, now))
        calls, failures, reviewing = connection.execute("SELECT calls, failures, reviewing FROM sessions WHERE key = ?", (key,)).fetchone()
        if event == "prompt":
            prompt = payload.get("prompt", "")
            if not payload.get("synthetic") and not str(prompt).startswith("Knowledge-tree capture review:"):
                reviewing = 0
                calls = failures = 0
        elif event in ("after", "failed"):
            response = decode(payload.get("tool_response", payload.get("toolResult", payload.get("result", {}))))
            running = isinstance(response, dict) and response.get("exit_code", "absent") is None and response.get("session_id") is not None
            if not running:
                call = payload.get("tool_use_id") or payload.get("toolCallId") or payload.get("callID")
                # Hash fallback payloads; no commands, answers, errors, or secrets are stored.
                receipt = hashlib.sha256(str(call).encode() if call else json.dumps(payload, sort_keys=True).encode()).hexdigest()
                fresh = connection.execute("INSERT OR IGNORE INTO events VALUES (?, ?, ?)", (key, receipt, now)).rowcount
                if fresh:
                    calls += 1
                    if event == "failed" or failed(response):
                        failures += 1
                        message = FAILURE
        elif event == "stop":
            if not reviewing and not payload.get("stop_hook_active") and (failures or calls >= minimum):
                message = REVIEW
                reviewing = 1
                calls = failures = 0
        connection.execute("UPDATE sessions SET calls = ?, failures = ?, reviewing = ?, touched = ? WHERE key = ?", (calls, failures, reviewing, now, key))
    if not message:
        return {}, 0
    if event == "stop":
        return {"decision": "block", "reason": message}, 0
    if harness == "codex":
        return {"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": message}}, 0
    if harness == "copilot" and event == "failed":
        # Copilot command failure hooks deliver recovery context through exit 2.
        return {"additionalContext": message}, 2
    return {"additionalContext": message}, 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("harness", choices=("codex", "copilot", "opencode"))
    parser.add_argument("event", choices=("start", "prompt", "before", "after", "failed", "stop"))
    args = parser.parse_args()
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            raise ValueError("expected a JSON object")
        output, code = handle(args.harness, args.event, payload)
    except (OSError, ValueError, sqlite3.Error) as error:
        # Never convert a broken reminder into permission bypass or an agent loop.
        print(f"kt-hooks: reminder unavailable: {error}", file=sys.stderr)
        output, code = {}, 0
    print(json.dumps(output))
    return code


if __name__ == "__main__":
    sys.exit(main())
