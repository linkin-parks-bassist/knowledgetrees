#!/usr/bin/env python3
"""Startup context and per-turn maintenance reminders for agent harness hooks."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import sqlite3
import subprocess
import sys
import time

FAILURE = (
    "Knowledge-tree failure reminder: check kt for a known explanation or fix before "
    "another speculative probe. Use the kt tools (kt_lookup with a question prefix, kt_read; "
    "the kt shell command only if you have no kt tools), read relevant leaves, "
    "and inspect/check eligible proofs before reliance; renew a yellow leaf only after verifying it. A kt miss is not proof of "
    "absence: check alternate terms and scoped paths. After understanding what went "
    "wrong, capture the reusable diagnosis/fix with kt_add (or kt_edit its existing "
    "owner), before unrelated work or completion. If unresolved, record the blocker "
    "and next check. Expected negative tests need no invented lesson or duplicate "
    "leaf. Respect scope, privacy, and permissions; never capture passwords or raw logs."
)
MAINTAIN = (
    "Knowledge-tree maintenance before finishing: invoke the knowledgetrees-maintenance skill "
    "(or follow how/to/maintain/a/knowledge/tree.md) for each tree touched by the work, "
    "direction, or decisions since your last maintenance pass. Update the leaves whose answers "
    "changed, capture new leaf-worthy knowledge (user guidance, resolved kt misses, reusable "
    "discoveries, decisions) at its owning scope with actual "
    "evidence, and rewrite or remove leaves that can no longer be accurate or relevant. After "
    "repository work, update the frontier in what/is/the/plan.md: remove completed steps and add "
    "newly planned ones. Rewrite "
    "answers in place; never append logs, and never duplicate an existing owner. If nothing "
    "leaf-worthy changed, say so in one line and finish. This reminder is rate-limited per "
    "session and grants no write permissions."
)


# Claude Code replaces hook context past ~10,000 characters with a file pointer and a short
# preview (observed live with a 10,034-byte `kt info` output), so oversized info output is never sent.
CLAUDE_CONTEXT_LIMIT = 9500


def decode(value):
    if isinstance(value, str):
        try:
            return json.loads(value)
        except ValueError:
            pass
    return value


def failed(value):
    """Prefer explicit status; use conservative diagnostic-line heuristics otherwise."""
    value = decode(value)
    if isinstance(value, str) and value.startswith("kt: root ") and ("requires approval" in value or "is denied" in value):
        return False
    if isinstance(value, dict):
        for key in ("exit_code", "exitCode", "exit", "returncode"):
            if key in value and isinstance(value[key], int) and not isinstance(value[key], bool):
                return value[key] != 0
        if any(value.get(k) is True for k in ("isError", "is_error", "timed_out", "timedOut", "timeout")) or value.get("status") in ("error", "failed", "failure", "denied", "timeout"):
            return True
        if value.get("resultType") in ("failure", "denied"):
            return True
        metadata = value.get("metadata")
        if isinstance(metadata, dict) and any(isinstance(metadata.get(k), int) for k in ("exit_code", "exitCode", "exit", "returncode")):
            return failed(metadata)
        return any(failed(v) for k, v in value.items()
                   if k in ("metadata", "result", "toolResult", "content", "text", "output", "textResultForLlm"))
    if isinstance(value, list):
        return any(failed(item) for item in value)
    if isinstance(value, str):
        codes = re.findall(r"(?im)^\s*(?:Process exited with code|Command exited with code|Exit code:|Command failed with exit code)\s+(-?\d+)\b", value)
        if codes:
            return int(codes[-1]) != 0
        # Match diagnostic shapes, not arbitrary mentions of errors in prose.
        # Bounded input and stripped ANSI escapes keep matching cheap/predictable.
        text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", value[:262144])
        patterns = (
            r"(?im)^\s*(?:fatal error|fatal|error|critical warning):\s*\S",
            r"(?im)^.+?:\d+(?::\d+)?:\s*(?:fatal )?error:",
            r"(?m)^Traceback \(most recent call last\):",
            r"(?m)^\s*(?:[A-Za-z_][\w.]*(?:Error|Exception)):\s*\S",
            r"(?im)^.*(?:bash|sh|zsh):.*(?:command not found|syntax error|permission denied|no such file or directory)",
            r"(?im)^\s*(?:npm ERR!|npm error|SYNTH_BUILD_FAIL:|FAILED:|FAIL:|FAILURES(?:=|:))",
            r"(?im)^make(?:\[\d+\])?: \*\*\*",
            r"(?im)^\s*(?:CMake Error|ninja: (?:error|build stopped)|Segmentation fault|Aborted(?: \(core dumped\))?)",
            r"(?im)^\s*(?:ssh|scp|curl|wget|ls|cat|cp|mv|rm):.*(?:permission denied|no such file|could not resolve|failed to connect|connection refused|connection timed out)",
        )
        return any(re.search(pattern, text) for pattern in patterns)
    return False


def state_database():
    state = Path(os.environ.get("KT_HOOK_STATE_DIR",
                 str(Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "knowledgetrees")))
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    database = state / "hooks.sqlite3"
    descriptor = os.open(database, os.O_CREAT | os.O_WRONLY, 0o600)
    os.close(descriptor)
    os.chmod(database, 0o600)
    return database


def startup_context(payload, limit=None, harness=None):
    source = payload.get("source")
    if source not in ("startup", "resume", "new", "clear", "compact"):
        return {}, 0
    cli = Path(os.environ.get("KT_INFO_CLI", str(Path(__file__).resolve().with_name("kt"))))
    cwd = payload.get("cwd") or os.getcwd()
    info = subprocess.run([sys.executable, str(cli), "--lean", "info"], cwd=cwd,
                          text=True, capture_output=True)
    context = ("Knowledge-tree startup: `kt info` output follows (leaf metadata omitted; a notice marks any non-green leaf). "
               "Consume it through the final proof summary.\n")
    if harness == "codex":
        context += ("Codex tool names may be prefixed `mcp__knowledgetrees__kt_` (for example "
                    "`mcp__knowledgetrees__kt_lookup`); check the full tool registry before treating "
                    "knowledge-tree MCP tools as unavailable or falling back to the `kt` shell.\n")
    if info.returncode:
        context += f"kt info failed (exit {info.returncode}); diagnose before relying on this tree.\n"
    output = info.stdout + info.stderr
    if limit is not None and len((context + output).encode()) > limit:
        context = (f"Knowledge-tree startup: `kt info` produced {len(output.encode())} bytes, more than this "
                   f"harness will inject from a hook (about {limit}).")
        if info.returncode:
            context += f" It exited {info.returncode}."
        tool_name = "mcp__knowledgetrees__kt_info" if harness == "codex" else "kt_info"
        context += (f" Call the {tool_name} tool now (or run `kt info` in the shell if you have no kt tools), unfiltered and "
                    "untruncated, and consume its complete output through the final proof summary before other work.")
        return {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}, 0
    context += output
    return {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}, 0


def session_key(harness, payload):
    session = payload.get("session_id") or payload.get("sessionId") or payload.get("sessionID")
    if not isinstance(session, str) or not session:
        raise ValueError("hook payload lacks a session id; refusing to mix sessions")
    return hashlib.sha256(f"{harness}:{session}".encode()).hexdigest()


# A call writes the tree when it is a kt mutation tool (any MCP prefix) or a kt shell mutation.
TREE_WRITE = re.compile(r"(?:^|[^A-Za-z0-9])kt_(?:rewrite|edit|add|rm|mv|combine|renew|undo)(?![A-Za-z0-9_])"
                        r"|(?:^|[^\w.-])kt\s+(?:rewrite|add|rm|mv|combine|renew)\b")
CODE_EDITS = {"edit", "write", "multiedit", "notebookedit", "patch", "apply_patch"}
PATCH = re.compile(r"\bapply_patch\b|\*\*\* Begin Patch")
TRANSCRIPT_TAIL = 4 * 1024 * 1024


def entry_turn_start(entry):
    """True for the entry that begins a user turn in a Claude Code or Codex transcript."""
    if entry.get("type") == "user" and not entry.get("isSidechain") and not entry.get("isMeta"):
        content = (entry.get("message") or {}).get("content")
        return isinstance(content, str) or (isinstance(content, list) and not any(
            isinstance(part, dict) and part.get("type") == "tool_result" for part in content))
    return entry.get("type") == "event_msg" and (entry.get("payload") or {}).get("type") == "task_started"


def entry_calls(entry):
    """(name, input text) for each tool call a transcript entry records."""
    if entry.get("type") == "assistant" and not entry.get("isSidechain"):
        content = (entry.get("message") or {}).get("content")
        return [(str(part.get("name", "")), json.dumps(part.get("input", "")))
                for part in content if isinstance(part, dict) and part.get("type") == "tool_use"] if isinstance(content, list) else []
    payload = entry.get("payload") or {}
    if entry.get("type") == "response_item" and payload.get("type") in ("custom_tool_call", "function_call"):
        return [(str(payload.get("name", "")), str(payload.get("input", payload.get("arguments", ""))))]
    return []


def turn_calls(payload):
    """Tool calls since the current turn began, or None when they cannot be established."""
    tools = payload.get("tools")
    if isinstance(tools, list):  # The OpenCode plugin reports its own per-turn calls.
        return [(str(t.get("name", "")), json.dumps(t.get("input", ""))) for t in tools if isinstance(t, dict)]
    path = payload.get("transcript_path") or payload.get("transcriptPath")
    if not isinstance(path, str) or not path:
        return None
    # The transcript formats are unstable, so read a bounded tail and fail toward reminding.
    with open(path, "rb") as transcript:
        transcript.seek(0, os.SEEK_END)
        size = transcript.tell()
        transcript.seek(max(0, size - TRANSCRIPT_TAIL))
        lines = transcript.read().splitlines()[1 if size > TRANSCRIPT_TAIL else 0:]
    calls = None
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if not isinstance(entry, dict):
            continue
        if entry_turn_start(entry):
            calls = []
        elif calls is not None:
            calls.extend(entry_calls(entry))
    return calls


def maintained(calls):
    """True when this turn already wrote the tree and edited no code afterward."""
    wrote = False
    for name, text in calls:
        if name.rsplit("__", 1)[-1].lower() in CODE_EDITS or PATCH.search(text):
            wrote = False
        elif TREE_WRITE.search(name) or TREE_WRITE.search(text):
            wrote = True
    return wrote


def maintenance(harness, payload):
    """Request a maintenance continuation at most once per interval per session, never a loop."""
    active = payload.get("stop_hook_active")
    if active is True:
        return {}  # Claude Code and Codex mark the stop that ends a hook-requested continuation.
    key = session_key(harness, payload)
    interval = float(os.environ.get("KT_HOOK_MAINTENANCE_INTERVAL", "300"))
    try:
        calls = turn_calls(payload)
    except OSError:
        calls = None
    now = time.time()
    with sqlite3.connect(state_database(), timeout=3) as connection:
        connection.execute("DROP TABLE IF EXISTS maintenance")
        connection.execute("CREATE TABLE IF NOT EXISTS maintenance_turns (key TEXT PRIMARY KEY, pending INTEGER, last REAL, touched REAL)")
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("DELETE FROM maintenance_turns WHERE touched < ?", (now - 7 * 86400,))
        row = connection.execute("SELECT pending, last FROM maintenance_turns WHERE key = ?", (key,)).fetchone()
        pending, last = row if row else (0, 0.0)
        remind = False
        if active is None and pending:
            # Copilot and OpenCode carry no continuation flag; this stop ends the requested pass.
            pending = 0
        elif calls and maintained(calls):
            last = now  # The agent maintained the tree unprompted; restart the interval.
        elif now - last >= interval:
            remind, last, pending = True, now, int(active is None)
        connection.execute("INSERT OR REPLACE INTO maintenance_turns VALUES (?, ?, ?, ?)", (key, pending, last, now))
    return {"decision": "block", "reason": MAINTAIN} if remind else {}


def handle(harness, event, payload):
    if event == "start":
        limit = int(os.environ.get("KT_HOOK_CONTEXT_LIMIT", CLAUDE_CONTEXT_LIMIT)) if harness == "claude" else None
        result, code = startup_context(payload, limit, harness)
        if harness in ("opencode", "copilot") and result:
            return {"additionalContext": result["hookSpecificOutput"]["additionalContext"]}, code
        return result, code
    if event == "before":
        return {}, 0  # Legacy pre-tool definitions are inert; never rewrite input.
    if event == "stop":
        return maintenance(harness, payload), 0
    key = session_key(harness, payload)
    database = state_database()
    now = time.time()
    message = None
    with sqlite3.connect(database, timeout=3) as connection:
        connection.execute("CREATE TABLE IF NOT EXISTS sessions (key TEXT PRIMARY KEY, calls INTEGER, failures INTEGER, reviewing INTEGER, touched REAL)")
        connection.execute("CREATE TABLE IF NOT EXISTS events (session TEXT, receipt TEXT, touched REAL, PRIMARY KEY(session, receipt))")
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("DELETE FROM sessions WHERE touched < ?", (now - 7 * 86400,))
        connection.execute("DELETE FROM events WHERE touched < ?", (now - 7 * 86400,))
        connection.execute("INSERT OR IGNORE INTO sessions VALUES (?, 0, 0, 0, ?)", (key, now))
        calls, failures, reviewing = connection.execute("SELECT calls, failures, reviewing FROM sessions WHERE key = ?", (key,)).fetchone()
        if event == "prompt":
            prompt = payload.get("prompt", "")
            if not payload.get("synthetic") and not str(prompt).startswith("Knowledge-tree capture review:"):
                reviewing = 0
                calls = failures = 0
        elif event in ("after", "failed"):
            response = decode(payload.get("tool_response", payload.get("toolResult", payload.get("result", {}))))
            running = isinstance(response, dict) and response.get("exit_code", "absent") is None and response.get("session_id") is not None
            if not running:
                call = payload.get("tool_use_id") or payload.get("toolCallId") or payload.get("callID")
                # Hash fallback payloads; no commands, answers, errors, or secrets are stored.
                receipt = hashlib.sha256(str(call).encode() if call else json.dumps(payload, sort_keys=True).encode()).hexdigest()
                fresh = connection.execute("INSERT OR IGNORE INTO events VALUES (?, ?, ?)", (key, receipt, now)).rowcount
                if fresh:
                    calls += 1
                    # Claude Code reports failures through its own event; its success
                    # payloads carry no exit status, so heuristics would only add noise.
                    if harness == "claude":
                        broken = event == "failed" and not payload.get("is_interrupt")
                    else:
                        broken = event == "failed" or failed(response)
                    if broken:
                        failures += 1
                        message = FAILURE
        connection.execute("UPDATE sessions SET calls = ?, failures = ?, reviewing = ?, touched = ? WHERE key = ?", (calls, failures, reviewing, now, key))
    if not message:
        return {}, 0
    if harness == "codex":
        return {"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": message}}, 0
    if harness == "claude":
        return {"hookSpecificOutput": {"hookEventName": "PostToolUseFailure", "additionalContext": message}}, 0
    if harness == "copilot" and event == "failed":
        # Copilot command failure hooks deliver recovery context through exit 2.
        return {"additionalContext": message}, 2
    return {"additionalContext": message}, 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("harness", choices=("claude", "codex", "copilot", "opencode"))
    parser.add_argument("event", choices=("start", "prompt", "before", "after", "failed", "stop"))
    args = parser.parse_args()
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            raise ValueError("expected a JSON object")
        output, code = handle(args.harness, args.event, payload)
    except (OSError, ValueError, sqlite3.Error) as error:
        # Never convert a broken reminder into permission bypass or an agent loop.
        print(f"kt-hooks: reminder unavailable: {error}", file=sys.stderr)
        output, code = {}, 0
    print(json.dumps(output))
    return code


if __name__ == "__main__":
    sys.exit(main())
