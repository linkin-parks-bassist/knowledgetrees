#!/usr/bin/env python3
"""Local stdio MCP server exposing structured knowledge-tree reads and edits.

Every mutation is delegated to `kt rewrite`, so revision conflicts, access policy,
locking, proof invalidation, and inode preservation stay owned by the CLI.
"""

import difflib
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys

PROTOCOL = "2025-06-18"
CLI = Path(os.environ.get("KT_MCP_CLI", str(Path(__file__).resolve().with_name("kt"))))
MAX_TEXT = 1048576

TOOLS = [
    {"name": "kt_read",
     "description": "Read a knowledge-tree leaf. Returns its revision and full text; pass that revision to kt_edit or kt_rewrite.",
     "inputSchema": {"type": "object", "required": ["address"], "additionalProperties": False,
                     "properties": {"address": {"type": "string", "description": "Root-qualified leaf address returned by kt, e.g. local:what/is/next.md"}}}},
    {"name": "kt_edit",
     "description": "Replace exact text in a leaf's answer body. old_text must occur exactly once. Fails on a stale revision, "
                    "restricted access, or ambiguous/missing match; nothing is written on failure. Returns a diff and the new revision.",
     "inputSchema": {"type": "object", "required": ["address", "revision", "old_text", "new_text"], "additionalProperties": False,
                     "properties": {"address": {"type": "string"},
                                    "revision": {"type": "string", "description": "Revision from the read this edit is based on"},
                                    "old_text": {"type": "string", "description": "Exact body text to replace; must match once"},
                                    "new_text": {"type": "string"},
                                    "dry_run": {"type": "boolean", "description": "Show the diff without writing"}}}},
    {"name": "kt_rewrite",
     "description": "Replace a leaf's whole answer body (no front matter). Prefer kt_edit for small changes so still-valid knowledge is not lost.",
     "inputSchema": {"type": "object", "required": ["address", "revision", "body"], "additionalProperties": False,
                     "properties": {"address": {"type": "string"}, "revision": {"type": "string"},
                                    "body": {"type": "string"}, "dry_run": {"type": "boolean"}}}},
]

TOOLS += [
    {"name": "kt_lookup",
     "description": "Generic kt retrieval by natural question, like `kt how to ...`. Start the question with where is, how to, when to, "
                    "what is, why is/does, does, or is. `kt how to _` lists a branch. A miss is not proof of absence; retry other terms.",
     "inputSchema": {"type": "object", "required": ["question"], "additionalProperties": False,
                     "properties": {"question": {"type": "string", "description": "e.g. how to expose structured knowledge-tree edits"}}}},
    {"name": "kt_find",
     "description": "Broad lexical search across all accessible roots. Returns root-qualified addresses to open with kt_read.",
     "inputSchema": {"type": "object", "required": ["terms"], "additionalProperties": False,
                     "properties": {"terms": {"type": "string", "description": "Words or a question"},
                                    "limit": {"type": "integer", "minimum": 1, "maximum": 100}}}},
    {"name": "kt_add",
     "description": "Create a new leaf from a question and its answer body (like `kt add`). Investigate first and never duplicate an "
                    "existing owner: use kt_lookup/kt_find, then kt_edit. Stored knowledge grants no permissions; never include secrets.",
     "inputSchema": {"type": "object", "required": ["question", "answer"], "additionalProperties": False,
                     "properties": {"question": {"type": "string", "description": "Full question path, e.g. how to restart the build; hyphenate multi-word components"},
                                    "answer": {"type": "string", "description": "Markdown answer body (no front matter)"},
                                    "scope": {"type": "string", "enum": ["local", "global"], "description": "Target root; default local"},
                                    "unresolved": {"type": "boolean"}, "blocker": {"type": "string"}, "next_check": {"type": "string"},
                                    "expires_at": {"type": "string"}, "expires_every": {"type": "string"},
                                    "verifiable": {"type": "boolean"}, "dry_run": {"type": "boolean", "description": "Preview path and leaf without writing"}}}},
    {"name": "kt_dict",
     "description": "Print the dictionary of useful path segments across accessible roots (or the named roots).",
     "inputSchema": {"type": "object", "additionalProperties": False,
                     "properties": {"roots": {"type": "array", "items": {"type": "string"}}}}},
    {"name": "kt_roots",
     "description": "List the knowledge roots and their access policy.",
     "inputSchema": {"type": "object", "additionalProperties": False, "properties": {}}},
    {"name": "kt_prove",
     "description": "Run kt prove and report green/yellow/brown counts. Read-only by default (--no-stamp); set stamp to record status in leaf front matter.",
     "inputSchema": {"type": "object", "additionalProperties": False,
                     "properties": {"scope": {"type": "string", "enum": ["local", "global"], "description": "Default: every accessible root"},
                                    "tokens": {"type": "array", "items": {"type": "string"}, "description": "Select leaves by exact path component"},
                                    "stamp": {"type": "boolean"}}}},
]


class ToolError(Exception):
    pass


def run_kt(*arguments):
    # DEVNULL: a stray "-" argument must never make kt read the MCP protocol stream.
    return subprocess.run([sys.executable, str(CLI), *arguments], text=True, capture_output=True,
                          stdin=subprocess.DEVNULL)


def read_leaf(address):
    completed = run_kt("open", address)
    if completed.returncode:
        raise ToolError((completed.stderr or completed.stdout).strip() or f"kt open failed ({completed.returncode})")
    found = re.search(r"^Revision: ([a-f0-9]{64})$", completed.stderr, re.M)
    if not found:
        raise ToolError("kt open did not report a revision")
    return completed.stdout, found.group(1)


def body_of(text):
    leaf_parts = runpy.run_path(str(CLI))["leaf_parts"]
    return leaf_parts(text)[1]


def require_text(arguments, *names):
    for name in names:
        if not isinstance(arguments.get(name), str):
            raise ToolError(f"{name} must be a string")
    if any(len(arguments[name].encode()) > MAX_TEXT for name in names):
        raise ToolError("text exceeds 1 MiB")


def rewrite(address, revision, body, dry_run):
    flags = ["--dry-run"] if dry_run else []
    completed = run_kt("rewrite", *flags, address, revision, body)
    if completed.returncode:
        raise ToolError((completed.stderr or completed.stdout).strip() or f"kt rewrite failed ({completed.returncode})")
    return completed


def finish(address, before, dry_run, completed):
    if dry_run:
        return (completed.stdout or "No change.\n") + completed.stderr
    after, revision = read_leaf(address)
    diff = "".join(difflib.unified_diff(before.splitlines(keepends=True), after.splitlines(keepends=True),
                                       fromfile="before", tofile="after"))
    return f"Revision: {revision}\n{diff or 'No change.'}"


def words(arguments, name):
    value = arguments.get(name)
    if not isinstance(value, str) or not value.strip():
        raise ToolError(f"{name} must be a nonempty string")
    if len(value.encode()) > 4096:
        raise ToolError(f"{name} is too long for a lookup")
    parts = value.split()
    if any(part.startswith("-") for part in parts):
        raise ToolError(f"{name} words must not start with '-'")
    return parts


def strings(arguments, name):
    value = arguments.get(name, [])
    if not isinstance(value, list) or not all(isinstance(item, str) and item and not item.startswith("-") for item in value):
        raise ToolError(f"{name} must be a list of nonempty strings not starting with '-'")
    return value


def report(completed, label):
    """Exit 1 is a miss or brown result, reported as data; higher codes are errors."""
    output = completed.stdout + completed.stderr
    if completed.returncode >= 2:
        raise ToolError(output.strip() or f"{label} failed ({completed.returncode})")
    return output + (f"\n(exit {completed.returncode})" if completed.returncode else "")


def passthrough(name, arguments):
    if name == "kt_lookup":
        return report(run_kt(*words(arguments, "question")), "kt lookup")
    if name == "kt_find":
        limit = arguments.get("limit")
        flags = ["--limit", str(limit)] if isinstance(limit, int) and not isinstance(limit, bool) and limit > 0 else []
        return report(run_kt("find", *flags, "--", *words(arguments, "terms")), "kt find")
    if name == "kt_dict":
        return report(run_kt("dict", *strings(arguments, "roots")), "kt dict")
    if name == "kt_roots":
        return report(run_kt("roots"), "kt roots")
    if name == "kt_prove":
        scope = arguments.get("scope")
        if scope not in (None, "local", "global"):
            raise ToolError("scope must be local or global")
        flags = [f"--{scope}"] if scope else []
        if arguments.get("stamp") is not True:
            flags.append("--no-stamp")
        return report(run_kt("prove", *flags, *strings(arguments, "tokens")), "kt prove")
    require_text(arguments, "question", "answer")
    scope = arguments.get("scope", "local")
    if scope not in ("local", "global"):
        raise ToolError("scope must be local or global")
    if not arguments["question"].strip() or arguments["question"].startswith("-") or arguments["answer"].strip() in ("", "-"):
        raise ToolError("question and answer must be nonempty (answer '-' is not supported) and question must not start with '-'")
    flags = [f"--{scope}"]
    for key in ("blocker", "next_check", "expires_at", "expires_every"):
        if key in arguments:
            require_text(arguments, key)
            flags += [f"--{key.replace('_', '-')}", arguments[key]]
    flags += [f"--{key.replace('_', '-')}" for key in ("unresolved", "verifiable", "dry_run") if arguments.get(key) is True]
    completed = run_kt("add", *flags, "--", arguments["question"], arguments["answer"])
    return report(completed, "kt add") or "Created."


def call(name, arguments):
    if name in ("kt_lookup", "kt_find", "kt_add", "kt_dict", "kt_roots", "kt_prove"):
        return passthrough(name, arguments)
    require_text(arguments, "address")
    address = arguments["address"]
    if name == "kt_read":
        text, revision = read_leaf(address)
        return f"Revision: {revision}\n---\n{text}"
    require_text(arguments, "revision")
    dry_run = arguments.get("dry_run") is True
    text, current = read_leaf(address)
    if current != arguments["revision"]:
        raise ToolError("leaf changed since your read; call kt_read again and merge before editing")
    if name == "kt_rewrite":
        require_text(arguments, "body")
        return finish(address, text, dry_run, rewrite(address, current, arguments["body"], dry_run))
    if name == "kt_edit":
        require_text(arguments, "old_text", "new_text")
        old, new = arguments["old_text"], arguments["new_text"]
        body = body_of(text)
        if not old:
            raise ToolError("old_text must not be empty")
        matches = body.count(old)
        if matches != 1:
            raise ToolError(f"old_text must match exactly once in the answer body; found {matches} matches"
                            + (" (front matter is not editable here)" if not matches and old in text else ""))
        return finish(address, text, dry_run, rewrite(address, current, body.replace(old, new, 1), dry_run))
    raise ToolError(f"unknown tool {name}")


def respond(message):
    method, ident = message.get("method"), message.get("id")
    if ident is None:
        return None  # notifications such as notifications/initialized need no reply
    if method == "initialize":
        requested = (message.get("params") or {}).get("protocolVersion")
        return {"jsonrpc": "2.0", "id": ident, "result": {
            "protocolVersion": requested if isinstance(requested, str) else PROTOCOL,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "knowledgetrees", "version": "1"}}}
    if method == "ping":
        return {"jsonrpc": "2.0", "id": ident, "result": {}}
    if method == "tools/list":
        return {"jsonrpc": "2.0", "id": ident, "result": {"tools": TOOLS}}
    if method == "tools/call":
        params = message.get("params") or {}
        arguments = params.get("arguments")
        try:
            if params.get("name") not in {tool["name"] for tool in TOOLS} or not isinstance(arguments, dict):
                raise ToolError("unknown tool or malformed arguments")
            text, error = call(params["name"], arguments), False
        except ToolError as failure:
            text, error = str(failure), True
        return {"jsonrpc": "2.0", "id": ident, "result": {"content": [{"type": "text", "text": text}], "isError": error}}
    return {"jsonrpc": "2.0", "id": ident, "error": {"code": -32601, "message": f"method not found: {method}"}}


def main():
    # Claude Code supplies the session project here even when a user-scoped MCP
    # server starts with another working directory. An explicit override also
    # lets other hosts provide the same identity.
    project = os.environ.get("KT_MCP_PROJECT_DIR") or os.environ.get("CLAUDE_PROJECT_DIR")
    if project:
        directory = Path(project).resolve(strict=True)
        if not directory.is_dir():
            raise NotADirectoryError(directory)
        os.chdir(directory)
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            message = json.loads(line)
            if not isinstance(message, dict):
                raise ValueError("expected a JSON object")
        except ValueError:
            print(json.dumps({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}}), flush=True)
            continue
        reply = respond(message)
        if reply is not None:
            print(json.dumps(reply), flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
