def tool_info(arguments):
    return report(run_kt("--lean", "info", timeout=120), "kt info")


def tool_lookup(arguments):
    completed = run_kt("--lean", *words(arguments, "question"))
    exact = re.search(r"^kt: exact (\S+)$", completed.stderr, re.M)
    if completed.returncode == 0 and exact:
        text, _revision = read_leaf(exact[1])
        note_read(exact[1], body_of(text))
        return f"[{exact[1]}]\n{completed.stdout}"
    return report(completed, "kt lookup")


def parse_find(output):
    lines = output.splitlines()
    results = []
    for line in lines[1:]:
        parts = line.split("\t")
        if len(parts) < 2 or ":" not in parts[0]:
            continue
        item = {"address": parts[0]}
        for part in parts[1:]:
            coverage = re.fullmatch(r"coverage=(\d+)%( weak)?", part)
            if coverage:
                item["coverage"], item["weak"] = int(coverage[1]), bool(coverage[2])
            elif part in ("green", "yellow", "brown"):
                item["status"] = part
            else:
                item["excerpt"] = part
        item.setdefault("status", "green")  # lean output names only non-green leaves
        results.append(item)
    return {"summary": lines[0] if lines else "", "results": results}


def tool_find(arguments):
    limit = int_arg(arguments, "limit", minimum=1, maximum=100)
    completed = run_kt("--lean", "find", *(["--limit", str(limit)] if limit else []), "--", *words(arguments, "terms"))
    text = report(completed, "kt find")
    if arguments.get("json") is True:
        structured = {**parse_find(completed.stdout), "exit": completed.returncode}
        return json.dumps(structured), structured
    return text


def tool_grep(arguments):
    pattern = text_arg(arguments, "pattern", limit=1000)
    if not pattern:
        raise ToolError("pattern must not be empty")
    flags = []
    for key, flag in (("regex", "-E"), ("ignore_case", "-i"), ("files_only", "-l")):
        if arguments.get(key) is True:
            flags.append(flag)
    context = int_arg(arguments, "context", minimum=0, maximum=10)
    limit = int_arg(arguments, "limit", minimum=1, maximum=500)
    flags += ["-C", str(context)] if context else []
    flags += ["--limit", str(limit)] if limit else []
    return report(run_kt("grep", *flags, "--", pattern, timeout=20), "kt grep")


def tool_read(arguments):
    address = text_arg(arguments, "address")
    text, _revision = read_leaf(address)
    note_read(address, body_of(text))
    return kt_namespace()["lean_leaf"](text, address)


def tool_renew(arguments):
    address = text_arg(arguments, "address")
    _text, revision = seen_answer(address)
    completed = run_kt("renew", address, revision)
    if completed.returncode == 4:
        raise ToolError("the leaf changed since you read it; kt_read it again, verify it, then renew")
    output = report(completed, "kt renew")
    if not completed.returncode:
        return "Renewed." + (f" {output.strip()}" if output.strip() else "")
    return output


def tool_edit(arguments):
    dry_run = arguments.get("dry_run") is True
    address = text_arg(arguments, "address")
    edits = arguments.get("edits")
    if edits is None:
        edits = [{"old_text": text_arg(arguments, "old_text"), "new_text": text_arg(arguments, "new_text")}]
    elif "old_text" in arguments or "new_text" in arguments:
        raise ToolError("give either old_text/new_text or edits, not both")
    if not isinstance(edits, list) or not 1 <= len(edits) <= 50:
        raise ToolError("edits must be a list of 1 to 50 items")
    text, revision = seen_answer(address)
    before = body_of(text)
    body = before
    for number, edit in enumerate(edits, 1):
        label = f"edit {number}: " if len(edits) > 1 else ""
        if not isinstance(edit, dict):
            raise ToolError(f"{label}each edit must be an object with old_text and new_text")
        old, new = text_arg(edit, "old_text"), text_arg(edit, "new_text")
        if not old:
            raise ToolError(f"{label}old_text must not be empty")
        matches = body.count(old)
        if matches != 1:
            raise ToolError(f"{label}old_text must match exactly once in the answer; found {matches} matches")
        body = body.replace(old, new, 1)
    if dry_run:
        rewrite(address, revision, body, dry_run=True)  # validates the change without writing
        return answer_diff(before.strip("\n") + "\n", body.strip("\n") + "\n")
    rewrite(address, revision, body)
    after = body_of(read_leaf(address)[0])
    if after != before:
        HISTORY.append({"address": address, "before": before, "after": after})
    note_read(address, after)
    return answer_diff(before, after)


def tool_undo(arguments):
    dry_run = arguments.get("dry_run") is True
    address = text_arg(arguments, "address")
    record = next((item for item in reversed(HISTORY) if item["address"] == address), None)
    if record is None:
        raise ToolError("nothing to undo for this leaf in this server session (history is in memory, last "
                        f"{UNDO_DEPTH} edits)")
    text, revision = read_leaf(address)
    if body_of(text) != record["after"]:
        raise ToolError("the leaf changed after the recorded edit, so undo is refused to protect later work; "
                        "kt_read it and merge by hand")
    rewrite(address, revision, record["before"], dry_run)
    if dry_run:
        return answer_diff(record["after"], record["before"])
    HISTORY.remove(record)
    restored = body_of(read_leaf(address)[0])
    note_read(address, restored)
    return answer_diff(record["after"], restored)


def tool_add(arguments):
    question = text_arg(arguments, "question", limit=2048)
    answer = text_arg(arguments, "answer")
    scope = arguments.get("scope", "local")
    if scope not in ("local", "global"):
        raise ToolError("scope must be local or global")
    if not question.strip() or question.startswith("-") or answer.strip() in ("", "-"):
        raise ToolError("question and answer must be nonempty (answer '-' is not supported) and question must not start with '-'")
    flags = [f"--{scope}"]
    for key in ("blocker", "next_check", "expires_at", "expires_every"):
        if key in arguments:
            flags += [f"--{key.replace('_', '-')}", text_arg(arguments, key, limit=4096)]
    flags += [f"--{key.replace('_', '-')}" for key in ("unresolved", "verifiable", "dry_run") if arguments.get(key) is True]
    return report(run_kt("add", *flags, "--", question, answer), "kt add") or "Created."


def tool_dict(arguments):
    return report(run_kt("dict", *strings(arguments, "roots")), "kt dict")


def tool_roots(arguments):
    return report(run_kt("roots"), "kt roots")


def tool_prove(arguments):
    flags = scope_flag(arguments)
    if arguments.get("stamp") is not True:
        flags.append("--no-stamp")
    return report(run_kt("prove", *flags, *strings(arguments, "tokens"), timeout=300), "kt prove")


def tool_status(arguments):
    return report(run_kt("status", *scope_flag(arguments)), "kt status")


def tool_access_status(arguments):
    root = arguments.get("root")
    if root is not None:
        root = text_arg(arguments, "root", limit=4096)
        if root.startswith("-"):
            raise ToolError("root must not start with '-'")
    output = report(run_kt("grants", *([root] if root else [])), "kt grants")
    notes = []
    if "\task\t" in output or "\tno grant\t" in output:
        notes.append("Roots in state ask need the user's approval: call kt_access_request.")
    if "\tallow\t" in output:
        notes.append("Give back access you no longer need with kt_access_revoke.")
    if "TREE MISSING" in output:
        notes.append("A root whose tree is gone can be removed with kt_access_revoke scope all.")
    if output.strip() == "force-private":
        notes.append("That root is unavailable and cannot be approved through the harness.")
    return output + ("\n" + " ".join(notes) if notes else "")


def clean_reason(value):
    return re.sub(r"\s+", " ", re.sub(r"[\x00-\x1f\x7f]", " ", value)).strip()[:300] or "(no reason given)"


def read_response(identifier):
    """Block for the elicitation response, deferring any other requests that arrive first."""
    while True:
        message = read_message()
        if message is None:
            raise ToolError("the client disconnected during the approval prompt")
        if message.get("id") == identifier and ("result" in message or "error" in message):
            return message
        if message.get("method") == "notifications/cancelled" and (message.get("params") or {}).get("requestId") in CURRENT:
            raise ToolError("the request was cancelled")
        if message.get("method") == "ping" and "id" in message:
            send({"jsonrpc": "2.0", "id": message["id"], "result": {}})
        elif "method" in message and "id" in message:
            PENDING.append(message)


def elicit(message, schema):
    """Ask the user (never the model) through the client. Returns the accepted content, or None if the
    user declined or cancelled."""
    ELICITATIONS[0] += 1
    identifier = f"kt-elicit-{ELICITATIONS[0]}"
    send({"jsonrpc": "2.0", "id": identifier, "method": "elicitation/create",
          "params": {"message": message, "requestedSchema": schema}})
    response = read_response(identifier)
    result = response.get("result") or {}
    if "error" in response or result.get("action") != "accept":
        return None
    return result.get("content") if isinstance(result.get("content"), dict) else {}


def resolve_root(namespace, value):
    try:
        config = namespace["access_config"]()
        root, label, available = namespace["resolve_access_root"](config, value)
        return config, root, label, available
    except ValueError as error:
        raise ToolError(str(error))


def tool_access_request(arguments):
    value = text_arg(arguments, "root", limit=4096)
    reason = clean_reason(text_arg(arguments, "reason", limit=4096))
    if value.startswith("-"):
        raise ToolError("root must not start with '-'")
    namespace = kt_namespace()
    config, root, label, available = resolve_root(namespace, value)
    current = namespace["root_access"](root, label, config=config)
    if current == "allow":
        return "That root is already readable; no approval is needed."
    if current == "force-private":
        raise ToolError("that root is unavailable and cannot be approved through the harness")
    if current == "deny":
        raise ToolError("that root is denied by the user's policy; only the user can change that, deliberately, in their "
                        "own terminal. Do not work around it.")
    if not CLIENT["elicitation"]:
        return ("This client cannot show approval prompts. Ask the user to run this in their terminal, then retry:\n"
                f"kt access {root} allow --scope project")
    if str(root) in DECLINED:
        return ("The user declined this request earlier in this session. Do not ask again or work around it; continue "
                "without that root or ask the user in conversation.")
    project = str(Path.cwd().resolve())
    content = elicit(
        f"An agent is asking to read a knowledge root.\n\nRoot: {namespace['root_identity'](root)}\n"
        f"Project directory: {project}\nReason (from the agent): {reason}\n\n"
        "Approving lets kt read this root's leaves for this project; retrieved text may be sent to your model provider. "
        "It does not grant direct filesystem access. Decline to refuse.",
        {"type": "object", "required": ["decision"], "properties": {"decision": {
            "type": "string", "title": "Grant", "description": "Where the approval applies",
            "enum": list(ACCESS_CHOICES), "enumNames": [choice[0] for choice in ACCESS_CHOICES.values()]}}})
    if content is None:
        DECLINED.add(str(root))
        return ("The user declined. Do not ask again or work around it; continue without that root or ask the user in "
                "conversation.")
    decision = content.get("decision")
    if decision not in ACCESS_CHOICES:
        raise ToolError("the approval response was not one of the offered choices; nothing was granted")
    _title, scope, subdirectories = ACCESS_CHOICES[decision]
    namespace["apply_access_decision"](config, root, label, available, "allow", scope, project, subdirectories)
    where = {"project": "this project directory", "project_and_subdirectories": "this project and its subdirectories",
             "all": "all projects"}[decision]
    return f"The user approved reading that root for {where}. Retry your lookup."


def tool_access_revoke(arguments):
    value = text_arg(arguments, "root", limit=4096)
    scope = arguments.get("scope", "project")
    if value.startswith("-") or scope not in ("project", "all"):
        raise ToolError("root must not start with '-' and scope must be project or all")
    namespace = kt_namespace()
    config, root, label, available = resolve_root(namespace, value)
    cwd = str(Path.cwd().resolve())
    _policy, _source, granted_for = namespace["resolve_root_access"](root, label, cwd, config)
    try:  # preview on a copy: validates the request and describes its effect without saving
        effect = namespace["apply_revocation"](copy.deepcopy(config), root, label, available, scope, cwd, save=False)
    except ValueError as error:
        raise ToolError(str(error))
    # Narrowing this exact project directory is safe to do directly; anything wider (or the global root,
    # which holds the agent's own procedures) changes the user's policy for other places, so the user confirms.
    wider = scope == "all" or (granted_for is not None and granted_for != cwd) or root == namespace["global_knowledge_root"]()
    if wider:
        if not CLIENT["elicitation"]:
            return ("This change reaches beyond this project directory, and this client cannot show confirmation prompts. "
                    f"Ask the user to run this in their terminal:\nkt access {root} revoke --scope {scope}")
        content = elicit(f"An agent asks to revoke access to a knowledge root.\n\nRoot: {namespace['root_identity'](root)}\n"
                         f"Project directory: {cwd}\nEffect: {effect}\n\nAccept to make this change; decline to leave access as it is.",
                         {"type": "object", "required": ["confirm"], "properties": {"confirm": {
                             "type": "boolean", "title": "Revoke access", "description": "Confirm the change described above"}}})
        if content is None or content.get("confirm") is not True:
            return "The user declined; access is unchanged."
    namespace["apply_revocation"](config, root, label, available, scope, cwd)
    return effect + " Asking for it again will prompt the user."


HANDLERS = {"kt_info": tool_info, "kt_lookup": tool_lookup, "kt_find": tool_find, "kt_grep": tool_grep,
            "kt_read": tool_read, "kt_renew": tool_renew, "kt_edit": tool_edit, "kt_undo": tool_undo,
            "kt_add": tool_add, "kt_dict": tool_dict, "kt_roots": tool_roots, "kt_prove": tool_prove,
            "kt_status": tool_status, "kt_access_status": tool_access_status, "kt_access_request": tool_access_request,
            "kt_access_revoke": tool_access_revoke}


# ---- prompts (user-invoked slash commands in harnesses that support them) ------------------------------

def review_text():
    try:
        return runpy.run_path(str(CLI.with_name("kt-hooks")))["REVIEW"]
    except Exception:  # noqa: BLE001 - the hook file is optional here
        return ("Knowledge-tree capture review: check kt for existing owners of anything reusable you learned, "
                "capture missing answers with evidence, and record blockers for unresolved questions.")


PROMPTS = {
    "capture_review": ("Review this work and capture reusable knowledge", [], lambda a: review_text()),
    "garden": ("List non-green leaves and work through them", [],
               lambda a: "Garden the knowledge tree: call kt_status, then for each yellow or brown leaf kt_read it, "
                         "check its claims against current evidence, repair what is stale with kt_edit (never delete "
                         "still-valid knowledge), and only when the whole leaf is verified call kt_renew. Report what "
                         "you changed and anything you could not verify."),
    "revoke_access": ("Review and give back access this project no longer needs", [],
                      lambda a: "Call kt_access_status to see which roots this project can read and why. For each restricted "
                                "root you do not need for the current work, call kt_access_revoke (widening changes ask the "
                                "user). Report what you revoked and what you kept, and why."),
    "verify_leaf": ("Verify one leaf against current evidence", [{"name": "address", "description": "Leaf address", "required": True}],
                    lambda a: f"Verify the knowledge leaf {a['address']}: kt_read it, check each claim against the "
                              "source evidence, use kt_grep to find other leaves stating the same fact, fix what is "
                              "stale with kt_edit, call kt_renew only if the whole leaf is verified, and report what "
                              "remains unverified."),
}


def prompt_get(params):
    name = params.get("name")
    if name not in PROMPTS:
        raise ToolError("unknown prompt")
    _description, arguments, build = PROMPTS[name]
    given = params.get("arguments") or {}
    if not isinstance(given, dict):
        raise ToolError("prompt arguments must be an object")
    for spec in arguments:
        if not isinstance(given.get(spec["name"]), str) or not given[spec["name"]].strip():
            raise ToolError(f"missing prompt argument {spec['name']}")
    return {"description": PROMPTS[name][0], "messages": [{"role": "user", "content": {"type": "text", "text": build(given)}}]}


# ---- protocol ---------------------------------------------------------------------------------------

def result_for(name, arguments):
    if name not in HANDLERS or not isinstance(arguments, dict):
        raise ToolError("unknown tool or malformed arguments")
    outcome = HANDLERS[name](arguments)
    return outcome if isinstance(outcome, tuple) else (outcome, None)


def respond(message):
    method, ident = message.get("method"), message.get("id")
    if ident is None:
        return None  # notifications such as notifications/initialized need no reply
    if method == "initialize":
        params = message.get("params") or {}
        capabilities = params.get("capabilities")
        CLIENT["elicitation"] = isinstance(capabilities, dict) and isinstance(capabilities.get("elicitation"), dict)
        requested = params.get("protocolVersion")
        return {"jsonrpc": "2.0", "id": ident, "result": {
            "protocolVersion": requested if isinstance(requested, str) else PROTOCOL,
            "capabilities": {"tools": {}, "prompts": {}},
            "serverInfo": {"name": "knowledgetrees", "version": "2"},
            "instructions": INSTRUCTIONS}}
    if method == "ping":
        return {"jsonrpc": "2.0", "id": ident, "result": {}}
    if method == "tools/list":
        return {"jsonrpc": "2.0", "id": ident, "result": {"tools": TOOLS}}
    if method == "prompts/list":
        return {"jsonrpc": "2.0", "id": ident, "result": {"prompts": [
            {"name": name, "description": description, "arguments": arguments}
            for name, (description, arguments, _build) in PROMPTS.items()]}}
    if method == "prompts/get":
        try:
            return {"jsonrpc": "2.0", "id": ident, "result": prompt_get(message.get("params") or {})}
        except ToolError as failure:
            return {"jsonrpc": "2.0", "id": ident, "error": {"code": -32602, "message": str(failure)}}
    if method == "tools/call":
        params = message.get("params") or {}
        CURRENT.append(ident)
        try:
            text, structured = result_for(params.get("name"), params.get("arguments"))
            error = False
        except ToolError as failure:
            text, structured, error = str(failure), None, True
        finally:
            CURRENT.remove(ident)
        result = {"content": [{"type": "text", "text": text}], "isError": error}
        if structured is not None:
            result["structuredContent"] = structured
        return {"jsonrpc": "2.0", "id": ident, "result": result}
    return {"jsonrpc": "2.0", "id": ident, "error": {"code": -32601, "message": f"method not found: {method}"}}


def main():
    # Claude Code supplies the session project here even when a user-scoped MCP
    # server starts with another working directory. An explicit override also
    # lets other hosts provide the same identity.
    project = os.environ.get("KT_MCP_PROJECT_DIR") or os.environ.get("CLAUDE_PROJECT_DIR")
    if project:
        directory = Path(project).resolve(strict=True)
        if not directory.is_dir():
            raise NotADirectoryError(directory)
        os.chdir(directory)
    while True:
        message = PENDING.popleft() if PENDING else read_message()
        if message is None:
            break
        reply = respond(message)
        if reply is not None:
            send(reply)
    return 0


if __name__ == "__main__":
    sys.exit(main())
