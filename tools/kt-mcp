_KT = []


class ToolError(Exception):
    pass


def send(message):
    print(json.dumps(message), flush=True)


def read_message():
    while True:
        line = sys.stdin.readline()
        if not line:
            return None
        if not line.strip():
            continue
        try:
            message = json.loads(line)
            if not isinstance(message, dict):
                raise ValueError("expected a JSON object")
            return message
        except ValueError:
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}})


def kt_namespace():
    if not _KT:
        _KT.append(runpy.run_path(str(CLI)))
    return _KT[0]


def run_kt(*arguments, timeout=60):
    # DEVNULL: a stray "-" argument must never make kt read the MCP protocol stream.
    try:
        return subprocess.run([sys.executable, str(CLI), *arguments], text=True, capture_output=True,
                              stdin=subprocess.DEVNULL, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise ToolError(f"kt timed out after {timeout}s; narrow the request")


def report(completed, label):
    """Exit 1 is a miss or brown result, reported as data; higher codes are errors."""
    output = completed.stdout + completed.stderr
    if completed.returncode >= 2:
        raise ToolError(output.strip() or f"{label} failed ({completed.returncode})")
    return output + (f"\n(exit {completed.returncode})" if completed.returncode else "")


def read_leaf(address):
    completed = run_kt("open", address)
    if completed.returncode:
        raise ToolError((completed.stderr or completed.stdout).strip() or f"kt open failed ({completed.returncode})")
    found = re.search(r"^Revision: ([a-f0-9]{64})$", completed.stderr, re.M)
    if not found:
        raise ToolError("kt open did not report a revision")
    return completed.stdout, found.group(1)


def leaf_key(address):
    return address[:-3] if address.endswith(".md") else address


def note_read(address, body):
    READS[leaf_key(address)] = body


def body_of(text):
    return kt_namespace()["leaf_parts"](text)[1]


def text_arg(arguments, name, required=True, limit=MAX_TEXT):
    value = arguments.get(name)
    if value is None and not required:
        return None
    if not isinstance(value, str):
        raise ToolError(f"{name} must be a string")
    if len(value.encode()) > limit:
        raise ToolError(f"{name} is too long")
    return value


def int_arg(arguments, name, default=None, minimum=0, maximum=None):
    value = arguments.get(name, default)
    if value is None:
        return None
    if isinstance(value, bool) or not isinstance(value, int) or value < minimum or (maximum is not None and value > maximum):
        raise ToolError(f"{name} must be an integer" + (f" from {minimum} to {maximum}" if maximum else f" of at least {minimum}"))
    return value


def words(arguments, name):
    value = text_arg(arguments, name, limit=4096)
    parts = value.split()
    if not parts:
        raise ToolError(f"{name} must not be empty")
    if any(part.startswith("-") for part in parts):
        raise ToolError(f"{name} words must not start with '-'")
    return parts


def strings(arguments, name):
    value = arguments.get(name, [])
    if not isinstance(value, list) or not all(isinstance(item, str) and item and not item.startswith("-") for item in value):
        raise ToolError(f"{name} must be a list of nonempty strings not starting with '-'")
    return value


def scope_flag(arguments):
    scope = arguments.get("scope")
    if scope not in (None, "local", "global"):
        raise ToolError("scope must be local or global")
    return [f"--{scope}"] if scope else []


def rewrite(address, revision, body, dry_run=False):
    """Ask the CLI to replace the answer; `revision` is the leaf's current file hash, fetched just now, so the
    CLI's own locked check guards only against a write racing this one."""
    completed = run_kt("rewrite", *(["--dry-run"] if dry_run else []), address, revision, body)
    if completed.returncode:
        raise ToolError((completed.stderr or completed.stdout).strip() or f"kt rewrite failed ({completed.returncode})")
    return completed


def answer_diff(before, after):
    diff = "".join(difflib.unified_diff(before.splitlines(keepends=True), after.splitlines(keepends=True),
                                       fromfile="before", tofile="after"))
    return diff or "No change."


def seen_answer(address):
    """The leaf as it stands now, provided this session read it and its answer has not changed since."""
    before = READS.get(leaf_key(address))
    if before is None:
        raise ToolError("read this leaf first (kt_read or kt_lookup); you can only change or renew what you have read")
    text, revision = read_leaf(address)
    if body_of(text) != before:
        raise ToolError("the leaf changed since you read it; kt_read it again and merge before continuing")
    return text, revision


