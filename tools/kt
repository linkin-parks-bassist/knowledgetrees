# Root registry, identities, and access policy.

def global_knowledge_root():
    return Path(os.environ.get("KT_GLOBAL_ROOT", "~/.knowledge")).expanduser().resolve()


def access_config_path():
    return Path(os.environ.get("KT_CONFIG", str(Path(os.environ.get("KT_GLOBAL_ROOT", "~/.knowledge")).expanduser() / ".tools/roots.json"))).expanduser()


def access_config():
    path = access_config_path()
    if not path.exists():
        return {"roots": {}, "projects": {}, "dangerously_skip_permissions": False}
    value = json.loads(path.read_text())
    if not isinstance(value, dict) or not isinstance(value.get("roots", {}), dict) or not isinstance(value.get("projects", {}), dict):
        raise ValueError("invalid kt access configuration")
    if not isinstance(value.get("dangerously_skip_permissions", False), bool):
        raise ValueError("invalid kt permission bypass setting")
    for label, spec in value.get("roots", {}).items():
        if not isinstance(spec, dict) or spec.get("access", "ask") not in ACCESS_VALUES:
            raise ValueError("invalid configured root policy")
        if label not in ("local", "project", "global") and not isinstance(spec.get("path"), str):
            raise ValueError("configured root needs an absolute path")
        if "path" in spec and (not isinstance(spec["path"], str) or not Path(spec["path"]).expanduser().is_absolute()):
            raise ValueError("registered root paths must be absolute (tilde expansion is allowed)")
    for project, grants in value.get("projects", {}).items():
        if not Path(project).is_absolute() or not isinstance(grants, dict) or any(not (v in ACCESS_VALUES - {"force-private"} if isinstance(v, str) else isinstance(v, dict) and v.get("access") in ACCESS_VALUES - {"force-private"} and isinstance(v.get("subdirectories", False), bool)) for v in grants.values()):
            raise ValueError("invalid project access grants")
    value.setdefault("roots", {})
    value.setdefault("projects", {})
    return value


def local_root(cwd=None):
    directory = Path(cwd or Path.cwd()).resolve()
    return (directory if directory.name == ".knowledge" else directory / ".knowledge").resolve()


def configured_root(name, spec, cwd=None):
    if "path" in spec:
        return Path(spec["path"]).expanduser().resolve()
    if name in ("local", "project"):
        return local_root(cwd)
    return global_knowledge_root()


def root_identity(root, cwd=None):
    root = Path(root).resolve()
    if root == local_root(cwd):
        return "local"
    if root == global_knowledge_root():
        return "global"
    return str(root)


def discovered_roots(config=None, cwd=None):
    config = access_config() if config is None else config
    local = local_root(cwd)
    global_root = global_knowledge_root()
    paths = [local] if local.is_dir() else []
    if global_root not in paths:
        paths.append(global_root)
    for name, spec in config["roots"].items():
        root = configured_root(name, spec, cwd)
        if root not in paths:
            paths.append(root)
    return [(root_identity(root, cwd), root) for root in paths]


def root_aliases(config=None, cwd=None):
    config = access_config() if config is None else config
    aliases = dict(discovered_roots(config, cwd))
    if local_root(cwd).is_dir():
        aliases["local"] = aliases["project"] = local_root(cwd)
    aliases["global"] = global_knowledge_root()
    for name, spec in config["roots"].items():
        aliases.setdefault(name, configured_root(name, spec, cwd))
    return aliases


def access_session():
    return os.environ.get("KT_SESSION_ID") or os.environ.get("CODEX_THREAD_ID") or os.environ.get("OPENCODE_SESSION_ID")


def access_database():
    directory = Path(os.environ.get("KT_ACCESS_STATE_DIR", str(Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "knowledgetrees")))
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    path = directory / "access.sqlite3"
    descriptor = os.open(path, os.O_CREAT | os.O_WRONLY, 0o600)
    os.close(descriptor)
    os.chmod(path, 0o600)
    return path


def root_access(root, label=None, cwd=None, config=None):
    return resolve_root_access(root, label, cwd, config)[0]


def resolve_root_access(root, label=None, cwd=None, config=None):
    """Return (policy, source, project): the effective policy, why it applies, and the key of the
    project grant that supplied it (None otherwise)."""
    config = access_config() if config is None else config
    cwd = Path(cwd or Path.cwd()).resolve()
    root = Path(root).resolve()
    local = local_root(cwd)
    policies = [(configured_root(name, spec, cwd), spec.get("access", "ask"))
                for name, spec in config["roots"].items()]
    # Forced privacy is checked before bypass or grants and inherited by subtrees.
    if root != local and any(policy == "force-private" and root.is_relative_to(path)
                             for path, policy in policies):
        return "force-private", "forced private", None
    if config.get("dangerously_skip_permissions", False):
        return "allow", "permissions bypass", None
    if any(policy == "deny" and root.is_relative_to(path) for path, policy in policies):
        return "deny", "denied by root policy", None
    matching = [policy for path, policy in policies if path == root]
    if root == local:
        policy, source = "allow", "local tree"
    elif "allow" in matching:
        policy, source = "allow", "allowed everywhere"
    elif matching:
        policy, source = matching[-1], f"root policy ({matching[-1]})"
    else:
        policy, source = "ask", "no grant"
    if policy == "force-private":
        policy, source = "allow", "local tree"  # Only an exact local tree reaches this branch.
    # Exact pairwise scope by default; inheritance must be explicitly approved.
    projects = sorted(((Path(path), grants) for path, grants in config["projects"].items()
                       if cwd.is_relative_to(Path(path))), key=lambda item: len(item[0].parts), reverse=True)
    for project, grants in projects:
        if str(root) in grants:
            grant = grants[str(root)]
            access = grant if isinstance(grant, str) else grant["access"]
            inherit = isinstance(grant, dict) and grant.get("subdirectories", False)
            if cwd == project or inherit:
                return access, "project grant" + (" including subdirectories" if inherit else ""), str(project)
    session = access_session()
    if session:
        path = Path(os.environ.get("KT_ACCESS_STATE_DIR", str(Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "knowledgetrees"))) / "access.sqlite3"
        if path.is_file():
            with sqlite3.connect(f"file:{path}?mode=ro", uri=True) as connection:
                exists = connection.execute("SELECT name FROM sqlite_master WHERE name='grants'").fetchone()
                if exists:
                    rows = connection.execute("SELECT project, access FROM grants WHERE session=? AND root=? AND touched>?", (hashlib.sha256(session.encode()).hexdigest(), str(root), time.time()-7*86400)).fetchall()
                    rows = sorted(((Path(project), access) for project, access in rows if cwd == Path(project)), key=lambda row: len(row[0].parts), reverse=True)
                    if rows:
                        return rows[0][1], "session grant", None
    return policy, source, None


def missing_path(path):
    """True only when the path definitely does not exist (other errors count as present)."""
    try:
        os.stat(path)
    except (FileNotFoundError, NotADirectoryError):
        return True
    except OSError:
        return False
    return False


def prune_stale_grants():
    """Drop approvals whose tree no longer exists: project grants whose project directory or root is
    gone, and registered roots that were allowed everywhere or are auto-named. An approval is keyed
    by path, so leaving one behind would silently approve whatever tree is later recreated there.
    Deny and force-private entries and user-named ask registrations are kept (they protect or name
    a tree, which may just be unmounted); kt grants marks them missing and kt access ROOT revoke
    --scope all removes one."""
    config = access_config()
    removed = []
    for name, spec in list(config["roots"].items()):
        # Approved roots go; so do auto-named ask registrations (root-<hash>), which name nothing but a
        # dead path. User-named ask registrations, deny, and force-private entries stay.
        disposable = spec.get("access") == "allow" or (
            spec.get("access") == "ask" and re.fullmatch(r"root-[0-9a-f]{12}", name) is not None)
        if name not in ("local", "project", "global") and disposable and missing_path(configured_root(name, spec)):
            removed.append((name, None))
            del config["roots"][name]
    for project in list(config["projects"]):
        grants = config["projects"][project]
        if missing_path(project):
            removed.append((project, None))
            del config["projects"][project]
            continue
        for root in list(grants):
            if missing_path(root):
                removed.append((project, root))
                del grants[root]
        if not grants:
            del config["projects"][project]
    if removed:
        try:
            save_access_config(config)
        except OSError:
            return []
        print(f"kt: removed {len(removed)} stale access approval(s) for trees that no longer exist "
              "(approvals are tied to a path and must not carry over to a recreated tree)", file=sys.stderr)
    return removed


def require_root(root, label=None):
    if label is None:
        label = next((name for name, path in discovered_roots() if path == Path(root).resolve()), None)
    policy = root_access(root, label)
    if policy != "allow":
        if policy == "force-private":
            raise AccessRequired("kt: requested root is unavailable")
        name = root_identity(root)
        message = f"kt: root {name!r} is denied" if policy == "deny" else f"kt: root {name!r} requires approval; ask the user with the kt_access_request tool if you have it, otherwise have them run in their terminal: kt access {shlex.quote(name)} allow --scope project"
        raise AccessRequired(message)


def roots():
    result = []
    for label, root in discovered_roots():
        try:
            require_root(root, label)
        except AccessRequired:
            pass
        else:
            result.append((label, root))
    return result


def owning_root(path):
    path = Path(path).resolve()
    owners = [(label, root) for label, root in discovered_roots() if path.is_relative_to(root)]
    return max(owners, key=lambda pair: len(pair[1].parts), default=None)


def leaf_allowed(path):
    owner = owning_root(path)
    return owner is not None and root_access(owner[1], owner[0]) == "allow"



def require_leaf_root(path):
    owner = owning_root(path)
    if owner is None:
        raise AccessRequired("kt: leaf is outside configured knowledge roots")
    require_root(owner[1], owner[0])
    return owner



def save_access_config(config):
    path = access_config_path()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=".kt-config-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(config, stream, indent=2)
            stream.write("\n")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def register_root(root, name=None):
    root = Path(root).expanduser().resolve()
    config = access_config()
    existing = next((label for label, spec in config["roots"].items()
                     if isinstance(spec.get("path"), str) and Path(spec["path"]).expanduser().resolve() == root), None)
    if existing:
        return existing
    if not root.is_dir():
        raise ValueError("register an existing knowledge-root directory")
    name = name or "root-" + hashlib.sha256(str(root).encode()).hexdigest()[:12]
    if name in ("local", "project", "global") or name in config["roots"] or not re.fullmatch(r"[a-z][a-z0-9-]*", name):
        raise ValueError("choose a unique root name using lowercase words and hyphens")
    config["roots"][name] = {"path": str(root), "access": "ask"}
    save_access_config(config)
    return name


def resolve_access_root(config, value):
    """Resolve a root label or absolute path to (root, label, available aliases)."""
    available = list(root_aliases(config).items())
    root = dict(available).get(value)
    label = value
    if root is None:
        if not Path(value).expanduser().is_absolute():
            raise ValueError("select a discovered root label or an absolute knowledge-root path")
        root = Path(value).expanduser().resolve()
        if not root.is_dir() and root not in [path for _, path in available]:
            raise ValueError("knowledge root does not exist")
        label = next((name for name, path in available if path == root), "root-" + hashlib.sha256(str(root).encode()).hexdigest()[:12])
    return root, label, available


def apply_access_decision(config, root, label, available, decision, scope, project, subdirectories=False, session=None):
    """Persist an already-confirmed decision. Confirmation belongs to the caller: the
    CLI requires an interactive terminal confirmation, which an agent may answer only
    when the user explicitly authorized that exact root and scope; the MCP server
    requires an accepted harness elicitation. Nothing here prompts."""
    if scope == "session":
        with sqlite3.connect(access_database()) as connection:
            connection.execute("CREATE TABLE IF NOT EXISTS grants (session TEXT, project TEXT, root TEXT, access TEXT, touched REAL, PRIMARY KEY(session,project,root))")
            connection.execute("DELETE FROM grants WHERE touched<?", (time.time()-7*86400,))
            key = hashlib.sha256(session.encode()).hexdigest()
            if decision == "reset":
                connection.execute("DELETE FROM grants WHERE session=? AND project=? AND root=?", (key, project, str(root)))
            else:
                connection.execute("INSERT OR REPLACE INTO grants VALUES (?,?,?,?,?)", (key, project, str(root), decision, time.time()))
        return
    if scope == "all":
        matching = [name for name, spec in config["roots"].items()
                    if configured_root(name, spec) == root]
        if decision == "reset":
            for name in matching:
                del config["roots"][name]
        else:
            for name in matching or [label]:
                config["roots"][name] = {"path": str(root), "access": decision}
    else:
        grants = config["projects"].setdefault(project, {})
        if decision == "reset":
            grants.pop(str(root), None)
        else:
            grants[str(root)] = {"access": decision, "subdirectories": True} if subdirectories else decision
            if label not in dict(available):
                config["roots"][label] = {"path": str(root), "access": "ask"}
    save_access_config(config)


def apply_revocation(config, root, label, available, scope, cwd, save=True):
    """Narrow or remove access already granted; returns a description. Like apply_access_decision this
    never prompts: the caller confirms. With save=False it only edits the given config (a preview).
    Raises ValueError for grants that cannot be revoked this way."""
    cwd = str(Path(cwd).resolve())

    def persist():
        if save:
            save_access_config(config)
    policy, source, project = resolve_root_access(root, label, cwd, config)
    if policy == "force-private":
        raise ValueError("that root is unavailable")
    if root == local_root(cwd):
        raise ValueError("the exact local tree is always readable and cannot be revoked")
    if source == "permissions bypass":
        raise ValueError("the permissions bypass is on; only `kt permissions --reset` in the user's terminal turns it off")
    if source == "session grant":
        raise ValueError("this is a session grant; it expires on its own, or reset it with the same session id: kt access ROOT reset --scope session")
    matching = [name for name, spec in config["roots"].items() if configured_root(name, spec) == root]
    if scope == "all":
        for grants in config["projects"].values():
            grants.pop(str(root), None)
        config["projects"] = {key: grants for key, grants in config["projects"].items() if grants}
        if missing_path(root):
            for name in matching:
                del config["roots"][name]
            persist()
            return "Removed the registration of a root whose tree no longer exists, and every grant for it."
        for name in matching or [label]:
            config["roots"][name] = {"path": str(root), "access": "ask"}
        persist()
        return "Access to that root now requires approval again, in every project."
    if policy != "allow":
        return "That root is not currently readable from here; nothing to revoke."
    if project:
        grants = config["projects"].get(project, {})
        grants.pop(str(root), None)
        if not grants:
            config["projects"].pop(project, None)
    if resolve_root_access(root, label, cwd, config)[0] == "allow":
        # Still allowed everywhere: an explicit project-level "ask" overrides it for this project only.
        config["projects"].setdefault(cwd, {})[str(root)] = "ask"
    persist()
    return "Access to that root now requires approval again in this project" + (
        f" (the grant was made for {project}" + (" and its subdirectories" if project != cwd else "") + ")." if project else ".")


def grants_command(args):
    """List each root's effective access and why, marking roots whose tree is gone."""
    config = access_config()
    cwd = Path.cwd().resolve()
    if args.root:
        root, _, _ = resolve_access_root(config, args.root)
        targets = [(root_identity(root), root)]
    else:
        targets = discovered_roots(config)
    for label, root in targets:
        policy, source, project = resolve_root_access(root, label, cwd, config)
        if policy == "force-private":
            if args.root:
                print("force-private")
            continue
        detail = source + (f" (granted for {project})" if project and project != str(cwd) else "")
        detail += "; TREE MISSING (kt access ROOT revoke --scope all removes its registration)" if missing_path(root) else ""
        print(f"{label}\t{policy}\t{detail}\t{root if policy == 'allow' else '(restricted)'}")
    return 0


def access_command(args):
    config = access_config()
    root, label, available = resolve_access_root(config, args.root)
    current = root_access(root, label, config=config)
    label = root_identity(root)
    if args.decision is None:
        if current == "force-private":
            print("force-private")
            return 0
        print(f"{label}: {current}\nConfiguration: {access_config_path()}")
        return 0
    if args.decision == "force-private":
        args.scope = "all"
    session = access_session()
    if args.decision == "revoke" and args.scope == "session":
        raise ValueError("revoke applies to --scope project (this directory) or all")
    if args.scope == "session" and not session:
        raise ValueError("session scope requires KT_SESSION_ID (or CODEX_THREAD_ID/OPENCODE_SESSION_ID); use the same identifier in the agent environment")
    if not sys.stdin.isatty():
        raise AccessRequired("kt: access decisions require confirmation in your own interactive terminal; no grant was saved")
    project = str(Path.cwd().resolve())
    subdirectories = getattr(args, "subdirectories", False)
    if subdirectories and args.scope != "project":
        raise ValueError("--subdirectories applies only to persistent project approvals")
    print(f"Root: {root if current != 'force-private' else '(force-private)'}\nScope: {args.scope}" + (f" ({project}" + (" and descendants)" if subdirectories else ")") if args.scope != "all" else " (all projects)"))
    print("Retrieved knowledge may be sent to the agent's configured model provider. This policy controls kt, not direct filesystem reads.")
    if input(f"Save {args.decision!r} decision? [y/N] ").strip().lower() not in ("y", "yes"):
        print("No access decision saved.")
        return 1
    if args.decision == "revoke":
        print(apply_revocation(config, root, label, available, args.scope, project))
        return 0
    apply_access_decision(config, root, label, available, args.decision, args.scope, project, subdirectories, session)
    return 0


def permissions_command(args):
    config = access_config()
    if not args.dangerously_skip_permissions and not args.reset:
        print("dangerously_skip_permissions=" + str(config.get("dangerously_skip_permissions", False)).lower())
        return 0
    if not sys.stdin.isatty():
        raise AccessRequired("kt: permission settings require confirmation in your own interactive terminal; no setting was saved")
    enabled = args.dangerously_skip_permissions
    print("Permanently bypass kt ask/deny policies; force-private remains enforced." if enabled
          else "Restore normal kt access policy checks.")
    if input("Save permission setting? [y/N] ").strip().lower() not in ("y", "yes"):
        print("No permission setting saved.")
        return 1
    config["dangerously_skip_permissions"] = enabled
    save_access_config(config)
    return 0


# Lookup ranking and compact/pretty rendering.

def paint(value, color):
    if PRETTY and sys.stdout.isatty() and "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb":
        return f"\033[{color}m{value}\033[0m"
    return str(value)


LEAF_FIELDS = frozenset(("status", "revised_at", "checked_at", "expires_at",
                         "expires_every", "verifiable", "name", "description"))


def leaf_parts(text):
    metadata = {}
    body = text
    match = re.match(r"\A---\s*\n(.*?)\n---\s*(?:\n|$)", text, re.S)
    if match:
        body = text[match.end():]
        for key in LEAF_FIELDS:
            value = re.search(rf"^{key}:\s*([^\n]+)", match[1], re.M)
            if value:
                metadata[key] = value[1].strip().strip("\"'")
    return metadata, body


def metadata_errors(text):
    if not text.startswith("---\n"):
        return []
    match = re.match(r"\A---\n(.*?)\n---(?:\n|$)", text, re.S)
    if match is None:
        return [(1, "unclosed metadata front matter")]
    errors = []
    seen = set()
    for number, line in enumerate(match[1].splitlines(), 2):
        field = re.fullmatch(r"([a-z_]+):[ \t]*(.+)", line)
        if field is None or field[1] not in LEAF_FIELDS:
            errors.append((number, "unsupported metadata field or syntax"))
            continue
        key, value = field.groups()
        if key in seen:
            errors.append((number, f"duplicate metadata field: {key}"))
        seen.add(key)
        value = value.strip().strip("\"'")
        if key == "status" and value not in LEAF_STATES:
            errors.append((number, "status must be green, yellow, or brown"))
        if key in ("revised_at", "checked_at", "expires_at"):
            try:
                if datetime.fromisoformat(value).utcoffset() is None:
                    raise ValueError("timezone required")
            except ValueError:
                errors.append((number, f"{key} must be an ISO 8601 timestamp with timezone"))
    return errors


def requested_lifecycle(args, existing=None):
    """Preserve existing optional fields unless a CLI option changes them."""
    fields = {key: existing[key] for key in
              ("expires_at", "expires_every", "verifiable", "name", "description")
              if existing and key in existing}
    if getattr(args, "no_expiry", False):
        fields.pop("expires_at", None)
        fields.pop("expires_every", None)
    elif getattr(args, "expires_at", None) is not None:
        metadata_datetime(args.expires_at, "expires_at")
        fields.pop("expires_every", None)
        fields["expires_at"] = args.expires_at
    elif getattr(args, "expires_every", None) is not None:
        expiry_duration(args.expires_every)
        fields.pop("expires_at", None)
        fields["expires_every"] = args.expires_every
    if getattr(args, "verifiable", None) is not None:
        if args.verifiable:
            fields["verifiable"] = "true"
        else:
            fields.pop("verifiable", None)
    return fields


def lifecycle_options(parser, clear=False):
    expiry = parser.add_mutually_exclusive_group()
    expiry.add_argument("--expires-at", help="ISO 8601 expiry timestamp with timezone")
    expiry.add_argument("--expires-every", help="duration from manual checked_at, e.g. 14d or '2 weeks'")
    if clear:
        expiry.add_argument("--no-expiry", action="store_true", help="remove existing expiry")
    coverage = parser.add_mutually_exclusive_group()
    coverage.add_argument("--verifiable", dest="verifiable", action="store_true",
                          help="assert every factual claim is covered by proofs")
    if clear:
        coverage.add_argument("--no-verifiable", dest="verifiable", action="store_false",
                              help="remove the complete-proof-coverage assertion")
    parser.set_defaults(verifiable=None)


def words(value):
    return list(dict.fromkeys(re.findall(r"[^\W_]+", value.casefold())))


