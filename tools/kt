def coverage(terms, haystack):
    meaningful = [t for t in terms if t not in GRAMMATICAL] or terms
    return sum(t in haystack for t in meaningful) / len(meaningful) if meaningful else 1.0



@dataclass(frozen=True)
class RootAccessView:
    roots: tuple
    policies: dict

    @classmethod
    def load(cls):
        config = access_config()
        catalog = tuple(discovered_roots(config))
        policies = {root: root_access(root, label, config=config) for label, root in catalog}
        return cls(catalog, policies)

    def allowed_roots(self):
        return [(label, root) for label, root in self.roots if self.policies[root] == "allow"]

    def allows(self, path):
        canonical = Path(path).resolve()
        owner = max((root for _, root in self.roots if canonical.is_relative_to(root)),
                    key=lambda root: len(root.parts), default=None)
        return owner is not None and self.policies[owner] == "allow"


class LookupContext:
    """Lazy, invocation-only access and text reuse; no private-root indexing."""
    def __init__(self):
        self.access = RootAccessView.load()
        self.contents = {}

    def read(self, path):
        if path not in self.contents:
            if not self.access.allows(path):
                raise AccessRequired("kt: requested leaf is unavailable")
            text = path.read_text()
            metadata, body = leaf_parts(text)
            self.contents[path] = (text, metadata, body)
        return self.contents[path]


def leaves(root, access=None):
    if not root.is_dir():
        return
    access = access or RootAccessView.load()
    for directory, directories, files in os.walk(root, followlinks=False):
        directories[:] = sorted(d for d in directories if not d.startswith(".") and access.allows(Path(directory) / d))
        for name in sorted(files):
            path = Path(directory) / name
            if name.endswith(".md") and not path.is_symlink() and access.allows(path):
                yield path


def dictionary(args):
    """Print unique leaf-path components without reading leaf contents."""
    access = RootAccessView.load()
    selected = access.allowed_roots()
    if args.roots:
        aliases = root_aliases()
        selected = []
        for value in args.roots:
            root = aliases.get(value)
            if root is None:
                candidate = Path(value).expanduser().resolve()
                root = next((path for _, path in access.roots if path == candidate), None)
            if root is None:
                raise ValueError(f"unknown knowledge root: {value}")
            label = next((name for name, path in access.roots if path == root), root_identity(root))
            require_root(root, label)
            if (label, root) not in selected:
                selected.append((label, root))
    segments = set()
    for _, root in selected:
        # A nested registered root owns its subtree. Prune it here and, when
        # accessible, walk it through its own selected-root entry. This enforces
        # access boundaries with directory checks rather than resolving every file.
        nested = {other for _, other in access.roots if other != root and other.is_relative_to(root)}
        for directory, directories, files in os.walk(root, followlinks=False):
            base = Path(directory)
            directories[:] = sorted(
                name for name in directories
                if not name.startswith(".") and (base / name).resolve() not in nested
            )
            for name in files:
                path = base / name
                if not name.endswith(".md") or path.is_symlink():
                    continue
                # os.walk already gives us the tree position: the containing
                # directory is the penultimate segment and the leaf stem is
                # the final one. Do not materialize or post-process full paths.
                candidates = (name[:-3],) if base == root else (base.name, name[:-3])
                for segment in candidates:
                    if (len(segment) > 2 and not segment.isdecimal()
                            and segment.casefold() not in DICTIONARY_STOPWORDS):
                        segments.add(segment)
    if segments:
        print(", ".join(sorted(segments, key=lambda value: (value.casefold(), value))))
    return 0


def find(args, branches=None, browse=False, context=None):
    terms = words(" ".join(args.terms))
    if not terms and not browse:
        print("kt: supply at least one word to search", file=sys.stderr)
        return 2
    context = context or LookupContext()
    if branches is None:
        allowed = context.access.allowed_roots()
        if not allowed:
            raise AccessRequired("kt: no accessible knowledge roots; review kt access policies")
        branches = [(label, root, root) for label, root in allowed]
    results = []
    for precedence, (label, root, branch) in enumerate(
            branches):
        for path in leaves(branch, context.access):
            try:
                text, metadata, body = context.read(path)
            except (OSError, UnicodeError) as error:
                print(f"kt: skipped {path}: {error}", file=sys.stderr)
                continue
            relative = path.relative_to(root).as_posix()
            if LEAN and text.strip():
                metadata = {**metadata, "status": leaf_health(text, datetime.now(timezone.utc))[0]}
            route = relative.removesuffix(".md").casefold()
            lower = body.casefold()
            head = "\n".join(body.splitlines()[:20]).casefold()
            score = sum(4 if t in route else 2 if t in head else 1 if t in lower else 0 for t in terms)
            if not score and not browse:
                continue
            if terms and all(t in route for t in terms):
                score += 8
            if terms and words(route) == terms:
                score += 20
            paragraphs = [" ".join(paragraph.split()) for paragraph in re.split(r"\n\s*\n", body) if paragraph.strip()]
            excerpt = max(paragraphs, key=lambda paragraph: sum(t in paragraph.casefold() for t in terms), default="")
            results.append((-score, precedence, relative, label, path, metadata, excerpt,
                            coverage(terms, route + "\n" + lower)))
    results.sort(key=lambda row: (not browse and row[-1] < args.min_coverage, *row[:3]))
    if not results:
        if not PRETTY:
            print("no_matches; retry synonyms/scoped paths; private roots excluded")
            return 1
        print(paint("No matches", "33") + f" for {' '.join(args.terms)!r}.")
        print("This is keyword search; a miss does not establish that the answer is absent.")
        print("Check alternate terms and permitted scoped paths. Private roots are excluded; use kt roots to inspect policies.")
        return 1
    adequate = browse or any(row[-1] >= args.min_coverage for row in results)
    shown = results[:args.limit]
    if not PRETTY:
        count = sum(row[-1] >= args.min_coverage for row in results) if not browse else len(results)
        branch = f" branch={args.branch}" if getattr(args, "branch", None) else ""
        print(f"{'leaves' if browse else 'matches'}={len(shown)}/{len(results)} adequate={count}{branch} coverage=lexical")
        for _, _, relative, label, _, metadata, excerpt, matched in shown:
            status = metadata.get("status", "green")
            fields = [f"{label}:{relative}"]
            if terms:
                fields.append(f"coverage={matched:.0%}" + (" weak" if matched < args.min_coverage else ""))
            if status != "green" or not LEAN:
                fields.append(status)
            if excerpt:
                fields.append(textwrap.shorten(excerpt, width=160, placeholder=" …"))
            print("\t".join(fields))
        return 0 if adequate else 1
    if not adequate:
        print(paint("No sufficiently good matches", "33") + "; weak suggestions follow.\n")
    shown = results[:args.limit]
    title = "leaves" if browse else "matches"
    query = f" · {' '.join(args.terms)}" if args.terms else ""
    print(paint(f"{len(shown)} of {len(results)} {title}", "1") + query + "\n")
    width = max(30, min(shutil.get_terminal_size((100, 24)).columns - 4, 116))
    for index, (negative_score, _, relative, label, path, metadata, excerpt, matched) in enumerate(shown, 1):
        print(f"{paint(str(index) + '.', '1')} {paint(label + ':' + relative, '36')}  {paint('score ' + str(-negative_score), '2')}")
        if terms:
            print(f"   keyword coverage {matched:.0%}" + (" · weak suggestion" if matched < args.min_coverage else ""))
        status = metadata.get("status", "green")
        print("   " + paint(status, "31" if status == "brown" else "2"))
        if excerpt:
            print(textwrap.fill(excerpt, width=width, initial_indent="   ", subsequent_indent="   "))
        print()
    print("Read complete leaf: kt open ROOT:<path> (local, global, or canonical root path)")
    print("Check relevant proofs before relying on claims; search scores are not confidence.")
    if not adequate:
        print("Check alternate terms and scoped paths; if no leaf exists, investigate and capture the answer.")
    return 0 if adequate else 1


def grep_command(args):
    """Search leaf text (front matter included) in every permitted root; policy is enforced by leaves()."""
    flags = re.IGNORECASE if args.ignore_case else 0
    try:
        pattern = re.compile(args.pattern if args.regex else re.escape(args.pattern), flags)
    except re.error as error:
        raise ValueError(f"invalid regular expression: {error}")
    context = LookupContext()
    allowed = context.access.allowed_roots()
    if not allowed:
        raise AccessRequired("kt: no accessible knowledge roots; review kt access policies")
    printed = found = 0
    for label, root in allowed:
        for path in leaves(root, context.access):
            try:
                lines = context.read(path)[0].splitlines()
            except (OSError, UnicodeError):
                continue
            hits = [n for n, line in enumerate(lines) if pattern.search(line[:4000])]
            if not hits:
                continue
            address = f"{label}:{path.relative_to(root).as_posix()}"
            if args.files_with_matches:
                found += 1
                if printed < args.limit:
                    print(address)
                    printed += 1
                continue
            emitted = set()
            for n in hits:
                found += 1
                if printed >= args.limit:
                    continue
                printed += 1
                for m in range(max(0, n - args.context), min(len(lines), n + args.context + 1)):
                    if m not in emitted:
                        emitted.add(m)
                        text = textwrap.shorten(lines[m], width=240, placeholder=" …") if lines[m].strip() else ""
                        print(f"{address}:{m + 1}{':' if m == n else '-'} {text}".rstrip())
    if not found:
        print("no_matches; grep is literal or regex text search, not semantic; private roots excluded")
        return 1
    if found > printed:
        print(f"(showing {printed} of {found}; raise --limit or narrow the pattern)")
    return 0


def leaf_health(text, now):
    """Return (state, kind, detail) for a leaf's live lifecycle state.

    kind is None when green, else malformed, falsified, due, or marked; detail explains malformed and due."""
    metadata, _ = leaf_parts(text)
    problems = metadata_errors(text)
    state = "brown" if problems or metadata.get("status") == "brown" else lifecycle_state(text, now)[0]
    if state == "green" and metadata.get("status", "green") == "yellow":
        state = "yellow"
    if state == "green":
        return state, None, ""
    if problems:
        return state, "malformed", "; ".join(f"line {number}: {message}" for number, message in problems)
    if state == "brown":
        return state, "falsified", ""
    if metadata.get("expires_at") or metadata.get("expires_every"):
        return state, "due", ", ".join(
            f"{k}={metadata[k]}" for k in ("expires_at", "expires_every", "checked_at") if metadata.get(k))
    return state, "marked", ""


def lean_leaf(text, address):
    """Leaf body without bookkeeping metadata; a one-line notice leads it only when the leaf is not green."""
    if not text.strip():
        return text
    state, kind, detail = leaf_health(text, datetime.now(timezone.utc))
    notice = ""
    if kind == "malformed":
        notice = f"kt: BROWN leaf {address} has malformed metadata ({detail}). STOP: report it to the user, diagnose and repair it (kt_edit), then kt_prove before other work."
    elif kind == "falsified":
        notice = f"kt: BROWN leaf {address}: a proof failed or it was falsified. STOP: report it to the user, diagnose and repair it (kt_edit), then kt_prove before other work."
    elif kind:
        why = f"is due for re-verification ({detail})" if kind == "due" else "is marked for re-verification"
        notice = (f"kt: yellow leaf {address} {why}. Verify every claim against current evidence before relying on it, "
                  "then confirm with kt_renew (kt renew ADDRESS HASH) or repair it with kt_edit.")
    body = leaf_parts(text)[1].lstrip("\n")
    return (notice + "\n\n" if notice else "") + body


def write_stdout(text):
    """Write nonempty command output with a terminal-friendly trailing newline."""
    if not text:
        return
    sys.stdout.write(text)
    if not text.endswith("\n"):
        sys.stdout.write("\n")


def show_leaf(text, address):
    write_stdout(lean_leaf(text, address) if LEAN else text)


def status_command(args):
    """List leaves that are not green, with the reason, without running proofs."""
    selected = [flag for flag in (args.local, args.global_root, args.root is not None) if flag]
    if len(selected) > 1:
        raise ValueError("select only one of --local, --global, or --root")
    context = LookupContext()
    if args.local:
        root = local_root()
        if not root.is_dir():
            raise AccessRequired("kt: no local knowledge root in the current directory")
        require_root(root, "local")
        roots_to_scan = [("local", root)]
    elif args.global_root:
        root = global_knowledge_root()
        require_root(root, "global")
        roots_to_scan = [("global", root)]
    elif args.root is not None:
        root = Path(args.root).expanduser().resolve()
        require_root(root)
        roots_to_scan = [(root_identity(root), root)]
    else:
        roots_to_scan = context.access.allowed_roots()
        if not roots_to_scan:
            raise AccessRequired("kt: no accessible knowledge roots; review kt access policies")
    now = datetime.now(timezone.utc)
    counts = {state: 0 for state in LEAF_STATES}
    rows = []
    for label, root in roots_to_scan:
        for path in leaves(root, context.access):
            try:
                text, metadata, _ = context.read(path)
            except (OSError, UnicodeError):
                continue
            if not text.strip():
                continue  # empty orientation/spine leaves are placeholders, not knowledge
            state, kind, detail = leaf_health(text, now)
            counts[state] += 1
            if state == "green":
                continue
            if kind == "malformed":
                reason = "malformed metadata: " + detail
            elif kind == "falsified":
                reason = "brown: priority-one incident; report it to the user, diagnose, repair, then re-check before other work"
            elif kind == "due":
                reason = f"expired or due for re-verification ({detail}); review the whole answer, then kt renew"
            else:
                reason = "marked yellow for re-verification; review the whole answer, then kt renew"
            rows.append((state != "brown", f"{label}:{path.relative_to(root).as_posix()}", state, reason))
    for _, address, state, reason in sorted(rows):
        print(f"{state}\t{address}\t{reason}")
    print(" ".join(f"{state}={counts[state]}" for state in LEAF_STATES))
    return 0


QUESTION_STARTS = {"how", "where", "when", "what", "why", "who", "which", "does", "is"}


def question(arguments):
    parser = argparse.ArgumentParser(prog="kt", description="Walk question words, then search the nearest relevant branch.")
    parser.add_argument("--pretty", action="store_true", help="human-oriented layout")
    parser.add_argument("question", nargs="+")
    parser.add_argument("--limit", type=int, default=10)
    parser.add_argument("--min-coverage", type=float, default=0.6, help="minimum non-grammatical keyword coverage (default: 0.6)")
    args = parser.parse_args(arguments)
    if args.limit < 1:
        parser.error("--limit must be positive")
    if not 0 < args.min_coverage <= 1:
        parser.error("--min-coverage must be greater than zero and at most one")
    components = re.findall(r"[^\W_]+(?:-[^\W_]+)*|_", " ".join(args.question).casefold())
    if "_" in components[:-1]:
        parser.error("_ is a terminal branch-listing placeholder")
    browse = bool(components and components[-1] == "_")
    if browse:
        components.pop()
    context = LookupContext()
    available = context.access.allowed_roots()
    if not available:
        raise AccessRequired("kt: no accessible knowledge roots")
    # Try the full sentence path without scanning any directory contents.
    if components and not browse:
        for label, root in available:
            candidate = root.joinpath(*components).with_suffix(".md")
            if candidate.is_file() and not candidate.is_symlink() and candidate.resolve().is_relative_to(root) and context.access.allows(candidate):
                address = f"{label}:{candidate.relative_to(root)}"
                print(f"kt: exact {address}" + ("" if LEAN else "; check relevant proofs before reliance"), file=sys.stderr)
                data = candidate.read_bytes()
                print(f"Revision: {revision(data)}", file=sys.stderr)
                show_leaf(data.decode("utf-8"), address)
                return 0
    # Consume directories word by word. Stop at the first unmatched component.
    walked = []
    for label, root in available:
        branch = root
        consumed = 0
        for component in components:
            child = branch / component
            if not child.is_dir() or child.is_symlink():
                break
            branch = child
            consumed += 1
        walked.append((label, root, branch, consumed))
    depth = max((entry[3] for entry in walked), default=0)
    terms = words(" ".join(components[depth:]))
    # Exact branch listing needs no keyword hit; keyword searches widen only if
    # no candidate covers enough of the unmatched query to be worth presenting.
    while depth >= 0:
        branches = []
        for label, root, _, consumed in walked:
            if consumed >= depth:
                branches.append((label, root, root.joinpath(*components[:depth])))
        relevant = browse or not terms
        if not relevant:
            for _, _, branch in branches:
                for path in leaves(branch, context.access):
                    try:
                        _, _, body = context.read(path)
                    except (OSError, UnicodeError):
                        continue
                    haystack = path.relative_to(branch).as_posix().casefold() + "\n" + body.casefold()
                    # Transparent lexical coverage, not model confidence.
                    if coverage(terms, haystack) >= args.min_coverage:
                        relevant = True
                        break
                if relevant:
                    break
        if relevant or depth == 0:
            prefix = "/".join(components[:depth]) or "(whole roots)"
            if PRETTY:
                print(paint("Search branch", "1") + f": {prefix}\n")
            args.branch = prefix
            args.terms = terms
            return find(args, branches=branches, browse=browse or not terms, context=context)
        depth -= 1
        if PRETTY:
            print(f"kt: weak keyword coverage; widening to {'/'.join(components[:depth]) or 'whole roots'}", file=sys.stderr)
    return 1


# Leaf addressing, revisions, and maintenance operations.

def qualified_leaf(value):
    aliases = root_aliases()
    # Longest-prefix matching permits colons in external root directory names.
    qualifier = next((alias for alias in sorted(aliases, key=len, reverse=True)
                      if value.startswith(alias + ":")), None)
    return (aliases[qualifier], value[len(qualifier) + 1:]) if qualifier is not None else None



def resolve_leaf(value, writable=False):
    available = roots()
    qualified = qualified_leaf(value)
    if qualified is not None:
        root, relative = qualified
        require_root(root)
        available = [(root_identity(root), root)]
        if Path(relative).is_absolute():
            raise ValueError("leaf path must be relative to its selected root")
    elif not Path(value).expanduser().is_absolute() and ":" in value:
        raise ValueError("unknown root label")
    else:
        relative = value
    path = Path(value).expanduser()
    if qualified is None and path.is_absolute():
        if writable and any(p.is_symlink() for p in (path, *path.parents)):
            raise ValueError("cannot rewrite through a symlink")
        resolved = path.resolve()
        require_leaf_root(resolved)
        candidates = [resolved] if path.suffix == ".md" else []
    else:
        candidates = []
        for _, root in available:
            for suffix in ("", ".md"):
                raw = root / (relative + suffix)
                candidate = raw.resolve()
                owner = owning_root(candidate)
                if owner is not None:
                    require_root(owner[1], owner[0])
                if not candidate.is_relative_to(root) or candidate.suffix != ".md":
                    continue
                if writable and any(p.is_symlink() for p in (raw, *raw.parents)):
                    raise ValueError("cannot rewrite through a symlink")
                candidates.append(candidate)
    path = next((p for p in candidates if p.is_file()), None)
    if path is None:
        raise ValueError("no such leaf")
    if not leaf_allowed(path):
        raise AccessRequired("kt: leaf is inside a restricted registered root")
    return path


def open_leaf(value):
    path = resolve_leaf(value)
    data = path.read_bytes()
    print(f"Revision: {revision(data)}", file=sys.stderr)
    show_leaf(data.decode("utf-8"), leaf_address(path))
    return 0


def revision(data):
    return hashlib.sha256(data).hexdigest()


@dataclass(frozen=True)
class LeafSnapshot:
    data: bytes
    digest: str
    device: int
    inode: int


def snapshot_from_stream(stream):
    stream.seek(0)
    data = stream.read()
    stat = os.fstat(stream.fileno())
    return LeafSnapshot(data, revision(data), stat.st_dev, stat.st_ino)


def read_leaf_snapshot(path):
    with path.open("rb") as stream:
        return snapshot_from_stream(stream)


def check_leaf_snapshot(path, snapshot, stream=None, expected_revision=None, message="kt: leaf changed; source retained"):
    current = snapshot_from_stream(stream) if stream is not None else read_leaf_snapshot(path)
    stat = path.stat()
    identity = (snapshot.device, snapshot.inode)
    if current.digest != (expected_revision or snapshot.digest) or (current.device, current.inode) != identity or (stat.st_dev, stat.st_ino) != identity:
        raise RevisionConflict(message)


def proof_records(text):
    """Identify assertion-paragraph + fenced predicate, outside other fences."""
    lines = text.splitlines(keepends=True)
    records = []
    index = 0
    while index < len(lines):
        line = lines[index].rstrip("\r\n")
        if line.startswith("```"):
            index += 1
            while index < len(lines) and lines[index].strip() != "```":
                index += 1
        elif line == "Proof:":
            marker_index = index
            previous = index - 1
            while previous >= 0 and not lines[previous].strip():
                previous -= 1
            start = previous
            while start > 0 and lines[start - 1].strip():
                start -= 1
            opening = index + 1
            while opening < len(lines) and not lines[opening].strip():
                opening += 1
            if previous >= 0 and opening < len(lines) and lines[opening].strip() in ("```bash", "```sh", "```python", "```python3"):
                closing = opening + 1
                while closing < len(lines) and lines[closing].strip() != "```":
                    closing += 1
                if closing < len(lines):
                    identity = ("".join(lines[start:previous + 1]), "".join(lines[opening:closing + 1]))
                    records.append((index, identity, line))
                    index = closing
            if not records or records[-1][0] != marker_index:
                records.append((marker_index, None, line))
        index += 1
    return lines, records


def require_verifiable_proof(body, fields):
    if fields.get("verifiable") == "true" and not any(
            identity is not None for _, identity, _ in proof_records(body)[1]):
        raise ValueError("--verifiable requires at least one eligible proof in the answer body")


def revised_leaf(body, original, args):
    """Rebuild front matter for new content: revision time advances; status and check time carry over."""
    previous, _ = leaf_parts(original)
    now = datetime.now().astimezone().isoformat(timespec="seconds")
    fields = {"status": previous.get("status", "green"), "revised_at": now}
    if "checked_at" in previous:
        fields["checked_at"] = previous["checked_at"]
    if getattr(args, "expires_every", None) is not None:
        fields["checked_at"] = now
    fields.update(requested_lifecycle(args, previous))
    header = "".join(f"{key}: {json.dumps(value, ensure_ascii=False)}\n"
                     for key, value in fields.items())
    return "---\n" + header + "---\n\n" + body.strip("\r\n") + "\n"


def rewrite_leaf(args):
    path = resolve_leaf(args.path, writable=True)
    expected = args.hash
    if not isinstance(expected, str) or not re.fullmatch(r"[a-f0-9]{64}", expected):
        raise ValueError("revision must be the SHA-256 hash supplied by a leaf read")
    replacement = args.contents
    if not replacement.strip() or "\x00" in replacement or len(replacement.encode()) > 1048576:
        raise ValueError("answer body must be nonempty UTF-8 text without NUL, at most 1 MiB")
    if re.match(r"\A\s*---\s*\n", replacement):
        raise ValueError("supply the answer body, not metadata front matter")
    descriptor = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
    with os.fdopen(descriptor, "r+b") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        snapshot = snapshot_from_stream(stream)
        original_bytes = snapshot.data
        if snapshot.digest != expected:
            raise RevisionConflict("kt: leaf changed; reread with kt open and merge before rewriting")
        original = original_bytes.decode("utf-8")
        if metadata_errors(original):
            raise ValueError("existing leaf has unsupported metadata")
        prior_metadata, prior_body = leaf_parts(original)
        requested = requested_lifecycle(args, prior_metadata)
        require_verifiable_proof(replacement, requested)
        existing = {key: prior_metadata[key] for key in
                    ("expires_at", "expires_every", "verifiable", "name", "description")
                    if key in prior_metadata}
        inherited = getattr(args, "inherited_status", None)
        if (not inherited and
                replacement.strip("\r\n") == prior_body.strip("\r\n") and
                requested == existing):
            return 0
        updated = revised_leaf(replacement, original, args)
        if inherited and STATE_RANK[inherited] > STATE_RANK[leaf_parts(updated)[0]["status"]]:
            updated = set_lifecycle_status(updated, inherited)
        if args.dry_run:
            write_stdout("".join(difflib.unified_diff(original.splitlines(keepends=True), updated.splitlines(keepends=True), fromfile=str(path), tofile=str(path) + " (rewritten)")))
            return 0
        # Never replace the inode: installer-created SKILL.md hardlinks stay intact.
        # Recheck after preparing output to detect ordinary non-locking intervening edits.
        check_leaf_snapshot(path, snapshot, stream,
                            message="kt: leaf changed during rewrite; reread and merge")
        stream.seek(0)
        stream.write(updated.encode("utf-8"))
        stream.truncate()
        stream.flush()
        os.fsync(stream.fileno())
    return 0



def destination_leaf(value):
    qualified = qualified_leaf(value)
    if qualified is not None:
        root, relative = qualified
        require_root(root)
        if Path(relative).is_absolute() or any(part in (".", "..") for part in relative.split("/")):
            raise ValueError("destination must stay inside its selected root")
        raw = root / relative
    elif Path(value).expanduser().is_absolute():
        raw = Path(value).expanduser().absolute()
    else:
        if ":" in value or any(part in (".", "..") for part in value.split("/")):
            raise ValueError("invalid destination leaf")
        available = roots()
        if not available:
            raise AccessRequired("kt: no accessible destination root")
        raw = available[0][1] / value
    path = raw.resolve()
    name, root = require_leaf_root(path)
    if path.suffix != ".md" or "_" in path.relative_to(root).as_posix():
        raise ValueError("destination must be a sentence-derived Markdown leaf without underscores")
    if any(part.is_symlink() for part in (raw, *raw.parents)):
        raise ValueError("cannot move through a symlink")
    return path


def leaf_address(path):
    name, root = require_leaf_root(path)
    return f"{name}:{path.relative_to(root)}"


def relocate_leaf(args):
    path = resolve_leaf(args.path, writable=True)
    if not re.fullmatch(r"[0-9a-fA-F]{64}", args.expect):
        raise ValueError("--expect must be a SHA-256 revision from a full leaf read")
    destination = destination_leaf(args.destination) if args.command == "mv" else None
    with path.open("rb") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        snapshot = snapshot_from_stream(stream)
        data = snapshot.data
        if snapshot.digest != args.expect.lower():
            raise RevisionConflict("kt: revision mismatch; reread before removing or moving")
        if destination is not None and destination == path:
            return 0
        if destination is not None and (destination.exists() or destination.is_symlink()):
            raise ValueError("destination already exists; no files changed")
        source = leaf_address(path)
        target = leaf_address(destination) if destination else None
        if args.dry_run:
            print(f"Would move {source} -> {target}" if destination else f"Would remove {source}")
            return 0
        check_leaf_snapshot(path, snapshot, stream)
        if destination is not None:
            destination.parent.mkdir(parents=True, exist_ok=True)
            try:
                os.link(path, destination, follow_symlinks=False)
            except OSError as error:
                if error.errno != errno.EXDEV:  # Copy exclusively across filesystems.
                    raise
                with destination.open("xb") as output:
                    output.write(data)
                    output.flush()
                    os.fsync(output.fileno())
                shutil.copystat(path, destination, follow_symlinks=False)
            check_leaf_snapshot(path, snapshot, stream,
                                message="kt: source changed; source retained and destination created; inspect both")
        path.unlink()
    return 0


def combine_leaves(args):
    destination = destination_leaf(args.output)
    sources = [resolve_leaf(value, writable=True) for value in args.paths]
    bodies = []
    inherited = "green"
    snapshots = {}
    for source in sources:
        snapshot = read_leaf_snapshot(source)
        data = snapshot.data
        snapshots[source] = snapshot
        source_text = data.decode("utf-8")
        if metadata_errors(source_text):
            raise ValueError(f"source leaf has unsupported metadata: {source}")
        metadata, body = leaf_parts(source_text)
        bodies.append(body.strip("\r\n"))
        inherited = worse(inherited, metadata.get("status", "green"))
    # Abort before saving if any input changed while preparing the answer.
    for source, snapshot in snapshots.items():
        check_leaf_snapshot(source, snapshot,
                            message="kt: combine input changed; no output saved; reread inputs")
    now = datetime.now().astimezone().isoformat(timespec="seconds")
    metadata = {"status": inherited, "revised_at": now}
    content = "---\n" + "".join(f"{key}: {json.dumps(value, ensure_ascii=False)}\n" for key, value in metadata.items())
    body = "\n\n".join(bodies) + "\n"
    content += "---\n\n" + body
    if destination.exists():
        if not args.expect:
            raise ValueError("existing destination requires --expect from a full leaf read")
        rewrite_leaf(argparse.Namespace(path=str(destination), hash=args.expect,
            contents=body, dry_run=args.dry_run, no_expiry=True,
            verifiable=False, inherited_status=inherited))
        if args.dry_run:
            print("Would remove source leaves except the destination.", file=sys.stderr)
            return 0
    else:
        if args.expect:
            raise RevisionConflict("kt: expected destination does not exist")
        if args.dry_run:
            print(f"Would coalesce {len(sources)} leaves -> {leaf_address(destination)} and remove sources", file=sys.stderr)
            write_stdout(content)
            return 0
        destination.parent.mkdir(parents=True, exist_ok=True)
        with destination.open("x", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
    destination_revision = revision(destination.read_bytes())
    removed = 0
    for source, snapshot in snapshots.items():
        if source == destination:
            continue
        # Saving in place changes input hardlink aliases to the destination too.
        expected_revision = destination_revision if source.samefile(destination) else snapshot.digest
        resolve_leaf(str(source), writable=True)
        with source.open("rb") as stream:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
            check_leaf_snapshot(source, snapshot, stream, expected_revision,
                                message="kt: input changed; combined destination saved, changed source retained; inspect both")
            source.unlink()
        removed += 1
    return 0



def capture(args):
    """Create only: existing owners (including hardlinked skills) are never replaced."""
    if any(c in args.question for c in ("/", "\\", "_")) or any(
            ord(c) < 32 for c in args.question):
        raise ValueError("supply a natural-language question; use hyphens, not slashes or underscores")
    components = re.findall(r"[^\W_]+(?:-[^\W_]+)*", args.question.casefold())
    if not components:
        raise ValueError("question must contain words")
    available = roots()
    if args.root:
        root = root_aliases().get(args.root, Path(args.root).expanduser().absolute())
        label = root_identity(root)
    elif args.project or args.global_root:
        label = "local" if args.project else "global"
        root = root_aliases().get(label)
        if root is None:
            raise ValueError("no project knowledge root; establish one or select --root")
    else:
        if not available:
            raise AccessRequired("kt: no accessible knowledge root for capture")
        label, root = available[0]
    if not args.dry_run and root.is_dir() and not any(isinstance(spec.get("path"), str) and Path(spec["path"]).expanduser().resolve() == root.resolve() for spec in access_config()["roots"].values()):
        register_root(root)
    require_root(root)
    if not root.is_dir():
        raise ValueError(f"knowledge root does not exist: {root}")
    # Reject symlink roots/ancestors before any directory or file mutation.
    for ancestor in (root, *root.parents):
        if ancestor.is_symlink():
            raise ValueError(f"symlink in capture root: {ancestor}")
    path = root.joinpath(*components).with_suffix(".md")
    require_leaf_root(path)
    for ancestor in path.relative_to(root).parents:
        if (root / ancestor).is_symlink():
            raise ValueError("symlink in leaf path")
    if path.exists() or path.is_symlink():
        raise ValueError(f"leaf already exists: {path}; read the owner and use kt rewrite ADDRESS HASH BODY")
    if args.answer == "-":
        if sys.stdin.isatty():
            raise ValueError("pipe the answer on stdin when using -")
        answer = sys.stdin.read()
    else:
        answer = args.answer
    if not answer.strip():
        raise ValueError("answer must not be empty")
    if re.match(r"\A\s*---\s*\n", answer):
        raise ValueError("supply the Markdown body, not a second frontmatter block")
    if args.unresolved and (not args.blocker or not args.next_check):
        raise ValueError("--unresolved requires --blocker and --next-check")
    if not args.unresolved and (args.blocker or args.next_check):
        raise ValueError("--blocker and --next-check require --unresolved")
    now = datetime.now().astimezone().isoformat(timespec="seconds")
    metadata = {"status": "green", "revised_at": now}
    if args.expires_every is not None:
        metadata["checked_at"] = now  # a recurring window needs its clock started
    metadata.update(requested_lifecycle(args))
    require_verifiable_proof(answer, metadata)
    if args.unresolved:
        answer = answer.rstrip() + f"\n\nBlocker: {args.blocker}\n\nNext check: {args.next_check}"
    content = "---\n" + "".join(f"{k}: {json.dumps(v, ensure_ascii=False)}\n"
                                 for k, v in metadata.items()) + "---\n\n" + answer.rstrip() + "\n"
    if args.dry_run:
        print(f"Would create {label}:{path.relative_to(root)}", file=sys.stderr)
        write_stdout(content)
        return 0
    path.parent.mkdir(parents=True, exist_ok=True)
    # Exclusive creation protects an existing leaf even if it appeared after preflight.
    with path.open("x", encoding="utf-8") as handle:
        handle.write(content)
    return 0


# Built-in proof parsing, execution, and lifecycle status handling.

PROOF_FENCES = {
    "```bash": "bash",
    "```sh": "sh",
    "```python": "python3",
    "```python3": "python3",
}
OUTPUT_LIMIT = 4096
LEGACY_PROOF_MARKER = re.compile(r"^Proof: \((?:verified|falsified) at [^)\n]+\)$")
LEAF_STATES = ("green", "yellow", "brown")
STATE_RANK = {state: rank for rank, state in enumerate(LEAF_STATES)}


def worse(first, second):
    return first if STATE_RANK[first] >= STATE_RANK[second] else second
NUMBER_WORDS = {
    "one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6,
    "seven": 7, "eight": 8, "nine": 9, "ten": 10, "eleven": 11,
    "twelve": 12,
}


def discover_knowledge_root(directory):
    if directory.name == ".knowledge" and directory.is_dir():
        return directory
    knowledge = directory / ".knowledge"
    if knowledge.is_dir():
        return knowledge
    raise FileNotFoundError(
        f"working directory is not a knowledge root and contains no .knowledge: {directory}")


def semantic_components(relative):
    return tuple(part.casefold() for part in (*relative.parts[:-1], relative.stem))


def validate_tokens(tokens, parser):
    normalized = []
    for token in tokens:
        if not token or token in {".", ".."} or "/" in token or "\\" in token:
            parser.error(f"semantic token must be one path component: {token!r}")
        normalized.append(token.casefold())
    return tuple(normalized)


def path_matches(relative, tokens):
    components = semantic_components(relative)
    return not tokens or any(token in components for token in tokens)


def tree_files(root):
    leaves = []
    other_files = []
    for directory, names, files in os.walk(root):
        base = Path(directory)
        ignored = {".git"}
        if base == root and root == Path.home() / ".knowledge":
            ignored.add(".tools")
        names[:] = sorted(name for name in names if name not in ignored)
        for name in sorted(files):
            path = base / name
            relative = path.relative_to(root)
            if path.suffix == ".md":
                leaves.append((relative, path))
            else:
                other_files.append(relative)
    return leaves, other_files


def previous_content_line(lines, index):
    candidate = index - 1
    while candidate >= 0 and not lines[candidate].strip():
        candidate -= 1
    return candidate


def next_content_line(lines, index):
    candidate = index + 1
    while candidate < len(lines) and not lines[candidate].strip():
        candidate += 1
    return candidate


def closing_fence(lines, index):
    candidate = index + 1
    while candidate < len(lines):
        if lines[candidate] == "```":
            return candidate
        candidate += 1
    return None


def parse_proofs(path):
    original = path.read_text()
    lines = original.splitlines()
    proofs = []
    legacy_markers = []
    errors = metadata_errors(original)
    index = 0
    while index < len(lines):
        line = lines[index]
        if line.startswith("```"):
            closing = closing_fence(lines, index)
            if closing is None:
                errors.append((index + 1, "unclosed fenced block"))
                break
            index = closing + 1
            continue
        if line != "Proof:" and not LEGACY_PROOF_MARKER.fullmatch(line):
            if line.startswith("Proof:"):
                errors.append((index + 1, "malformed proof marker; write exactly `Proof:`"))
            index += 1
            continue
        if line != "Proof:":
            legacy_markers.append(index)

        previous = previous_content_line(lines, index)
        if previous < 0 or lines[previous].startswith("```"):
            errors.append((index + 1, "Proof: lacks a preceding assertion"))

        fence = next_content_line(lines, index)
        if fence >= len(lines) or lines[fence] not in PROOF_FENCES:
            errors.append((index + 1, "Proof: lacks a supported executable fence"))
            index += 1
            continue

        closing = closing_fence(lines, fence)
        if closing is None:
            errors.append((fence + 1, "unclosed proof fence"))
            break
        script = "\n".join(lines[fence + 1:closing])
        if not script.strip():
            errors.append((fence + 1, "proof script is empty"))
        else:
            proofs.append((index, fence + 1, PROOF_FENCES[lines[fence]], script))
        index = closing + 1
    return original, proofs, errors, legacy_markers


def set_lifecycle_status(text, state):
    if not text.startswith("---\n"):
        text = "---\n---\n\n" + text
    finish = text.find("\n---", 3)
    if finish < 0:
        raise OSError("cannot stamp status: unclosed metadata front matter")
    header = text[4:finish]
    field = re.compile(r"(?m)^status:.*$")
    value = f"status: {state}"
    if field.search(header):
        header = field.sub(value, header, count=1)
    else:
        header = value + ("\n" + header if header else "")
    tail = text[finish + 4:].lstrip("\r\n")
    return "---\n" + header + "\n---\n\n" + tail


def stamp_checked_at(text, timestamp):
    finish = text.find("\n---", 3)
    if finish < 0:
        raise OSError("cannot stamp check time: unclosed metadata front matter")
    header = text[4:finish]
    field = re.compile(r"(?m)^checked_at:.*$")
    value = f"checked_at: '{timestamp}'"
    if field.search(header):
        header = field.sub(value, header, count=1)
    else:
        header = header.rstrip() + ("\n" if header.strip() else "") + value
    return "---\n" + header + text[finish:]


def renew_leaf(args):
    """Record an explicit review of the complete answer, then re-evaluate this leaf's own proofs and status."""
    path = resolve_leaf(args.path, writable=True)
    if not re.fullmatch(r"[a-f0-9]{64}", args.hash):
        raise ValueError("revision must be the SHA-256 hash supplied by a leaf read")
    with path.open("r+") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        original = stream.read()
        if revision(original.encode()) != args.hash:
            raise RevisionConflict("kt: leaf changed; reread it before recording a check")
        if metadata_errors(original):
            raise ValueError("leaf has unsupported metadata; repair it before recording a check")
        updated = set_lifecycle_status(original, "yellow")
        updated = stamp_checked_at(updated, datetime.now().astimezone().isoformat(timespec="seconds"))
        if args.dry_run:
            write_stdout("".join(difflib.unified_diff(original.splitlines(True),
                         updated.splitlines(True), fromfile=str(path), tofile=str(path))))
            return 0
        stream.seek(0)
        stream.write(updated)
        stream.truncate()
    _, root = require_leaf_root(path)
    _, states, _, _ = verify_proofs(["--root", str(root)], emit=False, only=path.resolve().relative_to(root), raise_ok=True)
    if states["brown"]:
        print("kt: leaf is still brown after renewal: a proof failed; repair the leaf or its proof", file=sys.stderr)
        return 1
    return 0


def write_lifecycle_status(path, original, state, legacy_markers=()):
    lines = original.splitlines(keepends=True)
    for index in legacy_markers:
        ending = "\r\n" if lines[index].endswith("\r\n") else "\n" if lines[index].endswith("\n") else ""
        lines[index] = "Proof:" + ending
    updated = set_lifecycle_status("".join(lines), state)
    if updated == original:
        return
    # Write through existing links: atomic replacement would detach hardlinks.
    with path.open("r+") as stream:
        if stream.read() != original:
            raise OSError("leaf changed during verification; refusing to overwrite")
        stream.seek(0)
        stream.write(updated)
        stream.truncate()


def clipped(value):
    if isinstance(value, bytes):
        value = value.decode(errors="replace")
    value = value.strip()
    if len(value) <= OUTPUT_LIMIT:
        return value
    return value[:OUTPUT_LIMIT] + "\n... output truncated"


def run_proof(command, script, directory, timeout):
    argv = [command, "-c", script]
    if command == "bash":
        argv = ["bash", "-euo", "pipefail", "-c", script]
    elif command == "sh":
        argv = ["sh", "-eu", "-c", script]
    try:
        result = subprocess.run(
            argv,
            cwd=directory,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        return False, f"timed out after {timeout:g}s", error.stdout or "", error.stderr or ""
    except OSError as error:
        return False, f"could not execute proof: {error}", "", ""
    return result.returncode == 0, f"exit {result.returncode}", result.stdout, result.stderr


def positive_timeout(value):
    timeout = float(value)
    if timeout <= 0:
        raise argparse.ArgumentTypeError("timeout must be positive")
    return timeout


def metadata_datetime(value, field):
    try:
        parsed = datetime.fromisoformat(value)
    except (TypeError, ValueError) as error:
        raise ValueError(f"{field} must be ISO 8601") from error
    if parsed.utcoffset() is None:
        raise ValueError(f"{field} must include a timezone")
    return parsed


def expiry_duration(value):
    match = re.fullmatch(
        r"\s*(\d+(?:\.\d+)?|" + "|".join(NUMBER_WORDS) +
        r")\s*(s|sec(?:ond)?s?|m|min(?:ute)?s?|h|hours?|d|days?|w|weeks?)\s*",
        value.casefold())
    if not match:
        raise ValueError("expires_every must be a duration such as 14d, 2 weeks, or two weeks")
    amount = NUMBER_WORDS[match[1]] if match[1] in NUMBER_WORDS else float(match[1])
    unit = match[2][0]
    seconds = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}[unit]
    return timedelta(seconds=amount * seconds)


def lifecycle_state(original, now):
    metadata, _ = leaf_parts(original)
    if metadata.get("status") == "brown":
        return "brown", None
    try:
        expires = (metadata_datetime(metadata["expires_at"], "expires_at")
                   if metadata.get("expires_at") else None)
        checked = metadata.get("checked_at")
        if expires is not None and now >= expires and metadata.get("checked_at"):
            manual_checked = metadata_datetime(metadata["checked_at"], "checked_at")
            if manual_checked >= expires:
                expires = None
        if metadata.get("expires_every"):
            if checked is None:
                return "yellow", None
            verified = metadata_datetime(checked, "checked_at")
            periodic = verified + expiry_duration(metadata["expires_every"])
            expires = min(expires, periodic) if expires else periodic
    except ValueError as error:
        return "yellow", None
    if expires is not None and now >= expires:
        return "yellow", None
    return "green", None


def proof_parser_for_cli():
    parser = argparse.ArgumentParser(prog="kt prove", description="Run marked proofs in a knowledge tree, optionally filtered by tokens.")
    parser.add_argument(
        "tokens",
        nargs="*",
        metavar="TOKEN",
        help="select leaves matching any exact semantic path component",
    )
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument(
        "-r", "--root",
        type=Path,
        help="check one exact accessible knowledge root",
    )
    selection.add_argument("--local", action="store_true", help="check only the exact current-directory .knowledge root")
    selection.add_argument("--global", dest="global_root", action="store_true", help="check only the global knowledge root")
    parser.add_argument(
        "--timeout",
        type=positive_timeout,
        default=10.0,
        help="maximum seconds for each proof (default: 10)",
    )
    parser.add_argument(
        "--no-stamp",
        action="store_true",
        help="check without writing leaf lifecycle status",
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="print selected leaves, proof results, errors, and summary",
    )
    return parser


def print_proof_summary(states, proof_stats):
    proof_count, proof_passed, proof_failed = proof_stats
    leaf_count = sum(states.values())
    total_width = max(len(str(leaf_count)), len(str(proof_count)))
    pass_width = max(len(str(states["green"])), len(str(proof_passed)))
    third_width = max(len(str(states["yellow"])), len(str(proof_failed)))
    print(
        f"Leaves: {leaf_count:>{total_width}} total · "
        f"{states['green']:>{pass_width}} green · "
        f"{states['yellow']:>{third_width}} yellow · {states['brown']} brown"
    )
    print(
        f"Proofs: {proof_count:>{total_width}} total · "
        f"{proof_passed:>{pass_width}} valid · "
        f"{proof_failed:>{third_width}} failed · "
        f"{'FAIL' if states['brown'] or proof_failed else 'SUCCESS'}"
    )


def verify_proofs(arguments=None, emit=True, only=None, raise_ok=False):
    """Evaluate proofs. Status only ever moves down here (expiry, failed proofs) unless the leaf is
    verifiable and every proof passes; raise_ok is for kt renew, whose manual review may raise it."""
    parser = proof_parser_for_cli()
    args = parser.parse_args(arguments)
    tokens = validate_tokens(args.tokens, parser)
    directory = Path.cwd().resolve()
    if args.root is not None:
        root = args.root.expanduser().resolve()
        if not root.is_dir():
            if args.verbose:
                print(f"ERROR knowledge root is not a directory: {root}", file=sys.stderr)
            return (1, {state: 0 for state in LEAF_STATES}, [], (0, 0, 0)) if not emit else 1
    else:
        try:
            root = discover_knowledge_root(directory)
        except FileNotFoundError as error:
            if args.verbose:
                print(f"ERROR {error}", file=sys.stderr)
            return (1, {state: 0 for state in LEAF_STATES}, [], (0, 0, 0)) if not emit else 1

    # Keep the execution engine guarded against forced-private roots as well.
    if root_access(root) == "force-private" or any(
            other != root and other.is_relative_to(root) and root_access(other, label) == "force-private"
            for label, other in discovered_roots()):
        raise AccessRequired("kt: requested proof scope is unavailable")
    leaves, other_files = tree_files(root)
    selected = [(relative, path) for relative, path in leaves
                if path_matches(relative, tokens) and only in (None, relative)]
    selected_other = [relative for relative in other_files
                      if path_matches(relative, tokens) and only is None]
    failed = 0
    failed_paths = set()
    states = {state: 0 for state in LEAF_STATES}
    non_green = []
    proof_count = 0
    proof_passed = 0
    proof_failed = 0
    for relative in selected_other:
        failed += 1
        failed_paths.add(relative)
        states["brown"] += 1
        non_green.append(("brown", relative))
        if args.verbose:
            print(f"ERROR {relative}: non-Markdown file inside knowledge tree")

    proof_directory = root.parent
    now = datetime.now().astimezone()
    for relative, path in selected:
        original, proofs, errors, legacy_markers = parse_proofs(path)
        if not original.strip():
            states["green"] += 1
            continue
        metadata, _ = leaf_parts(original)
        raw_verifiable = metadata.get("verifiable", "false").casefold()
        verifiable = raw_verifiable == "true"
        if raw_verifiable not in ("true", "false"):
            errors.append((1, "verifiable must be true or false"))
        if verifiable and not proofs:
            errors.append((1, "verifiable leaf requires at least one proof"))
        results = []
        stamp_failed = False
        leaf_falsified = bool(errors)
        state, lifecycle_error = lifecycle_state(original, now)
        if lifecycle_error:
            errors.append((1, lifecycle_error))
            leaf_falsified = True
        header = original.split("\n---", 1)[0] if original.startswith("---\n") else ""
        sticky_falsification = metadata.get("status") == "brown"
        if args.verbose:
            print(f"LEAF {relative} proofs={len(proofs)}")
        for line, message in errors:
            failed += 1
            failed_paths.add(relative)
            if args.verbose:
                print(f"  ERROR line={line} {message}")
        for marker, line, command, script in proofs:
            proof_count += 1
            passed, detail, stdout, stderr = run_proof(
                command, script, proof_directory, args.timeout)
            results.append((marker, passed))
            if passed:
                proof_passed += 1
                if args.verbose:
                    print(f"  PASS line={line} language={command}")
                continue
            proof_failed += 1
            failed += 1
            leaf_falsified = True
            failed_paths.add(relative)
            if args.verbose:
                print(f"  FAIL line={line} language={command} {detail}")
                for label, output in (("stdout", stdout), ("stderr", stderr)):
                    output = clipped(output)
                    if output:
                        print(f"    {label}: {output}")
        auto_verified = bool(verifiable and proofs and not errors and
                             len(results) == len(proofs) and
                             all(passed for _, passed in results))
        if sticky_falsification and not auto_verified:
            failed += 1
            failed_paths.add(relative)
            if args.verbose:
                print("  ERROR leaf remains falsified pending independent review")
        if auto_verified:
            state = "green"
        elif leaf_falsified or any(not passed for _, passed in results) or state == "brown":
            state = "brown"
        elif not raise_ok:
            state = worse(state, metadata.get("status", "green"))
        if not args.no_stamp:
            try:
                write_lifecycle_status(path, original, state, legacy_markers)
            except OSError as error:
                failed += 1
                failed_paths.add(relative)
                stamp_failed = True
                if args.verbose:
                    print(f"  ERROR stamping proofs: {error}")

        if stamp_failed:
            state = "brown"
        states[state] += 1
        if state != "green":
            non_green.append((state, relative))

    if args.verbose:
        print(
            f"SUMMARY root={root} leaves={len(selected)} proofs={proof_count} "
            f"failures={failed}")
    addressed = [(state, f"{root_identity(root)}:{relative}")
                 for state, relative in non_green]
    proof_stats = (proof_count, proof_passed, proof_failed)
    if emit:
        print_proof_summary(states, proof_stats)
        for state, address in sorted(addressed, key=lambda item: item[1]):
            if state == "brown":
                print(f"{state} {address}", file=sys.stderr)
        return 1 if states["brown"] else 0
    return (1 if states["brown"] else 0), states, addressed, proof_stats


def prove(arguments):
    arguments = list(arguments)
    if "--help" in arguments or "-h" in arguments:
        return verify_proofs(arguments)
    local_selected = "--local" in arguments
    global_selected = "--global" in arguments
    arguments = [argument for argument in arguments if argument not in ("--local", "--global")]
    explicit_root = any(a in ("--root", "-r") or a.startswith("--root=") for a in arguments)
    if sum((local_selected, global_selected, explicit_root)) > 1:
        raise ValueError("select only one of --local, --global, or --root")
    if arguments and not arguments[0].startswith("-") and Path(arguments[0]).expanduser().is_dir():
        if local_selected or global_selected or explicit_root:
            raise ValueError("a positional proof directory cannot be combined with a root selector")
        root = Path(arguments.pop(0)).expanduser().resolve()
        if root.name != ".knowledge" and (root / ".knowledge").is_dir():
            root /= ".knowledge"
        arguments = ["--root", str(root), *arguments]
    elif local_selected:
        root = local_root()
        if not root.is_dir():
            raise AccessRequired("kt: no local knowledge root in the current directory")
        require_root(root, "local")
        arguments = ["--root", str(root), *arguments]
    elif global_selected:
        root = global_knowledge_root()
        require_root(root, "global")
        arguments = ["--root", str(root), *arguments]
    elif not explicit_root:
        allowed = roots()
        if not allowed:
            raise AccessRequired("kt: no accessible proof roots")
        totals = {state: 0 for state in LEAF_STATES}
        proof_totals = [0, 0, 0]
        non_green = []
        for label, root in allowed:
            if any(child != root and child.is_relative_to(root) and root_access(child, child_label) != "allow"
                   for child_label, child in discovered_roots()):
                raise AccessRequired(f"kt: proof scope {label!r} contains a restricted registered subtree; narrow the scope or approve it first")
            code, states, paths, proof_stats = verify_proofs(["--root", str(root), *arguments], emit=False)
            for state in LEAF_STATES:
                totals[state] += states[state]
            for index, count in enumerate(proof_stats):
                proof_totals[index] += count
            non_green.extend(paths)
        print_proof_summary(totals, proof_totals)
        for state, address in sorted(non_green, key=lambda item: item[1]):
            if state == "brown":
                print(f"{state} {address}", file=sys.stderr)
        return 1 if totals["brown"] else 0
    selected = None
    for index, argument in enumerate(arguments):
        if argument in ("--root", "-r") and index + 1 < len(arguments):
            selected = arguments[index + 1]
        elif argument.startswith("--root="):
            selected = argument.partition("=")[2]
    if selected is None:
        raise AccessRequired("kt: select an accessible proof root")
    selected = Path(selected).expanduser().resolve()
    require_root(selected, next((label for label, root in discovered_roots() if root == selected), None))
    if any(root != selected and root.is_relative_to(selected) and root_access(root, label) != "allow" for label, root in discovered_roots()):
        raise AccessRequired("kt: proof scope contains a restricted registered subtree; narrow the scope or approve it first")
    return verify_proofs(arguments)


# CLI argument schema and command dispatch.

def open_command(args):
    return open_leaf(args.path)


def print_info(args):
    """Print startup knowledge; without a usable local root, fall back to the global root."""
    root = local_root()
    has_root = root.is_dir()
    if has_root:
        require_root(root, "local")
    has_orientation = has_root and (root / "where/am/i.md").is_file()
    procedure = resolve_leaf("global:how/to/use/knowledgetrees.md")
    print("=== global:how/to/use/knowledgetrees.md ===")
    contents = procedure.read_text()
    show_leaf(contents, "global:how/to/use/knowledgetrees.md")
    if has_orientation:
        print("=== local:where/am/i.md ===")
        contents = (root / "where/am/i.md").read_text()
        show_leaf(contents, "local:where/am/i.md")
    else:
        reason = ("local knowledge root has no where/am/i.md (add one to orient this project)" if has_root
                  else "no ./.knowledge in the current directory (kt init creates one)")
        print(f"=== kt note: {reason}; using the global root only ===")
        try:
            orientation = resolve_leaf("global:where/am/i.md")
        except (ValueError, AccessRequired) as error:
            print(f"=== global orientation unavailable: {error} ===")
        else:
            print("=== global:where/am/i.md ===")
            contents = orientation.read_text()
            show_leaf(contents, "global:where/am/i.md")
    print("=== kt dict ===")
    dictionary(argparse.Namespace(roots=[]))
    scope = "--local" if has_root else "--global"
    print(f"=== kt prove {scope} ===")
    return prove([scope])


def initialize_tree(args):
    root = local_root()
    if root.exists():
        raise ValueError(f"knowledge root already exists: {root}")
    access_config()  # Refuse malformed registry before creating a tree that cannot be registered.
    for branch in ("how", "what", "where", "why", "does", "is"):
        (root / branch).mkdir(parents=True, exist_ok=True)
    (root / "where/am").mkdir(parents=True)
    (root / "where/am/i.md").write_text(args.orientation or "")
    if args.project:
        for relative in ("what/is/the/spec.md", "what/is/the/plan.md",
                         "what/is/the/state.md", "what/is/next.md"):
            path = root / relative
            path.parent.mkdir(parents=True, exist_ok=True)
            path.touch()
    register_root(root)
    return 0


def register_command(args):
    register_root(args.path, args.name)
    root = Path(args.path).expanduser().resolve()
    return 0


def roots_command(args):
    for label, root in discovered_roots():
        policy = root_access(root, label)
        if policy == "force-private":
            continue
        if PRETTY:
            print(f"[{policy}] {paint(label.ljust(7), '36')}  {root if policy == 'allow' else '(restricted)'}")
        else:
            print(f"{label}\t{policy}\t{root if policy == 'allow' else '(restricted)'}")
    if args.command is None:
        allowed = roots()
        entry = allowed[0][1] / "where/am/i.md" if allowed else None
        if entry is not None and entry.is_file():
            _, body = leaf_parts(entry.read_text())
            if PRETTY:
                print("\n" + paint("Orientation", "1"))
                print(textwrap.shorten(" ".join(body.split()), width=600, placeholder=" …"))
            else:
                print("orientation=" + textwrap.shorten(" ".join(body.split()), width=240, placeholder=" …"))
        if not PRETTY:
            print("commands: info | init | find | grep | QUESTION | open | dict | add | rewrite | check | status | rm | mv | combine | prove | roots | grants | register | access | permissions; --help; --pretty")
            return 0
        print("\nkt find leaves                     ranked keyword lookup")
        print("kt where is vivado                 exact answer or nearby matches")
        print("kt how to _                        list a question branch")
        print('kt find "how to add knowledge leaves"')
        print("kt open global:how/to/add/knowledge/leaves.md")
        print("kt prove [directory] [tokens] [--no-stamp]")
        print('kt add "how to do the thing" "The answer."')
    return 0


def command_parser():
    parser = argparse.ArgumentParser(description=__doc__, epilog="Questions: kt where is vivado; kt how to _ (list a branch). Interface guide: kt open global:how/to/use/kt.md. --root is command-specific, not a global option.")
    parser.set_defaults(handler=roots_command)
    parser.add_argument("--pretty", action="store_true", help="human-oriented layout and terminal colors (default: compact plain text)")
    parser.add_argument("--lean", action="store_true", help="show leaf bodies without metadata; a notice leads only non-green leaves (used by agent tools)")
    parser.add_argument("--dangerously-skip-permissions", action="store_true", help="persistently bypass ask/deny after user confirmation; force-private remains enforced")
    commands = parser.add_subparsers(dest="command")
    showing_info = commands.add_parser("info", help="prove and load the local startup knowledge")
    showing_info.set_defaults(handler=print_info)
    initializing = commands.add_parser("init", help="create and register a neutral local knowledge tree (ask policy)")
    initializing.add_argument("orientation", nargs="?", help="optional literal contents of where/am/i.md")
    initializing.add_argument("--project", action="store_true", help="also create empty spec, plan, state, and next leaves")
    initializing.set_defaults(handler=initialize_tree)
    search = commands.add_parser("find", help="rank keyword matches across project and global roots", description="Search all permitted active roots. No --root option; open the root-qualified address returned by the search.")
    search.set_defaults(handler=find)
    search.add_argument("--pretty", action="store_true", help="human-oriented layout")
    search.add_argument("terms", nargs="+", help="words or a quoted question")
    search.add_argument("--limit", type=int, default=10)
    search.add_argument("--min-coverage", type=float, default=0.6)
    opening = commands.add_parser("open", help="print a leaf verbatim, including metadata")
    opening.set_defaults(handler=open_command)
    opening.add_argument("path", help="local:path, global:path, ROOT:path (registered root), or absolute .md path; project: aliases local:")
    vocabulary = commands.add_parser("dict", help="print useful final-two leaf-path segments from accessible roots")
    vocabulary.set_defaults(handler=dictionary)
    vocabulary.add_argument("roots", nargs="*", help="optional root labels or configured root paths; default: all accessible roots")
    replacing = commands.add_parser("rewrite", help="rewrite a leaf body using its read revision")
    replacing.set_defaults(handler=rewrite_leaf)
    replacing.add_argument("path", help="existing leaf address")
    replacing.add_argument("hash", help="required SHA-256 revision supplied by the leaf read")
    replacing.add_argument("contents", help="complete answer body; use -- before positional arguments beginning with -")
    replacing.add_argument("--dry-run", action="store_true", help="show the resulting diff without writing")
    lifecycle_options(replacing, clear=True)
    checking = commands.add_parser("renew", help="confirm the complete leaf is accurate: records checked_at and re-evaluates its status")
    checking.set_defaults(handler=renew_leaf)
    checking.add_argument("path", help="existing leaf address")
    checking.add_argument("hash", help="required SHA-256 revision supplied by the full read")
    checking.add_argument("--dry-run", action="store_true")
    for name in ("rm", "mv"):
        maintenance = commands.add_parser(name, help="remove a leaf" if name == "rm" else "move a leaf without overwriting")
        maintenance.set_defaults(handler=relocate_leaf)
        maintenance.add_argument("path", help="source leaf address")
        if name == "mv":
            maintenance.add_argument("destination", help="destination Markdown leaf address")
        maintenance.add_argument("--expect", required=True, help="source SHA-256 from a full leaf read")
        maintenance.add_argument("--dry-run", action="store_true")
    combining = commands.add_parser("combine", help="combine ordered Markdown bodies into one leaf")
    combining.set_defaults(handler=combine_leaves)
    combining.add_argument("paths", nargs="+", help="source leaf addresses in order")
    combining.add_argument("-o", "--output", required=True, help="destination Markdown leaf address")
    combining.add_argument("--expect", help="destination SHA-256 required when replacing an existing leaf")
    combining.add_argument("--dry-run", action="store_true")
    adding = commands.add_parser("capture", aliases=["add"], help="create a question-derived leaf in one call")
    adding.set_defaults(handler=capture)
    adding.add_argument("question", help="quoted full question; preserve multi-word components with hyphens")
    adding.add_argument("answer", help="Markdown answer, or - to read stdin")
    scope = adding.add_mutually_exclusive_group()
    scope.add_argument("--global", dest="global_root", action="store_true")
    scope.add_argument("--local", "--project", dest="project", action="store_true")
    scope.add_argument("--root", help="existing knowledge root (for example, example/)")
    adding.add_argument("--dry-run", action="store_true", help="preview path and complete leaf without writing")
    adding.add_argument("--unresolved", action="store_true")
    adding.add_argument("--blocker")
    adding.add_argument("--next-check")
    lifecycle_options(adding)
    searching = commands.add_parser("grep", help="literal or regex text search across permitted roots (not semantic)", description="Search leaf text, front matter included, in every permitted active root. Fixed string by default; use --regex for a Python regular expression. Output: ADDRESS:LINE: text. Exit 1 when nothing matches.")
    searching.set_defaults(handler=grep_command)
    searching.add_argument("pattern", help="text to find; use -- before a pattern beginning with -")
    searching.add_argument("-E", "--regex", action="store_true", help="treat the pattern as a Python regular expression")
    searching.add_argument("-i", "--ignore-case", action="store_true")
    searching.add_argument("-l", "--files-with-matches", action="store_true", help="print only leaf addresses")
    searching.add_argument("-C", "--context", type=int, default=0, help="lines of context around each match")
    searching.add_argument("--limit", type=int, default=50, help="maximum matches (or leaves with -l) to print")
    statusing = commands.add_parser("status", help="list non-green leaves with reasons, without running proofs")
    statusing.set_defaults(handler=status_command)
    statusing.add_argument("--local", action="store_true")
    statusing.add_argument("--global", dest="global_root", action="store_true")
    statusing.add_argument("--root", help="one accessible knowledge-root directory")
    commands.add_parser("roots", help="show root policies without reading their contents")
    register = commands.add_parser("register", help="register an existing root as private (ask)")
    register.set_defaults(handler=register_command)
    register.add_argument("name")
    register.add_argument("path")
    access = commands.add_parser("access", help="inspect, approve, deny, or revoke root access")
    access.set_defaults(handler=access_command)
    access.add_argument("root", help="root label or absolute root path")
    access.add_argument("decision", nargs="?", choices=["allow", "deny", "ask", "force-private", "reset", "revoke"], help="revoke narrows access already granted (project scope: this directory; all: everywhere)")
    access.add_argument("--scope", choices=["session", "project", "all"], default="project")
    access.add_argument("--subdirectories", action="store_true", help="explicitly extend a project approval to descendant directories")
    granting = commands.add_parser("grants", help="list each root's effective access and why, including roots whose tree is gone")
    granting.set_defaults(handler=grants_command)
    granting.add_argument("root", nargs="?", help="optional root label or absolute path")
    permissions = commands.add_parser("permissions", help="inspect or persist user permission bypass")
    permissions.set_defaults(handler=permissions_command)
    settings = permissions.add_mutually_exclusive_group()
    settings.add_argument("--dangerously-skip-permissions", action="store_true")
    settings.add_argument("--reset", action="store_true")
    commands.add_parser("prove", help="check marked proofs: [directory] [tokens] [options]")
    return parser


def main():
    global PRETTY, LEAN
    arguments = sys.argv[1:]
    # Allow --pretty before the command or among its options, respecting --.
    boundary = arguments.index("--") if "--" in arguments else len(arguments)
    PRETTY = "--pretty" in arguments[:boundary]
    LEAN = "--lean" in arguments[:boundary]
    arguments = [arg for arg in arguments[:boundary] if arg not in ("--pretty", "--lean")] + arguments[boundary:]
    if not (arguments and arguments[0] in ("-h", "--help")):
        try:
            prune_stale_grants()
        except (OSError, ValueError):
            pass  # a broken access file is reported by the command that needs it
    if arguments and arguments[0] == "prove":
        return prove(arguments[1:])
    if arguments and arguments[0].split() and arguments[0].split()[0].casefold() in QUESTION_STARTS:
        return question(arguments)
    parser = command_parser()
    args = parser.parse_args(arguments)
    if args.command != "permissions" and args.dangerously_skip_permissions:
        code = permissions_command(argparse.Namespace(dangerously_skip_permissions=True, reset=False))
        if code or args.command is None:
            return code
    if args.command == "grep" and (args.limit < 1 or args.context < 0):
        parser.error("--limit must be positive and --context non-negative")
    if args.command == "find":
        if args.limit < 1:
            parser.error("--limit must be positive")
        if not 0 < args.min_coverage <= 1:
            parser.error("--min-coverage must be greater than zero and at most one")
    return args.handler(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
    except RevisionConflict as error:
        print(error, file=sys.stderr)
        sys.exit(4)
    except AccessRequired as error:
        print(error, file=sys.stderr)
        sys.exit(3)
    except (OSError, UnicodeError, ValueError, sqlite3.Error) as error:
        print(f"kt: {error}", file=sys.stderr)
        sys.exit(2)
