ACCESS_VALUES = {"allow", "ask", "deny", "force-private"}
PRETTY = False


class AccessRequired(ValueError):
    pass


class RevisionConflict(ValueError):
    pass


# Root registry, identities, and access policy.

def global_knowledge_root():
    return Path(os.environ.get("KT_GLOBAL_ROOT", "~/.knowledge")).expanduser().resolve()


def access_config_path():
    return Path(os.environ.get("KT_CONFIG", str(Path(os.environ.get("KT_GLOBAL_ROOT", "~/.knowledge")).expanduser() / ".tools/roots.json"))).expanduser()


def access_config():
    path = access_config_path()
    if not path.exists():
        return {"roots": {}, "projects": {}, "dangerously_skip_permissions": False}
    value = json.loads(path.read_text())
    if not isinstance(value, dict) or not isinstance(value.get("roots", {}), dict) or not isinstance(value.get("projects", {}), dict):
        raise ValueError("invalid kt access configuration")
    if not isinstance(value.get("dangerously_skip_permissions", False), bool):
        raise ValueError("invalid kt permission bypass setting")
    for label, spec in value.get("roots", {}).items():
        if not isinstance(spec, dict) or spec.get("access", "ask") not in ACCESS_VALUES:
            raise ValueError("invalid configured root policy")
        if label not in ("local", "project", "global") and not isinstance(spec.get("path"), str):
            raise ValueError("configured root needs an absolute path")
        if "path" in spec and (not isinstance(spec["path"], str) or not Path(spec["path"]).expanduser().is_absolute()):
            raise ValueError("registered root paths must be absolute (tilde expansion is allowed)")
    for project, grants in value.get("projects", {}).items():
        if not Path(project).is_absolute() or not isinstance(grants, dict) or any(not (v in ACCESS_VALUES - {"force-private"} if isinstance(v, str) else isinstance(v, dict) and v.get("access") in ACCESS_VALUES - {"force-private"} and isinstance(v.get("subdirectories", False), bool)) for v in grants.values()):
            raise ValueError("invalid project access grants")
    value.setdefault("roots", {})
    value.setdefault("projects", {})
    return value


def local_root(cwd=None):
    directory = Path(cwd or Path.cwd()).resolve()
    return (directory if directory.name == ".knowledge" else directory / ".knowledge").resolve()


def configured_root(name, spec, cwd=None):
    if "path" in spec:
        return Path(spec["path"]).expanduser().resolve()
    if name in ("local", "project"):
        return local_root(cwd)
    return global_knowledge_root()


def root_identity(root, cwd=None):
    root = Path(root).resolve()
    if root == local_root(cwd):
        return "local"
    if root == global_knowledge_root():
        return "global"
    return str(root)


def discovered_roots(config=None, cwd=None):
    config = access_config() if config is None else config
    local = local_root(cwd)
    global_root = global_knowledge_root()
    paths = [local] if local.is_dir() else []
    if global_root not in paths:
        paths.append(global_root)
    for name, spec in config["roots"].items():
        root = configured_root(name, spec, cwd)
        if root not in paths:
            paths.append(root)
    return [(root_identity(root, cwd), root) for root in paths]


def root_aliases(config=None, cwd=None):
    config = access_config() if config is None else config
    aliases = dict(discovered_roots(config, cwd))
    if local_root(cwd).is_dir():
        aliases["local"] = aliases["project"] = local_root(cwd)
    aliases["global"] = global_knowledge_root()
    for name, spec in config["roots"].items():
        aliases.setdefault(name, configured_root(name, spec, cwd))
    return aliases


def access_session():
    return os.environ.get("KT_SESSION_ID") or os.environ.get("CODEX_THREAD_ID") or os.environ.get("OPENCODE_SESSION_ID")


def access_database():
    directory = Path(os.environ.get("KT_ACCESS_STATE_DIR", str(Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "knowledgetrees")))
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    path = directory / "access.sqlite3"
    descriptor = os.open(path, os.O_CREAT | os.O_WRONLY, 0o600)
    os.close(descriptor)
    os.chmod(path, 0o600)
    return path


def root_access(root, label=None, cwd=None, config=None):
    config = access_config() if config is None else config
    cwd = Path(cwd or Path.cwd()).resolve()
    root = Path(root).resolve()
    local = local_root(cwd)
    policies = [(configured_root(name, spec, cwd), spec.get("access", "ask"))
                for name, spec in config["roots"].items()]
    # Forced privacy is checked before bypass or grants and inherited by subtrees.
    if root != local and any(policy == "force-private" and root.is_relative_to(path)
                             for path, policy in policies):
        return "force-private"
    if config.get("dangerously_skip_permissions", False):
        return "allow"
    if any(policy == "deny" and root.is_relative_to(path) for path, policy in policies):
        return "deny"
    matching = [policy for path, policy in policies if path == root]
    policy = "allow" if root == local or "allow" in matching else matching[-1] if matching else "ask"
    if policy == "force-private":
        policy = "allow"  # Only an exact local tree reaches this branch.
    # Exact pairwise scope by default; inheritance must be explicitly approved.
    projects = sorted(((Path(path), grants) for path, grants in config["projects"].items()
                       if cwd.is_relative_to(Path(path))), key=lambda item: len(item[0].parts), reverse=True)
    for project, grants in projects:
        if str(root) in grants:
            grant = grants[str(root)]
            access = grant if isinstance(grant, str) else grant["access"]
            inherit = isinstance(grant, dict) and grant.get("subdirectories", False)
            if cwd == project or inherit:
                return access
    session = access_session()
    if session:
        path = Path(os.environ.get("KT_ACCESS_STATE_DIR", str(Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "knowledgetrees"))) / "access.sqlite3"
        if path.is_file():
            with sqlite3.connect(f"file:{path}?mode=ro", uri=True) as connection:
                exists = connection.execute("SELECT name FROM sqlite_master WHERE name='grants'").fetchone()
                if exists:
                    rows = connection.execute("SELECT project, access FROM grants WHERE session=? AND root=? AND touched>?", (hashlib.sha256(session.encode()).hexdigest(), str(root), time.time()-7*86400)).fetchall()
                    rows = sorted(((Path(project), access) for project, access in rows if cwd == Path(project)), key=lambda row: len(row[0].parts), reverse=True)
                    if rows:
                        return rows[0][1]
    return policy


def require_root(root, label=None):
    if label is None:
        label = next((name for name, path in discovered_roots() if path == Path(root).resolve()), None)
    policy = root_access(root, label)
    if policy != "allow":
        if policy == "force-private":
            raise AccessRequired("kt: requested root is unavailable")
        name = root_identity(root)
        message = f"kt: root {name!r} is denied" if policy == "deny" else f"kt: root {name!r} requires approval; in your terminal run: kt access {shlex.quote(name)} allow --scope project"
        raise AccessRequired(message)


def roots():
    result = []
    for label, root in discovered_roots():
        try:
            require_root(root, label)
        except AccessRequired:
            pass
        else:
            result.append((label, root))
    return result


def owning_root(path):
    path = Path(path).resolve()
    owners = [(label, root) for label, root in discovered_roots() if path.is_relative_to(root)]
    return max(owners, key=lambda pair: len(pair[1].parts), default=None)


def leaf_allowed(path):
    owner = owning_root(path)
    return owner is not None and root_access(owner[1], owner[0]) == "allow"



def require_leaf_root(path):
    owner = owning_root(path)
    if owner is None:
        raise AccessRequired("kt: leaf is outside configured knowledge roots")
    require_root(owner[1], owner[0])
    return owner



def save_access_config(config):
    path = access_config_path()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=".kt-config-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(config, stream, indent=2)
            stream.write("\n")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def register_root(root, name=None):
    root = Path(root).expanduser().resolve()
    config = access_config()
    existing = next((label for label, spec in config["roots"].items()
                     if isinstance(spec.get("path"), str) and Path(spec["path"]).expanduser().resolve() == root), None)
    if existing:
        return existing
    if not root.is_dir():
        raise ValueError("register an existing knowledge-root directory")
    name = name or "root-" + hashlib.sha256(str(root).encode()).hexdigest()[:12]
    if name in ("local", "project", "global") or name in config["roots"] or not re.fullmatch(r"[a-z][a-z0-9-]*", name):
        raise ValueError("choose a unique root name using lowercase words and hyphens")
    config["roots"][name] = {"path": str(root), "access": "ask"}
    save_access_config(config)
    return name


def access_command(args):
    config = access_config()
    available = list(root_aliases(config).items())
    root = dict(available).get(args.root)
    label = args.root
    if root is None:
        if not Path(args.root).expanduser().is_absolute():
            raise ValueError("select a discovered root label or an absolute knowledge-root path")
        root = Path(args.root).expanduser().resolve()
        if not root.is_dir():
            raise ValueError("knowledge root does not exist")
        label = next((name for name, path in available if path == root), "root-" + hashlib.sha256(str(root).encode()).hexdigest()[:12])
    current = root_access(root, label, config=config)
    label = root_identity(root)
    if args.decision is None:
        if current == "force-private":
            print("force-private")
            return 0
        print(f"{label}: {current}\nConfiguration: {access_config_path()}")
        return 0
    if args.decision == "force-private":
        args.scope = "all"
    session = access_session()
    if args.scope == "session" and not session:
        raise ValueError("session scope requires KT_SESSION_ID (or CODEX_THREAD_ID/OPENCODE_SESSION_ID); use the same identifier in the agent environment")
    if not sys.stdin.isatty():
        raise AccessRequired("kt: access decisions require confirmation in your own interactive terminal; no grant was saved")
    project = str(Path.cwd().resolve())
    subdirectories = getattr(args, "subdirectories", False)
    if subdirectories and args.scope != "project":
        raise ValueError("--subdirectories applies only to persistent project approvals")
    print(f"Root: {root if current != 'force-private' else '(force-private)'}\nScope: {args.scope}" + (f" ({project}" + (" and descendants)" if subdirectories else ")") if args.scope != "all" else " (all projects)"))
    print("Retrieved knowledge may be sent to the agent's configured model provider. This policy controls kt, not direct filesystem reads.")
    if input(f"Save {args.decision!r} decision? [y/N] ").strip().lower() not in ("y", "yes"):
        print("No access decision saved.")
        return 1
    if args.scope == "session":
        with sqlite3.connect(access_database()) as connection:
            connection.execute("CREATE TABLE IF NOT EXISTS grants (session TEXT, project TEXT, root TEXT, access TEXT, touched REAL, PRIMARY KEY(session,project,root))")
            connection.execute("DELETE FROM grants WHERE touched<?", (time.time()-7*86400,))
            key = hashlib.sha256(session.encode()).hexdigest()
            if args.decision == "reset":
                connection.execute("DELETE FROM grants WHERE session=? AND project=? AND root=?", (key, project, str(root)))
            else:
                connection.execute("INSERT OR REPLACE INTO grants VALUES (?,?,?,?,?)", (key, project, str(root), args.decision, time.time()))
    else:
        if args.scope == "all":
            matching = [name for name, spec in config["roots"].items()
                        if configured_root(name, spec) == root]
            if args.decision == "reset":
                for name in matching:
                    del config["roots"][name]
            else:
                for name in matching or [label]:
                    config["roots"][name] = {"path": str(root), "access": args.decision}
        else:
            grants = config["projects"].setdefault(project, {})
            if args.decision == "reset":
                grants.pop(str(root), None)
            else:
                grants[str(root)] = {"access": args.decision, "subdirectories": True} if subdirectories else args.decision
                if label not in dict(available):
                    config["roots"][label] = {"path": str(root), "access": "ask"}
        save_access_config(config)
    private = root_access(root, label, config=config) == "force-private"
    print(f"Saved {args.decision}" + ("." if private else f" for {label} ({args.scope})."))
    return 0


def permissions_command(args):
    config = access_config()
    if not args.dangerously_skip_permissions and not args.reset:
        print("dangerously_skip_permissions=" + str(config.get("dangerously_skip_permissions", False)).lower())
        return 0
    if not sys.stdin.isatty():
        raise AccessRequired("kt: permission settings require confirmation in your own interactive terminal; no setting was saved")
    enabled = args.dangerously_skip_permissions
    print("Permanently bypass kt ask/deny policies; force-private remains enforced." if enabled
          else "Restore normal kt access policy checks.")
    if input("Save permission setting? [y/N] ").strip().lower() not in ("y", "yes"):
        print("No permission setting saved.")
        return 1
    config["dangerously_skip_permissions"] = enabled
    save_access_config(config)
    print("dangerously_skip_permissions=" + str(enabled).lower())
    return 0


# Lookup ranking and compact/pretty rendering.

def paint(value, color):
    if PRETTY and sys.stdout.isatty() and "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb":
        return f"\033[{color}m{value}\033[0m"
    return str(value)


def leaf_parts(text):
    metadata = {}
    body = text
    match = re.match(r"\A---\s*\n(.*?)\n---\s*(?:\n|$)", text, re.S)
    if match:
        body = text[match.end():]
        for key in ("verified_at", "falsified_at", "status", "blocker", "next_check"):
            value = re.search(rf"^\s*{key}:\s*([^\n]+)", match[1], re.M)
            if value:
                metadata[key] = value[1].strip().strip("\"'")
    return metadata, body


def words(value):
    return list(dict.fromkeys(re.findall(r"[^\W_]+", value.casefold())))


GRAMMATICAL = set("a an the to is are of for in on at with how what where when why who which does do can should i we my our this that it be as and or".split())


def coverage(terms, haystack):
    meaningful = [t for t in terms if t not in GRAMMATICAL] or terms
    return sum(t in haystack for t in meaningful) / len(meaningful) if meaningful else 1.0



@dataclass(frozen=True)
class RootAccessView:
    roots: tuple
    policies: dict

    @classmethod
    def load(cls):
        config = access_config()
        catalog = tuple(discovered_roots(config))
        policies = {root: root_access(root, label, config=config) for label, root in catalog}
        return cls(catalog, policies)

    def allowed_roots(self):
        return [(label, root) for label, root in self.roots if self.policies[root] == "allow"]

    def allows(self, path):
        canonical = Path(path).resolve()
        owner = max((root for _, root in self.roots if canonical.is_relative_to(root)),
                    key=lambda root: len(root.parts), default=None)
        return owner is not None and self.policies[owner] == "allow"


class LookupContext:
    """Lazy, invocation-only access and text reuse; no private-root indexing."""
    def __init__(self):
        self.access = RootAccessView.load()
        self.contents = {}

    def read(self, path):
        if path not in self.contents:
            if not self.access.allows(path):
                raise AccessRequired("kt: requested leaf is unavailable")
            text = path.read_text()
            metadata, body = leaf_parts(text)
            self.contents[path] = (text, metadata, body)
        return self.contents[path]


def leaves(root, access=None):
    if not root.is_dir():
        return
    access = access or RootAccessView.load()
    for directory, directories, files in os.walk(root, followlinks=False):
        directories[:] = sorted(d for d in directories if not d.startswith(".") and access.allows(Path(directory) / d))
        for name in sorted(files):
            path = Path(directory) / name
            if name.endswith(".md") and not path.is_symlink() and access.allows(path):
                yield path


def find(args, branches=None, browse=False, context=None):
    terms = words(" ".join(args.terms))
    if not terms and not browse:
        print("kt: supply at least one word to search", file=sys.stderr)
        return 2
    context = context or LookupContext()
    if branches is None:
        allowed = context.access.allowed_roots()
        if not allowed:
            raise AccessRequired("kt: no accessible knowledge roots; review kt access policies")
        branches = [(label, root, root) for label, root in allowed]
    results = []
    for precedence, (label, root, branch) in enumerate(
            branches):
        for path in leaves(branch, context.access):
            try:
                text, metadata, body = context.read(path)
            except (OSError, UnicodeError) as error:
                print(f"kt: skipped {path}: {error}", file=sys.stderr)
                continue
            relative = path.relative_to(root).as_posix()
            route = relative.removesuffix(".md").casefold()
            lower = body.casefold()
            head = "\n".join(body.splitlines()[:20]).casefold()
            score = sum(4 if t in route else 2 if t in head else 1 if t in lower else 0 for t in terms)
            if not score and not browse:
                continue
            if terms and all(t in route for t in terms):
                score += 8
            if terms and words(route) == terms:
                score += 20
            paragraphs = [" ".join(paragraph.split()) for paragraph in re.split(r"\n\s*\n", body) if paragraph.strip()]
            excerpt = max(paragraphs, key=lambda paragraph: sum(t in paragraph.casefold() for t in terms), default="")
            results.append((-score, precedence, relative, label, path, metadata, excerpt,
                            coverage(terms, route + "\n" + lower)))
    results.sort(key=lambda row: (not browse and row[-1] < args.min_coverage, *row[:3]))
    if not results:
        if not PRETTY:
            print("no_matches; retry synonyms/scoped paths; private roots excluded")
            return 1
        print(paint("No matches", "33") + f" for {' '.join(args.terms)!r}.")
        print("This is keyword search; a miss does not establish that the answer is absent.")
        print("Check alternate terms and permitted scoped paths. Private roots are excluded; use kt roots to inspect policies.")
        return 1
    adequate = browse or any(row[-1] >= args.min_coverage for row in results)
    shown = results[:args.limit]
    if not PRETTY:
        count = sum(row[-1] >= args.min_coverage for row in results) if not browse else len(results)
        branch = f" branch={args.branch}" if getattr(args, "branch", None) else ""
        print(f"{'leaves' if browse else 'matches'}={len(shown)}/{len(results)} adequate={count}{branch} coverage=lexical")
        for _, _, relative, label, _, metadata, excerpt, matched in shown:
            status = ("FALSIFIED:" + metadata["falsified_at"] if metadata.get("falsified_at")
                      else metadata.get("status") or ("reviewed:" + metadata["verified_at"]
                           if metadata.get("verified_at") else "unverified"))
            fields = [f"{label}:{relative}"]
            if terms:
                fields.append(f"coverage={matched:.0%}" + (" weak" if matched < args.min_coverage else ""))
            fields.append(status)
            if excerpt:
                fields.append(textwrap.shorten(excerpt, width=160, placeholder=" …"))
            print("\t".join(fields))
        return 0 if adequate else 1
    if not adequate:
        print(paint("No sufficiently good matches", "33") + "; weak suggestions follow.\n")
    shown = results[:args.limit]
    title = "leaves" if browse else "matches"
    query = f" · {' '.join(args.terms)}" if args.terms else ""
    print(paint(f"{len(shown)} of {len(results)} {title}", "1") + query + "\n")
    width = max(30, min(shutil.get_terminal_size((100, 24)).columns - 4, 116))
    for index, (negative_score, _, relative, label, path, metadata, excerpt, matched) in enumerate(shown, 1):
        print(f"{paint(str(index) + '.', '1')} {paint(label + ':' + relative, '36')}  {paint('score ' + str(-negative_score), '2')}")
        if terms:
            print(f"   keyword coverage {matched:.0%}" + (" · weak suggestion" if matched < args.min_coverage else ""))
        status = ("FALSIFIED " + metadata["falsified_at"] if metadata.get("falsified_at")
                  else metadata.get("status", "leaf reviewed " + metadata.get("verified_at", "unknown")))
        print("   " + paint(status, "31" if metadata.get("falsified_at") else "2"))
        if excerpt:
            print(textwrap.fill(excerpt, width=width, initial_indent="   ", subsequent_indent="   "))
        print()
    print("Read verbatim: kt open ROOT:<path> (local, global, or canonical root path)")
    print("Check relevant proofs before relying on claims; search scores are not confidence.")
    if not adequate:
        print("Check alternate terms and scoped paths; if no leaf exists, investigate and capture the answer.")
    return 0 if adequate else 1


QUESTION_STARTS = {"how", "where", "when", "what", "why", "who", "which", "does", "is"}


def question(arguments):
    parser = argparse.ArgumentParser(prog="kt", description="Walk question words, then search the nearest relevant branch.")
    parser.add_argument("--pretty", action="store_true", help="human-oriented layout")
    parser.add_argument("question", nargs="+")
    parser.add_argument("--limit", type=int, default=10)
    parser.add_argument("--min-coverage", type=float, default=0.6, help="minimum non-grammatical keyword coverage (default: 0.6)")
    args = parser.parse_args(arguments)
    if args.limit < 1:
        parser.error("--limit must be positive")
    if not 0 < args.min_coverage <= 1:
        parser.error("--min-coverage must be greater than zero and at most one")
    components = re.findall(r"[^\W_]+(?:-[^\W_]+)*|_", " ".join(args.question).casefold())
    if "_" in components[:-1]:
        parser.error("_ is a terminal branch-listing placeholder")
    browse = bool(components and components[-1] == "_")
    if browse:
        components.pop()
    context = LookupContext()
    available = context.access.allowed_roots()
    if not available:
        raise AccessRequired("kt: no accessible knowledge roots")
    # Try the full sentence path without scanning any directory contents.
    if components and not browse:
        for label, root in available:
            candidate = root.joinpath(*components).with_suffix(".md")
            if candidate.is_file() and not candidate.is_symlink() and candidate.resolve().is_relative_to(root) and context.access.allows(candidate):
                print(f"kt: exact {label}:{candidate.relative_to(root)}; check relevant proofs before reliance", file=sys.stderr)
                sys.stdout.write(candidate.read_text())
                return 0
    # Consume directories word by word. Stop at the first unmatched component.
    walked = []
    for label, root in available:
        branch = root
        consumed = 0
        for component in components:
            child = branch / component
            if not child.is_dir() or child.is_symlink():
                break
            branch = child
            consumed += 1
        walked.append((label, root, branch, consumed))
    depth = max((entry[3] for entry in walked), default=0)
    terms = words(" ".join(components[depth:]))
    # Exact branch listing needs no keyword hit; keyword searches widen only if
    # no candidate covers enough of the unmatched query to be worth presenting.
    while depth >= 0:
        branches = []
        for label, root, _, consumed in walked:
            if consumed >= depth:
                branches.append((label, root, root.joinpath(*components[:depth])))
        relevant = browse or not terms
        if not relevant:
            for _, _, branch in branches:
                for path in leaves(branch, context.access):
                    try:
                        _, _, body = context.read(path)
                    except (OSError, UnicodeError):
                        continue
                    haystack = path.relative_to(branch).as_posix().casefold() + "\n" + body.casefold()
                    # Transparent lexical coverage, not model confidence.
                    if coverage(terms, haystack) >= args.min_coverage:
                        relevant = True
                        break
                if relevant:
                    break
        if relevant or depth == 0:
            prefix = "/".join(components[:depth]) or "(whole roots)"
            if PRETTY:
                print(paint("Search branch", "1") + f": {prefix}\n")
            args.branch = prefix
            args.terms = terms
            return find(args, branches=branches, browse=browse or not terms, context=context)
        depth -= 1
        if PRETTY:
            print(f"kt: weak keyword coverage; widening to {'/'.join(components[:depth]) or 'whole roots'}", file=sys.stderr)
    return 1


# Leaf addressing, revisions, and maintenance operations.

def qualified_leaf(value):
    aliases = root_aliases()
    # Longest-prefix matching permits colons in external root directory names.
    qualifier = next((alias for alias in sorted(aliases, key=len, reverse=True)
                      if value.startswith(alias + ":")), None)
    return (aliases[qualifier], value[len(qualifier) + 1:]) if qualifier is not None else None



def resolve_leaf(value, writable=False):
    available = roots()
    qualified = qualified_leaf(value)
    if qualified is not None:
        root, relative = qualified
        require_root(root)
        available = [(root_identity(root), root)]
        if Path(relative).is_absolute():
            raise ValueError("leaf path must be relative to its selected root")
    elif not Path(value).expanduser().is_absolute() and ":" in value:
        raise ValueError("unknown root label")
    else:
        relative = value
    path = Path(value).expanduser()
    if qualified is None and path.is_absolute():
        if writable and any(p.is_symlink() for p in (path, *path.parents)):
            raise ValueError("cannot amend through a symlink")
        resolved = path.resolve()
        require_leaf_root(resolved)
        candidates = [resolved] if path.suffix == ".md" else []
    else:
        candidates = []
        for _, root in available:
            for suffix in ("", ".md"):
                raw = root / (relative + suffix)
                candidate = raw.resolve()
                owner = owning_root(candidate)
                if owner is not None:
                    require_root(owner[1], owner[0])
                if not candidate.is_relative_to(root) or candidate.suffix != ".md":
                    continue
                if writable and any(p.is_symlink() for p in (raw, *raw.parents)):
                    raise ValueError("cannot amend through a symlink")
                candidates.append(candidate)
    path = next((p for p in candidates if p.is_file()), None)
    if path is None:
        raise ValueError("no such leaf")
    if not leaf_allowed(path):
        raise AccessRequired("kt: leaf is inside a restricted registered root")
    return path


def open_leaf(value, with_revision=False):
    data = resolve_leaf(value).read_bytes()
    if with_revision:
        print(f"Revision: {revision(data)}", file=sys.stderr)
    sys.stdout.write(data.decode("utf-8"))
    return 0


def revision(data):
    return hashlib.sha256(data).hexdigest()


@dataclass(frozen=True)
class LeafSnapshot:
    data: bytes
    digest: str
    device: int
    inode: int


def snapshot_from_stream(stream):
    stream.seek(0)
    data = stream.read()
    stat = os.fstat(stream.fileno())
    return LeafSnapshot(data, revision(data), stat.st_dev, stat.st_ino)


def read_leaf_snapshot(path):
    with path.open("rb") as stream:
        return snapshot_from_stream(stream)


def check_leaf_snapshot(path, snapshot, stream=None, expected_revision=None, message="kt: leaf changed; source retained"):
    current = snapshot_from_stream(stream) if stream is not None else read_leaf_snapshot(path)
    stat = path.stat()
    identity = (snapshot.device, snapshot.inode)
    if current.digest != (expected_revision or snapshot.digest) or (current.device, current.inode) != identity or (stat.st_dev, stat.st_ino) != identity:
        raise RevisionConflict(message)


def proof_records(text):
    """Identify assertion-paragraph + fenced predicate, outside other fences."""
    lines = text.splitlines(keepends=True)
    records = []
    index = 0
    while index < len(lines):
        line = lines[index].rstrip("\r\n")
        if line.startswith("```"):
            index += 1
            while index < len(lines) and lines[index].strip() != "```":
                index += 1
        elif re.fullmatch(r"Proof:(?: \((?:verified|falsified) at [^)]+\))?", line):
            marker_index = index
            previous = index - 1
            while previous >= 0 and not lines[previous].strip():
                previous -= 1
            start = previous
            while start > 0 and lines[start - 1].strip():
                start -= 1
            opening = index + 1
            while opening < len(lines) and not lines[opening].strip():
                opening += 1
            if previous >= 0 and opening < len(lines) and lines[opening].strip() in ("```bash", "```sh", "```python", "```python3"):
                closing = opening + 1
                while closing < len(lines) and lines[closing].strip() != "```":
                    closing += 1
                if closing < len(lines):
                    identity = ("".join(lines[start:previous + 1]), "".join(lines[opening:closing + 1]))
                    records.append((index, identity, line))
                    index = closing
            if not records or records[-1][0] != marker_index:
                records.append((marker_index, None, line))
        index += 1
    return lines, records


def invalidate_review(text, original, source=None):
    match = re.match(r"\A---\r?\n(.*?)\r?\n---(?:\r?\n|$)", text, re.S)
    if text.startswith("---") and match is None:
        raise ValueError("unclosed front matter")
    header = match[1] if match else ""
    body = text[match.end():] if match else text
    nested = re.search(r"(?m)^metadata:\s*$", header) is not None
    indent = "  " if nested else ""
    # Remove old whole-leaf review fields, including indented block continuations.
    lines = header.splitlines()
    cleaned = []
    index = 0
    while index < len(lines):
        line = lines[index]
        field = re.match(r"^( *)(verified_at|verified_by|verification):", line)
        if field:
            width = len(field[1])
            index += 1
            while index < len(lines) and (not lines[index].strip() or len(lines[index]) - len(lines[index].lstrip()) > width):
                index += 1
            continue
        cleaned.append(line)
        index += 1
    header = "\n".join(cleaned)

    def set_field(key, value):
        nonlocal header
        entry = f"{indent}{key}: {json.dumps(value)}"
        pattern = rf"(?m)^{indent}{key}:.*$"
        if re.search(pattern, header):
            fields = header.splitlines()
            first = next(i for i, line in enumerate(fields) if re.match(pattern.removeprefix("(?m)"), line))
            end = first + 1
            while end < len(fields) and (not fields[end].strip() or len(fields[end])-len(fields[end].lstrip()) > len(indent)):
                end += 1
            fields[first:end] = [entry]
            header = "\n".join(fields)
        elif nested:
            header = re.sub(r"(?m)^metadata:\s*$", lambda _: "metadata:\n" + entry, header, count=1)
        else:
            header = header.rstrip() + ("\n" if header.strip() else "") + entry

    status, _ = leaf_parts(text)
    set_field("status", "unresolved" if status.get("status") == "unresolved" else "unverified")
    set_field("updated_at", datetime.now().astimezone().isoformat(timespec="seconds"))
    if source:
        set_field("source", source)
    # Do not let a submitted replacement silently clear sticky falsification.
    previous, _ = leaf_parts(original)
    if previous.get("falsified_at"):
        set_field("falsified_at", previous["falsified_at"])
    return "---\n" + header + "\n---\n\n" + body.lstrip("\r\n")


def print_rewrite_original(original, digest, *, unchanged=False):
    label = "unchanged current contents" if unchanged else "superseded contents; no longer current knowledge"
    print(f"--- BEGIN ORIGINAL ({label}; revision={digest}) ---")
    sys.stdout.write(original)
    if not original.endswith("\n"):
        sys.stdout.write("\n")
    print("--- END ORIGINAL ---")
    print("Check against the original content to see if any still-valid knowledge was lost; rewrite again to add it back if so.")


def amend(args):
    path = resolve_leaf(args.path, writable=True)
    if args.expect is not None and not re.fullmatch(r"[a-f0-9]{64}", args.expect):
        raise ValueError("--expect must be the SHA-256 revision from kt open --revision")
    if hasattr(args, "contents"):
        replacement = args.contents
    elif args.body_file == "-":
        if sys.stdin.isatty():
            raise ValueError("pipe the replacement text or use --body-file")
        replacement = sys.stdin.read(1048577)
    else:
        with Path(args.body_file).expanduser().open(encoding="utf-8") as stream:
            replacement = stream.read(1048577)
    if not replacement.strip() or "\x00" in replacement or len(replacement.encode()) > 1048576:
        raise ValueError("replacement must be nonempty UTF-8 text without NUL, at most 1 MiB")
    descriptor = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
    with os.fdopen(descriptor, "r+b") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        snapshot = snapshot_from_stream(stream)
        original_bytes = snapshot.data
        if args.expect is not None and snapshot.digest != args.expect:
            raise RevisionConflict("kt: leaf changed; reread with kt open --revision and merge before amending")
        original = original_bytes.decode("utf-8")
        if replacement == original and not args.source:
            print(f"Unchanged. Revision: {snapshot.digest}")
            if hasattr(args, "contents"):
                print_rewrite_original(original, snapshot.digest, unchanged=True)
            return 0
        _, old_records = proof_records(original)
        previous = {identity: marker for _, identity, marker in old_records if identity is not None}
        if getattr(args, "reset_proofs", False):
            previous = {}
        new_lines, new_records = proof_records(replacement)
        invalidated = 0
        for index, identity, _ in new_records:
            saved = previous.get(identity)
            ending = "\n" if new_lines[index].endswith("\n") else ""
            new_lines[index] = (saved or "Proof: (verified at _)") + ending
            if saved is None:
                invalidated += 1
        updated = invalidate_review("".join(new_lines), original, args.source)
        if args.dry_run:
            sys.stdout.writelines(difflib.unified_diff(original.splitlines(keepends=True), updated.splitlines(keepends=True), fromfile=str(path), tofile=str(path) + " (amended)"))
            print(f"Whole-leaf review invalidated; {invalidated} new/changed proofs need checking.", file=sys.stderr)
            return 0
        # Never replace the inode: installer-created SKILL.md hardlinks stay intact.
        # Recheck after preparing output to detect ordinary non-locking intervening edits.
        check_leaf_snapshot(path, snapshot, stream,
                            message="kt: leaf changed during amendment; reread and merge")
        stream.seek(0)
        stream.write(updated.encode("utf-8"))
        stream.truncate()
        stream.flush()
        os.fsync(stream.fileno())
    print(f"{'Rewritten' if hasattr(args, 'contents') else 'Amended'} {args.path}. Revision: {revision(updated.encode('utf-8'))}")
    print(f"Whole-leaf review invalidated; {invalidated} new/changed proofs need checking." if PRETTY
          else f"status={leaf_parts(updated)[0].get('status', 'unverified')} proofs_to_check={invalidated}")
    if hasattr(args, "contents"):
        print_rewrite_original(original, snapshot.digest)
    return 0



def destination_leaf(value):
    qualified = qualified_leaf(value)
    if qualified is not None:
        root, relative = qualified
        require_root(root)
        if Path(relative).is_absolute() or any(part in (".", "..") for part in relative.split("/")):
            raise ValueError("destination must stay inside its selected root")
        raw = root / relative
    elif Path(value).expanduser().is_absolute():
        raw = Path(value).expanduser().absolute()
    else:
        if ":" in value or any(part in (".", "..") for part in value.split("/")):
            raise ValueError("invalid destination leaf")
        available = roots()
        if not available:
            raise AccessRequired("kt: no accessible destination root")
        raw = available[0][1] / value
    path = raw.resolve()
    name, root = require_leaf_root(path)
    if path.suffix != ".md" or "_" in path.relative_to(root).as_posix():
        raise ValueError("destination must be a sentence-derived Markdown leaf without underscores")
    if any(part.is_symlink() for part in (raw, *raw.parents)):
        raise ValueError("cannot move through a symlink")
    return path


def leaf_address(path):
    name, root = require_leaf_root(path)
    return f"{name}:{path.relative_to(root)}"


def relocate_leaf(args):
    path = resolve_leaf(args.path, writable=True)
    if not re.fullmatch(r"[0-9a-fA-F]{64}", args.expect):
        raise ValueError("--expect must be a SHA-256 revision from kt open --revision")
    destination = destination_leaf(args.destination) if args.command == "mv" else None
    with path.open("rb") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        snapshot = snapshot_from_stream(stream)
        data = snapshot.data
        if snapshot.digest != args.expect.lower():
            raise RevisionConflict("kt: revision mismatch; reread before removing or moving")
        if destination is not None and destination == path:
            print(f"Unchanged {leaf_address(path)}")
            return 0
        if destination is not None and (destination.exists() or destination.is_symlink()):
            raise ValueError("destination already exists; no files changed")
        source = leaf_address(path)
        target = leaf_address(destination) if destination else None
        if args.dry_run:
            print(f"Would move {source} -> {target}" if destination else f"Would remove {source}")
            return 0
        check_leaf_snapshot(path, snapshot, stream)
        if destination is not None:
            destination.parent.mkdir(parents=True, exist_ok=True)
            try:
                os.link(path, destination, follow_symlinks=False)
            except OSError as error:
                if error.errno != errno.EXDEV:  # Copy exclusively across filesystems.
                    raise
                with destination.open("xb") as output:
                    output.write(data)
                    output.flush()
                    os.fsync(output.fileno())
                shutil.copystat(path, destination, follow_symlinks=False)
            check_leaf_snapshot(path, snapshot, stream,
                                message="kt: source changed; source retained and destination created; inspect both")
        path.unlink()
    print(f"Moved {source} -> {target} review=scope,links,proofs" if destination
          else f"Removed {source} review=links,orientation")
    return 0


def combine_leaves(args):
    destination = destination_leaf(args.output)
    sources = [resolve_leaf(value, writable=True) for value in args.paths]
    bodies, provenance, falsified, unresolved = [], [], None, False
    snapshots, blockers, next_checks = {}, [], []
    for source in sources:
        snapshot = read_leaf_snapshot(source)
        data = snapshot.data
        snapshots[source] = snapshot
        metadata, body = leaf_parts(data.decode("utf-8"))
        # Verification happened in a source scope, not in the combined answer.
        lines, records = proof_records(body)
        for index, _, _ in records:
            lines[index] = "Proof: (verified at _)" + ("\n" if lines[index].endswith("\n") else "")
        body = "".join(lines)
        bodies.append(body.strip("\r\n"))
        provenance.append(f"{leaf_address(source)} revision={revision(data)}")
        falsified = falsified or metadata.get("falsified_at")
        unresolved = unresolved or metadata.get("status") == "unresolved"
        if metadata.get("blocker"):
            blockers.append(metadata["blocker"])
        if metadata.get("next_check"):
            next_checks.append(metadata["next_check"])
    # Abort before saving if any input changed while preparing the answer.
    for source, snapshot in snapshots.items():
        check_leaf_snapshot(source, snapshot,
                            message="kt: combine input changed; no output saved; reread inputs")
    now = datetime.now().astimezone().isoformat(timespec="seconds")
    metadata = {"status": "unresolved" if unresolved else "unverified", "updated_at": now, "scope": root_identity(require_leaf_root(destination)[1]),
        "source": "Combined in input order: " + "; ".join(provenance)}
    if falsified:
        metadata["falsified_at"] = falsified
    if unresolved:
        metadata.update(blocker="; ".join(blockers) or "One or more input leaves are unresolved.",
                        next_check="; ".join(next_checks) or "Establish the unresolved combined answer before validation.")
    content = "---\n" + "".join(f"{key}: {json.dumps(value, ensure_ascii=False)}\n" for key, value in metadata.items())
    content += "---\n\n" + "\n\n".join(bodies) + "\n"
    if destination.exists():
        if not args.expect:
            raise ValueError("existing destination requires --expect from kt open --revision")
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", suffix=".md") as body_file:
            body_file.write(content)
            body_file.flush()
            amend(argparse.Namespace(path=str(destination), expect=args.expect,
                body_file=body_file.name, source=metadata["source"], dry_run=args.dry_run, reset_proofs=True))
        if args.dry_run:
            print("Would remove source leaves except the destination.", file=sys.stderr)
            return 0
    else:
        if args.expect:
            raise RevisionConflict("kt: expected destination does not exist")
        if args.dry_run:
            print(f"Would coalesce {len(sources)} leaves -> {leaf_address(destination)} and remove sources", file=sys.stderr)
            sys.stdout.write(content)
            return 0
        destination.parent.mkdir(parents=True, exist_ok=True)
        with destination.open("x", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
    destination_revision = revision(destination.read_bytes())
    removed = 0
    for source, snapshot in snapshots.items():
        if source == destination:
            continue
        # Saving in place changes input hardlink aliases to the destination too.
        expected_revision = destination_revision if source.samefile(destination) else snapshot.digest
        resolve_leaf(str(source), writable=True)
        with source.open("rb") as stream:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
            check_leaf_snapshot(source, snapshot, stream, expected_revision,
                                message="kt: input changed; combined destination saved, changed source retained; inspect both")
            source.unlink()
        removed += 1
    print(f"Combined {len(sources)} leaves -> {leaf_address(destination)} removed={removed} status={leaf_parts(destination.read_text())[0].get('status', 'unverified')} review=links,scope,proofs")
    return 0



def capture(args):
    """Create only: existing owners (including hardlinked skills) are never replaced."""
    if any(c in args.question for c in ("/", "\\", "_")) or any(
            ord(c) < 32 for c in args.question):
        raise ValueError("supply a natural-language question; use hyphens, not slashes or underscores")
    components = re.findall(r"[^\W_]+(?:-[^\W_]+)*", args.question.casefold())
    if not components:
        raise ValueError("question must contain words")
    available = roots()
    if args.root:
        root = root_aliases().get(args.root, Path(args.root).expanduser().absolute())
        label = root_identity(root)
    elif args.project or args.global_root:
        label = "local" if args.project else "global"
        root = root_aliases().get(label)
        if root is None:
            raise ValueError("no project knowledge root; establish one or select --root")
    else:
        if not available:
            raise AccessRequired("kt: no accessible knowledge root for capture")
        label, root = available[0]
    if not args.dry_run and root.is_dir() and not any(isinstance(spec.get("path"), str) and Path(spec["path"]).expanduser().resolve() == root.resolve() for spec in access_config()["roots"].values()):
        register_root(root)
    require_root(root)
    if not root.is_dir():
        raise ValueError(f"knowledge root does not exist: {root}")
    # Reject symlink roots/ancestors before any directory or file mutation.
    for ancestor in (root, *root.parents):
        if ancestor.is_symlink():
            raise ValueError(f"symlink in capture root: {ancestor}")
    path = root.joinpath(*components).with_suffix(".md")
    require_leaf_root(path)
    for ancestor in path.relative_to(root).parents:
        if (root / ancestor).is_symlink():
            raise ValueError("symlink in leaf path")
    if path.exists() or path.is_symlink():
        raise ValueError(f"leaf already exists: {path}; use kt rewrite and review its returned original contents")
    if args.answer == "-":
        if sys.stdin.isatty():
            raise ValueError("pipe the answer on stdin when using -")
        answer = sys.stdin.read()
    else:
        answer = args.answer
    if not answer.strip():
        raise ValueError("answer must not be empty")
    if re.match(r"\A\s*---\s*\n", answer):
        raise ValueError("supply the Markdown body, not a second frontmatter block")
    if args.unresolved and (not args.blocker or not args.next_check):
        raise ValueError("--unresolved requires --blocker and --next-check")
    if not args.unresolved and (args.blocker or args.next_check):
        raise ValueError("--blocker and --next-check require --unresolved")
    now = datetime.now().astimezone().isoformat(timespec="seconds")
    metadata = {"status": "unresolved" if args.unresolved else "unverified",
                "created_at": now, "scope": args.scope or root_identity(root),
                "source": args.source or "caller-supplied answer; evidence not recorded"}
    if args.unresolved:
        metadata.update(checked_at=now, blocker=args.blocker, next_check=args.next_check)
    content = "---\n" + "".join(f"{k}: {json.dumps(v, ensure_ascii=False)}\n"
                                 for k, v in metadata.items()) + "---\n\n" + answer.rstrip() + "\n"
    if args.dry_run:
        print(f"Would create {label}:{path.relative_to(root)}", file=sys.stderr)
        sys.stdout.write(content)
        return 0
    path.parent.mkdir(parents=True, exist_ok=True)
    # Exclusive creation protects an existing leaf even if it appeared after preflight.
    with path.open("x", encoding="utf-8") as handle:
        handle.write(content)
    print(paint("Created", "32") + f" {label}:{path.relative_to(root)}" +
          ("" if PRETTY else f" status={metadata['status']}"))
    if PRETTY:
        print(f"  {path}")
        print("  Unresolved record saved." if args.unresolved else
              "  Unverified: independently review the leaf; check eligible proofs before reliance.")
    return 0


# Built-in proof parsing, execution, and outcome stamping.

PROOF_FENCES = {
    "```bash": "bash",
    "```sh": "sh",
    "```python": "python3",
    "```python3": "python3",
}
OUTPUT_LIMIT = 4096
PROOF_MARKER = re.compile(r"^Proof:(?: \((verified|falsified) at ([^)]+)\))?$")


def discover_knowledge_root(directory):
    if directory.name == ".knowledge" and directory.is_dir():
        return directory
    knowledge = directory / ".knowledge"
    if knowledge.is_dir():
        return knowledge
    raise FileNotFoundError(
        f"working directory is not a knowledge root and contains no .knowledge: {directory}")


def semantic_components(relative):
    return tuple(part.casefold() for part in (*relative.parts[:-1], relative.stem))


def validate_tokens(tokens, parser):
    normalized = []
    for token in tokens:
        if not token or token in {".", ".."} or "/" in token or "\\" in token:
            parser.error(f"semantic token must be one path component: {token!r}")
        normalized.append(token.casefold())
    return tuple(normalized)


def path_matches(relative, tokens):
    components = semantic_components(relative)
    return not tokens or any(token in components for token in tokens)


def tree_files(root):
    leaves = []
    other_files = []
    for directory, names, files in os.walk(root):
        base = Path(directory)
        ignored = {".git"}
        if base == root and root == Path.home() / ".knowledge":
            ignored.add(".tools")
        names[:] = sorted(name for name in names if name not in ignored)
        for name in sorted(files):
            path = base / name
            relative = path.relative_to(root)
            if path.suffix == ".md":
                leaves.append((relative, path))
            else:
                other_files.append(relative)
    return leaves, other_files


def previous_content_line(lines, index):
    candidate = index - 1
    while candidate >= 0 and not lines[candidate].strip():
        candidate -= 1
    return candidate


def next_content_line(lines, index):
    candidate = index + 1
    while candidate < len(lines) and not lines[candidate].strip():
        candidate += 1
    return candidate


def closing_fence(lines, index):
    candidate = index + 1
    while candidate < len(lines):
        if lines[candidate] == "```":
            return candidate
        candidate += 1
    return None


def parse_proofs(path):
    original = path.read_text()
    lines = original.splitlines()
    proofs = []
    errors = []
    index = 0
    while index < len(lines):
        line = lines[index]
        if line.startswith("```"):
            closing = closing_fence(lines, index)
            if closing is None:
                errors.append((index + 1, "unclosed fenced block"))
                break
            index = closing + 1
            continue
        marker = PROOF_MARKER.fullmatch(line)
        if marker is None:
            if line.startswith("Proof:"):
                errors.append((index + 1, "malformed proof verification marker"))
            index += 1
            continue
        stamp = marker.group(2)
        if stamp not in (None, "_"):
            try:
                parsed = datetime.fromisoformat(stamp)
                if parsed.utcoffset() is None:
                    raise ValueError("timezone required")
            except ValueError:
                errors.append((index + 1, "proof timestamp must be ISO 8601 with timezone"))

        previous = previous_content_line(lines, index)
        if previous < 0 or lines[previous].startswith("```"):
            errors.append((index + 1, "Proof: lacks a preceding assertion"))

        fence = next_content_line(lines, index)
        if fence >= len(lines) or lines[fence] not in PROOF_FENCES:
            errors.append((index + 1, "Proof: lacks a supported executable fence"))
            index += 1
            continue

        closing = closing_fence(lines, fence)
        if closing is None:
            errors.append((fence + 1, "unclosed proof fence"))
            break
        script = "\n".join(lines[fence + 1:closing])
        if not script.strip():
            errors.append((fence + 1, "proof script is empty"))
        else:
            proofs.append((index, fence + 1, PROOF_FENCES[lines[fence]], script))
        index = closing + 1
    return original, proofs, errors


def stamp_proofs(path, original, markers, falsified):
    lines = original.splitlines(keepends=True)
    timestamp = datetime.now().astimezone().isoformat(timespec="seconds")
    for index, passed in markers:
        ending = "\r\n" if lines[index].endswith("\r\n") else "\n" if lines[index].endswith("\n") else ""
        status = "verified" if passed else "falsified"
        lines[index] = f"Proof: ({status} at {timestamp}){ending}"
    updated = "".join(lines)
    if falsified:
        updated = falsify_leaf(updated, timestamp)
    # Write through existing links: atomic replacement would detach hardlinks.
    with path.open("r+") as stream:
        if stream.read() != original:
            raise OSError("leaf changed during verification; refusing to overwrite")
        stream.seek(0)
        stream.write(updated)
        stream.truncate()


def falsify_leaf(text, timestamp):
    if not text.startswith("---\n"):
        return f"---\nfalsified_at: '{timestamp}'\n---\n\n{text}"
    finish = text.find("\n---", 4)
    if finish == -1:
        raise OSError("cannot mark falsification: unclosed metadata front matter")
    header = text[4:finish]
    nested = re.search(r"(?m)^metadata:\s*$", header) is not None
    indent = "  " if nested else ""
    field = re.compile(rf"(?m)^{indent}falsified_at:.*$")
    value = f"{indent}falsified_at: '{timestamp}'"
    if field.search(header):
        header = field.sub(value, header)
    elif nested:
        header = re.sub(r"(?m)^metadata:\s*$", f"metadata:\n{value}", header, count=1)
    else:
        header += "\n" + value
    return "---\n" + header + text[finish:]


def clipped(value):
    if isinstance(value, bytes):
        value = value.decode(errors="replace")
    value = value.strip()
    if len(value) <= OUTPUT_LIMIT:
        return value
    return value[:OUTPUT_LIMIT] + "\n... output truncated"


def run_proof(command, script, directory, timeout):
    argv = [command, "-c", script]
    if command == "bash":
        argv = ["bash", "-euo", "pipefail", "-c", script]
    elif command == "sh":
        argv = ["sh", "-eu", "-c", script]
    try:
        result = subprocess.run(
            argv,
            cwd=directory,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        return False, f"timed out after {timeout:g}s", error.stdout or "", error.stderr or ""
    except OSError as error:
        return False, f"could not execute proof: {error}", "", ""
    return result.returncode == 0, f"exit {result.returncode}", result.stdout, result.stderr


def positive_timeout(value):
    timeout = float(value)
    if timeout <= 0:
        raise argparse.ArgumentTypeError("timeout must be positive")
    return timeout


def proof_parser_for_cli():
    parser = argparse.ArgumentParser(prog="kt prove", description="Run marked proofs in a knowledge tree, optionally filtered by tokens.")
    parser.add_argument(
        "tokens",
        nargs="*",
        metavar="TOKEN",
        help="select leaves matching any exact semantic path component",
    )
    parser.add_argument(
        "-r", "--root",
        type=Path,
        help="knowledge root to check instead of discovering one from the working directory",
    )
    parser.add_argument(
        "--timeout",
        type=positive_timeout,
        default=10.0,
        help="maximum seconds for each proof (default: 10)",
    )
    parser.add_argument(
        "--no-stamp",
        action="store_true",
        help="check without writing proof timestamps or leaf falsification metadata",
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="print selected leaves, proof results, errors, and summary",
    )
    return parser


def verify_proofs(arguments=None):
    parser = proof_parser_for_cli()
    args = parser.parse_args(arguments)
    tokens = validate_tokens(args.tokens, parser)
    directory = Path.cwd().resolve()
    if args.root is not None:
        root = args.root.expanduser().resolve()
        if not root.is_dir():
            if args.verbose:
                print(f"ERROR knowledge root is not a directory: {root}", file=sys.stderr)
            return 1
    else:
        try:
            root = discover_knowledge_root(directory)
        except FileNotFoundError as error:
            if args.verbose:
                print(f"ERROR {error}", file=sys.stderr)
            return 1

    # Keep the execution engine guarded against forced-private roots as well.
    if root_access(root) == "force-private" or any(
            other != root and other.is_relative_to(root) and root_access(other, label) == "force-private"
            for label, other in discovered_roots()):
        raise AccessRequired("kt: requested proof scope is unavailable")
    leaves, other_files = tree_files(root)
    selected = [(relative, path) for relative, path in leaves
                if path_matches(relative, tokens)]
    selected_other = [relative for relative in other_files
                      if path_matches(relative, tokens)]
    failed = 0
    failed_paths = set()
    proof_count = 0
    for relative in selected_other:
        failed += 1
        failed_paths.add(relative)
        if args.verbose:
            print(f"ERROR {relative}: non-Markdown file inside knowledge tree")

    proof_directory = root.parent
    for relative, path in selected:
        original, proofs, errors = parse_proofs(path)
        results = []
        leaf_falsified = bool(errors)
        header = original.split("\n---", 1)[0] if original.startswith("---\n") else ""
        if re.search(r"(?m)^\s{0,2}falsified_at:", header):
            failed += 1
            failed_paths.add(relative)
            if args.verbose:
                print("  ERROR leaf remains falsified pending independent review")
        if args.verbose:
            print(f"LEAF {relative} proofs={len(proofs)}")
        for line, message in errors:
            failed += 1
            failed_paths.add(relative)
            if args.verbose:
                print(f"  ERROR line={line} {message}")
        for marker, line, command, script in proofs:
            proof_count += 1
            passed, detail, stdout, stderr = run_proof(
                command, script, proof_directory, args.timeout)
            results.append((marker, passed))
            if passed:
                if args.verbose:
                    print(f"  PASS line={line} language={command}")
                continue
            failed += 1
            leaf_falsified = True
            failed_paths.add(relative)
            if args.verbose:
                print(f"  FAIL line={line} language={command} {detail}")
                for label, output in (("stdout", stdout), ("stderr", stderr)):
                    output = clipped(output)
                    if output:
                        print(f"    {label}: {output}")
        if (results or leaf_falsified) and not args.no_stamp:
            try:
                stamp_proofs(path, original, [] if errors else results, leaf_falsified)
            except OSError as error:
                failed += 1
                failed_paths.add(relative)
                if args.verbose:
                    print(f"  ERROR stamping proofs: {error}")

    if args.verbose:
        print(
            f"SUMMARY root={root} leaves={len(selected)} proofs={proof_count} "
            f"failures={failed}")
    if failed:
        for relative in sorted(failed_paths, key=str):
            print(relative, file=sys.stderr)
    return 1 if failed else 0


def prove(arguments):
    arguments = list(arguments)
    if "--help" in arguments or "-h" in arguments:
        return verify_proofs(arguments)
    if arguments and not arguments[0].startswith("-") and Path(arguments[0]).expanduser().is_dir():
        root = Path(arguments.pop(0)).expanduser().resolve()
        if root.name != ".knowledge" and (root / ".knowledge").is_dir():
            root /= ".knowledge"
        arguments = ["--root", str(root), *arguments]
    elif not any(a in ("--root", "-r") or a.startswith("--root=") for a in arguments):
        allowed = roots()
        if not allowed:
            raise AccessRequired("kt: no accessible proof root")
        arguments = ["--root", str(allowed[0][1]), *arguments]
    selected = None
    for index, argument in enumerate(arguments):
        if argument in ("--root", "-r") and index + 1 < len(arguments):
            selected = arguments[index + 1]
        elif argument.startswith("--root="):
            selected = argument.partition("=")[2]
    if selected is None:
        raise AccessRequired("kt: select an accessible proof root")
    selected = Path(selected).expanduser().resolve()
    require_root(selected, next((label for label, root in discovered_roots() if root == selected), None))
    if any(root != selected and root.is_relative_to(selected) and root_access(root, label) != "allow" for label, root in discovered_roots()):
        raise AccessRequired("kt: proof scope contains a restricted registered subtree; narrow the scope or approve it first")
    return verify_proofs(arguments)


# CLI argument schema and command dispatch.

def open_command(args):
    return open_leaf(args.path, args.revision)


def register_command(args):
    register_root(args.path, args.name)
    root = Path(args.path).expanduser().resolve()
    print("Registered." if root_access(root) == "force-private"
          else f"Registered {root_identity(root)}.")
    return 0


def roots_command(args):
    for label, root in discovered_roots():
        policy = root_access(root, label)
        if policy == "force-private":
            continue
        if PRETTY:
            print(f"[{policy}] {paint(label.ljust(7), '36')}  {root if policy == 'allow' else '(restricted)'}")
        else:
            print(f"{label}\t{policy}\t{root if policy == 'allow' else '(restricted)'}")
    if args.command is None:
        allowed = roots()
        entry = allowed[0][1] / "where/am/i.md" if allowed else None
        if entry is not None and entry.is_file():
            _, body = leaf_parts(entry.read_text())
            if PRETTY:
                print("\n" + paint("Orientation", "1"))
                print(textwrap.shorten(" ".join(body.split()), width=600, placeholder=" …"))
            else:
                print("orientation=" + textwrap.shorten(" ".join(body.split()), width=240, placeholder=" …"))
        if not PRETTY:
            print("commands: find | QUESTION | open | add | rewrite | amend (deprecated) | rm | mv | combine | prove | roots | register | access | permissions; --help; --pretty")
            return 0
        print("\nkt find leaves                     ranked keyword lookup")
        print("kt where is vivado                 exact answer or nearby matches")
        print("kt how to _                        list a question branch")
        print('kt find "how to add knowledge leaves"')
        print("kt open global:how/to/add/knowledge/leaves.md")
        print("kt prove [directory] [tokens] [--no-stamp]")
        print('kt add "how to do the thing" "The answer." --source "checked evidence"')
    return 0


def command_parser():
    parser = argparse.ArgumentParser(description=__doc__, epilog="Questions: kt where is vivado; kt how to _ (list a branch). Interface guide: kt open global:how/to/use/kt.md. --root is command-specific, not a global option.")
    parser.set_defaults(handler=roots_command)
    parser.add_argument("--pretty", action="store_true", help="human-oriented layout and terminal colors (default: compact plain text)")
    parser.add_argument("--dangerously-skip-permissions", action="store_true", help="persistently bypass ask/deny after user confirmation; force-private remains enforced")
    commands = parser.add_subparsers(dest="command")
    search = commands.add_parser("find", help="rank keyword matches across project and global roots", description="Search all permitted active roots. No --root option; open the root-qualified address returned by the search.")
    search.set_defaults(handler=find)
    search.add_argument("--pretty", action="store_true", help="human-oriented layout")
    search.add_argument("terms", nargs="+", help="words or a quoted question")
    search.add_argument("--limit", type=int, default=10)
    search.add_argument("--min-coverage", type=float, default=0.6)
    opening = commands.add_parser("open", help="print a leaf verbatim, including metadata")
    opening.set_defaults(handler=open_command)
    opening.add_argument("path", help="local:path, global:path, ROOT:path (registered root), or absolute .md path; project: aliases local:")
    opening.add_argument("--revision", action="store_true", help="print SHA-256 revision on stderr; stdout stays verbatim")
    amending = commands.add_parser("amend", help="deprecated: use rewrite; retained for existing workers", description="Deprecated in favor of kt rewrite. Retained with unchanged syntax and behavior for existing workers.")
    amending.set_defaults(handler=amend)
    amending.add_argument("path")
    amending.add_argument("--expect", required=True, help="SHA-256 revision returned by open --revision")
    amending.add_argument("--body-file", default="-", help="complete replacement Markdown file, or - for stdin")
    amending.add_argument("--source", help="actual evidence for the revised answer")
    amending.add_argument("--dry-run", action="store_true", help="show the resulting diff without writing")
    replacing = commands.add_parser("rewrite", help="rewrite a leaf with inline Markdown and return its previous contents")
    replacing.set_defaults(handler=amend)
    replacing.add_argument("path", help="existing leaf address")
    replacing.add_argument("contents", help="complete replacement Markdown; use -- before positional arguments beginning with -")
    replacing.add_argument("--expect", help="optional SHA-256 revision from open --revision; rejects stale context")
    replacing.add_argument("--source", help="actual evidence for the revised answer")
    replacing.add_argument("--dry-run", action="store_true", help="show the resulting diff without writing")
    for name in ("rm", "mv"):
        maintenance = commands.add_parser(name, help="remove a leaf" if name == "rm" else "move a leaf without overwriting")
        maintenance.set_defaults(handler=relocate_leaf)
        maintenance.add_argument("path", help="source leaf address")
        if name == "mv":
            maintenance.add_argument("destination", help="destination Markdown leaf address")
        maintenance.add_argument("--expect", required=True, help="source SHA-256 from kt open --revision")
        maintenance.add_argument("--dry-run", action="store_true")
    combining = commands.add_parser("combine", help="combine ordered Markdown bodies into one leaf")
    combining.set_defaults(handler=combine_leaves)
    combining.add_argument("paths", nargs="+", help="source leaf addresses in order")
    combining.add_argument("-o", "--output", required=True, help="destination Markdown leaf address")
    combining.add_argument("--expect", help="destination SHA-256 required when replacing an existing leaf")
    combining.add_argument("--dry-run", action="store_true")
    adding = commands.add_parser("capture", aliases=["add"], help="create a question-derived leaf in one call")
    adding.set_defaults(handler=capture)
    adding.add_argument("question", help="quoted full question; preserve multi-word components with hyphens")
    adding.add_argument("answer", help="Markdown answer, or - to read stdin")
    scope = adding.add_mutually_exclusive_group()
    scope.add_argument("--global", dest="global_root", action="store_true")
    scope.add_argument("--local", "--project", dest="project", action="store_true")
    scope.add_argument("--root", help="existing knowledge root (for example, example/)")
    adding.add_argument("--scope", help="scope description; defaults to the selected root category")
    adding.add_argument("--source", help="actual evidence/provenance supplied by the caller")
    adding.add_argument("--dry-run", action="store_true", help="preview path and complete leaf without writing")
    adding.add_argument("--unresolved", action="store_true")
    adding.add_argument("--blocker")
    adding.add_argument("--next-check")
    commands.add_parser("roots", help="show root policies without reading their contents")
    register = commands.add_parser("register", help="register an existing root as private (ask)")
    register.set_defaults(handler=register_command)
    register.add_argument("name")
    register.add_argument("path")
    access = commands.add_parser("access", help="inspect, approve, deny, or revoke root access")
    access.set_defaults(handler=access_command)
    access.add_argument("root", help="root label or absolute root path")
    access.add_argument("decision", nargs="?", choices=["allow", "deny", "ask", "force-private", "reset"])
    access.add_argument("--scope", choices=["session", "project", "all"], default="project")
    access.add_argument("--subdirectories", action="store_true", help="explicitly extend a project approval to descendant directories")
    permissions = commands.add_parser("permissions", help="inspect or persist user permission bypass")
    permissions.set_defaults(handler=permissions_command)
    settings = permissions.add_mutually_exclusive_group()
    settings.add_argument("--dangerously-skip-permissions", action="store_true")
    settings.add_argument("--reset", action="store_true")
    commands.add_parser("prove", help="check marked proofs: [directory] [tokens] [options]")
    return parser


def main():
    global PRETTY
    arguments = sys.argv[1:]
    # Allow --pretty before the command or among its options, respecting --.
    boundary = arguments.index("--") if "--" in arguments else len(arguments)
    PRETTY = "--pretty" in arguments[:boundary]
    arguments = [arg for arg in arguments[:boundary] if arg != "--pretty"] + arguments[boundary:]
    if arguments and arguments[0] == "prove":
        return prove(arguments[1:])
    if arguments and arguments[0].split() and arguments[0].split()[0].casefold() in QUESTION_STARTS:
        return question(arguments)
    parser = command_parser()
    args = parser.parse_args(arguments)
    if args.command != "permissions" and args.dangerously_skip_permissions:
        code = permissions_command(argparse.Namespace(dangerously_skip_permissions=True, reset=False))
        if code or args.command is None:
            return code
    if args.command == "find":
        if args.limit < 1:
            parser.error("--limit must be positive")
        if not 0 < args.min_coverage <= 1:
            parser.error("--min-coverage must be greater than zero and at most one")
    return args.handler(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
    except RevisionConflict as error:
        print(error, file=sys.stderr)
        sys.exit(4)
    except AccessRequired as error:
        print(error, file=sys.stderr)
        sys.exit(3)
    except (OSError, UnicodeError, ValueError, sqlite3.Error) as error:
        print(f"kt: {error}", file=sys.stderr)
        sys.exit(2)
