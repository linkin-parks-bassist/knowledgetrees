#!/usr/bin/env python3
"""Compatibility entry point for the proof engine built into kt.

Retains the legacy standalone root selection; kt prove additionally enforces
root access policies. New integrations should use kt prove.
"""
from pathlib import Path
import runpy
import sys

if __name__ == "__main__":
    engine = runpy.run_path(str(Path(__file__).resolve().with_name("kt")))
    try:
        raise SystemExit(engine["verify_proofs"](sys.argv[1:]))
    except engine["AccessRequired"] as error:
        print(error, file=sys.stderr)
        raise SystemExit(3)
