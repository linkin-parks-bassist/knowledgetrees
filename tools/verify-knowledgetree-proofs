#!/usr/bin/env python3
"""Run marked proofs in a knowledge tree, optionally filtered by tokens."""

import argparse
import os
from pathlib import Path
import subprocess
import sys


PROOF_FENCES = {
    "```bash": "bash",
    "```sh": "sh",
    "```python": "python3",
    "```python3": "python3",
}
OUTPUT_LIMIT = 4096


def discover_knowledge_root(directory):
    if directory.name == ".knowledge" and directory.is_dir():
        return directory
    knowledge = directory / ".knowledge"
    if knowledge.is_dir():
        return knowledge
    raise FileNotFoundError(
        f"working directory is not a knowledge root and contains no .knowledge: {directory}")


def semantic_components(relative):
    return tuple(part.casefold() for part in (*relative.parts[:-1], relative.stem))


def validate_tokens(tokens, parser):
    normalized = []
    for token in tokens:
        if not token or token in {".", ".."} or "/" in token or "\\" in token:
            parser.error(f"semantic token must be one path component: {token!r}")
        normalized.append(token.casefold())
    return tuple(normalized)


def path_matches(relative, tokens):
    components = semantic_components(relative)
    return not tokens or any(token in components for token in tokens)


def tree_files(root):
    leaves = []
    other_files = []
    for directory, names, files in os.walk(root):
        base = Path(directory)
        ignored = {".git"}
        if base == root and root == Path.home() / ".knowledge":
            ignored.add(".tools")
        names[:] = sorted(name for name in names if name not in ignored)
        for name in sorted(files):
            path = base / name
            relative = path.relative_to(root)
            if path.suffix == ".md":
                leaves.append((relative, path))
            else:
                other_files.append(relative)
    return leaves, other_files


def previous_content_line(lines, index):
    candidate = index - 1
    while candidate >= 0 and not lines[candidate].strip():
        candidate -= 1
    return candidate


def next_content_line(lines, index):
    candidate = index + 1
    while candidate < len(lines) and not lines[candidate].strip():
        candidate += 1
    return candidate


def closing_fence(lines, index):
    candidate = index + 1
    while candidate < len(lines):
        if lines[candidate] == "```":
            return candidate
        candidate += 1
    return None


def parse_proofs(path):
    lines = path.read_text().splitlines()
    proofs = []
    errors = []
    index = 0
    while index < len(lines):
        line = lines[index]
        if line.startswith("```"):
            closing = closing_fence(lines, index)
            if closing is None:
                errors.append((index + 1, "unclosed fenced block"))
                break
            index = closing + 1
            continue
        if line != "Proof:":
            index += 1
            continue

        previous = previous_content_line(lines, index)
        if previous < 0 or lines[previous].startswith("```"):
            errors.append((index + 1, "Proof: lacks a preceding assertion"))

        fence = next_content_line(lines, index)
        if fence >= len(lines) or lines[fence] not in PROOF_FENCES:
            errors.append((index + 1, "Proof: lacks a supported executable fence"))
            index += 1
            continue

        closing = closing_fence(lines, fence)
        if closing is None:
            errors.append((fence + 1, "unclosed proof fence"))
            break
        script = "\n".join(lines[fence + 1:closing])
        if not script.strip():
            errors.append((fence + 1, "proof script is empty"))
        else:
            proofs.append((fence + 1, PROOF_FENCES[lines[fence]], script))
        index = closing + 1
    return proofs, errors


def clipped(value):
    if isinstance(value, bytes):
        value = value.decode(errors="replace")
    value = value.strip()
    if len(value) <= OUTPUT_LIMIT:
        return value
    return value[:OUTPUT_LIMIT] + "\n... output truncated"


def run_proof(command, script, directory, timeout):
    argv = [command, "-c", script]
    if command == "bash":
        argv = ["bash", "-euo", "pipefail", "-c", script]
    elif command == "sh":
        argv = ["sh", "-eu", "-c", script]
    try:
        result = subprocess.run(
            argv,
            cwd=directory,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        return False, f"timed out after {timeout:g}s", error.stdout or "", error.stderr or ""
    return result.returncode == 0, f"exit {result.returncode}", result.stdout, result.stderr


def positive_timeout(value):
    timeout = float(value)
    if timeout <= 0:
        raise argparse.ArgumentTypeError("timeout must be positive")
    return timeout


def parser_for_cli():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "tokens",
        nargs="*",
        metavar="TOKEN",
        help="select leaves matching any exact semantic path component",
    )
    parser.add_argument(
        "-r", "--root",
        type=Path,
        help="knowledge root to check instead of discovering one from the working directory",
    )
    parser.add_argument(
        "--timeout",
        type=positive_timeout,
        default=10.0,
        help="maximum seconds for each proof (default: 10)",
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="print selected leaves, proof results, errors, and summary",
    )
    return parser


def main(arguments=None):
    parser = parser_for_cli()
    args = parser.parse_args(arguments)
    tokens = validate_tokens(args.tokens, parser)
    directory = Path.cwd().resolve()
    if args.root is not None:
        root = args.root.expanduser().resolve()
        if not root.is_dir():
            if args.verbose:
                print(f"ERROR knowledge root is not a directory: {root}", file=sys.stderr)
            return 1
    else:
        try:
            root = discover_knowledge_root(directory)
        except FileNotFoundError as error:
            if args.verbose:
                print(f"ERROR {error}", file=sys.stderr)
            return 1

    leaves, other_files = tree_files(root)
    selected = [(relative, path) for relative, path in leaves
                if path_matches(relative, tokens)]
    selected_other = [relative for relative in other_files
                      if path_matches(relative, tokens)]
    failed = 0
    failed_paths = set()
    proof_count = 0
    for relative in selected_other:
        failed += 1
        failed_paths.add(relative)
        if args.verbose:
            print(f"ERROR {relative}: non-Markdown file inside knowledge tree")

    proof_directory = root.parent
    for relative, path in selected:
        proofs, errors = parse_proofs(path)
        if args.verbose:
            print(f"LEAF {relative} proofs={len(proofs)}")
        for line, message in errors:
            failed += 1
            failed_paths.add(relative)
            if args.verbose:
                print(f"  ERROR line={line} {message}")
        for line, command, script in proofs:
            proof_count += 1
            passed, detail, stdout, stderr = run_proof(
                command, script, proof_directory, args.timeout)
            if passed:
                if args.verbose:
                    print(f"  PASS line={line} language={command}")
                continue
            failed += 1
            failed_paths.add(relative)
            if args.verbose:
                print(f"  FAIL line={line} language={command} {detail}")
                for label, output in (("stdout", stdout), ("stderr", stderr)):
                    output = clipped(output)
                    if output:
                        print(f"    {label}: {output}")

    if args.verbose:
        print(
            f"SUMMARY root={root} leaves={len(selected)} proofs={proof_count} "
            f"failures={failed}")
    if failed:
        for relative in sorted(failed_paths, key=str):
            print(relative, file=sys.stderr)
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
