#!/usr/bin/env python3
"""Install knowledge trees, startup hooks, and compatibility skills."""

from __future__ import annotations

import argparse
import copy
from datetime import datetime
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile
import tomllib


EXCLUDED_EXAMPLE_LEAVES = {
    Path("where/am/i.md"),
    Path("what/is/next.md"),
    Path("what/is/the/plan.md"),
    Path("what/is/the/spec.md"),
    Path("what/is/the/state.md"),
}
AGENTS_BEGIN = "<!-- BEGIN KNOWLEDGETREES BOOTSTRAP -->"
AGENTS_END = "<!-- END KNOWLEDGETREES BOOTSTRAP -->"
SKILL_LEAVES = {
    "knowledgetrees": Path("how/to/use/knowledgetrees.md"),
    "knowledgetrees-lookup": Path("how/should/an/agent/traverse/a/knowledge/tree.md"),
    "knowledgetrees-capture": Path("how/to/add/knowledge/leaves.md"),
    "knowledgetrees-maintenance": Path("how/to/maintain/a/knowledge/tree.md"),
    "knowledgetrees-ingestion": Path("how/should/legacy/documents/be/ingested/into/a/knowledge/tree.md"),
}


def path_exists(path: Path) -> bool:
    return path.exists() or path.is_symlink()


def containing_device(path: Path) -> int:
    candidate = path.parent
    while not candidate.exists():
        candidate = candidate.parent
    return candidate.stat().st_dev


def writable_target(path: Path) -> Path:
    return path.resolve(strict=True) if path.is_symlink() else path


def rendered_leaf(source: Path) -> bytes:
    text = source.read_text()
    text = text.replace(
        "  scope: public knowledge-tree example and distributable skill\n",
        "  scope: personal global\n",
        1,
    )
    text = text.replace(
        "\nscope: public knowledge-tree example\n",
        "\nscope: personal global\n",
        1,
    )
    text = text.replace("  scope: public knowledge-tree example\n", "  scope: personal global\n", 1)
    return text.encode()


def same_bytes(path: Path, expected: bytes) -> bool:
    try:
        return path.is_file() and path.read_bytes() == expected
    except OSError:
        return False


def same_leaf_bytes(path: Path, expected: bytes) -> bool:
    """Successful proof refreshes are expected local state, not content conflicts."""
    try:
        def normalize(data):
            text = re.sub(r"(?m)^Proof: \(verified at [^)\n]+\)[ \t]*$",
                          "Proof: (verified at _)", data.decode())
            text = re.sub(r"(?m)^checked_at: [^\n]+\n", "", text)
            return re.sub(r'(?m)^status: ["\']?(?:green|yellow)["\']?$',
                          "status: checked", text)
        return path.is_file() and normalize(path.read_bytes()) == normalize(expected)
    except (OSError, UnicodeError):
        return False


def atomic_write(path: Path, content: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def remove_managed_block(current: str) -> str:
    begins = current.count(AGENTS_BEGIN)
    ends = current.count(AGENTS_END)
    if begins != ends or begins > 1:
        raise ValueError("~/AGENTS.md contains malformed knowledgetrees markers")
    if not begins:
        return current
    start = current.index(AGENTS_BEGIN)
    finish = current.index(AGENTS_END, start) + len(AGENTS_END)
    before = current[:start].rstrip("\n")
    after = current[finish:].lstrip("\n")
    if before and after:
        return before + "\n\n" + after
    if before:
        return before + "\n"
    return after


SKILLS_TABLE = re.compile(
    r"(?ms)^\[\[skills\.config\]\]\s*\n.*?(?=^\[|\Z)"
)
PATH_SETTING = re.compile(r"(?m)^path\s*=\s*(['\"])(.*?)\1\s*$")
ENABLED_SETTING = re.compile(r"(?m)^enabled\s*=\s*(?:true|false)[ \t]*$")


def codex_config_text(current: str, skill_path: Path) -> str:
    target = str(skill_path)
    for match in SKILLS_TABLE.finditer(current):
        block = match.group(0)
        path_match = PATH_SETTING.search(block)
        if path_match is None or path_match.group(2) != target:
            continue
        if ENABLED_SETTING.search(block):
            replacement = ENABLED_SETTING.sub("enabled = true", block, count=1)
        else:
            replacement = block.rstrip() + "\nenabled = true\n\n"
        return current[:match.start()] + replacement + current[match.end():]

    encoded_path = json.dumps(target)
    block = (
        "# BEGIN KNOWLEDGETREES SKILL\n"
        "[[skills.config]]\n"
        f"path = {encoded_path}\n"
        "enabled = true\n"
        "# END KNOWLEDGETREES SKILL\n"
    )
    separator = "" if not current else ("\n" if current.endswith("\n") else "\n\n")
    return current + separator + block


def codex_config_without_skills(current: str, skill_paths: list[Path]) -> str:
    """Remove every explicit registration of paths now discovered through ~/.agents/skills."""
    targets = {str(path) for path in skill_paths}

    def retain(match: re.Match[str]) -> str:
        path_match = PATH_SETTING.search(match.group(0))
        return "" if path_match is not None and path_match.group(2) in targets else match.group(0)

    updated = SKILLS_TABLE.sub(retain, current)
    updated = re.sub(
        r"(?m)^# BEGIN KNOWLEDGETREES SKILL[ \t]*\n[ \t]*# END KNOWLEDGETREES SKILL[ \t]*\n?",
        "",
        updated,
    )
    return updated


def opencode_config_text(current: str, target_home: Path) -> str:
    config = json.loads(current) if current.strip() else {}
    if not isinstance(config, dict):
        raise ValueError("OpenCode configuration must be a JSON object")
    original = copy.deepcopy(config)
    permission = config.get("permission", {})
    if isinstance(permission, str):
        permission = {"*": permission}
    if not isinstance(permission, dict):
        raise ValueError("OpenCode permission must be an action or object")
    config["permission"] = permission
    paths = [str(target_home / name) + "/**" for name in (".knowledge", ".agents")]
    defaults = {"read": "allow", "external_directory": "ask", "edit": "allow", "skill": "allow"}
    for kind, default in defaults.items():
        rules = permission.get(kind, {"*": permission.get("*", default)})
        if isinstance(rules, str):
            rules = {"*": rules}
        if not isinstance(rules, dict):
            raise ValueError(f"OpenCode {kind} permission must be an action or object")
        if kind == "read" and kind not in permission and "*" not in permission:
            rules.update({"*.env": "deny", "*.env.*": "deny", "*.env.example": "allow"})
        additions = {name: "allow" for name in SKILL_LEAVES} if kind == "skill" else {
            path: "ask" if kind == "edit" and path == paths[1] else "allow" for path in paths
        }
        for pattern, action in additions.items():
            rules.pop(pattern, None)
            rules[pattern] = action
        permission[kind] = rules
    # Rule order matters even when ordinary dictionary equality reports no change.
    unchanged = json.dumps(config, ensure_ascii=False) == json.dumps(original, ensure_ascii=False)
    return current if unchanged else json.dumps(config, indent=2, ensure_ascii=False) + "\n"


def codex_mcp_text(current: str, server: Path) -> str:
    existing = tomllib.loads(current).get("mcp_servers", {}) if current.strip() else {}
    if not isinstance(existing, dict) or "knowledgetrees" in existing:
        return current  # respect an existing (possibly customized) registration
    separator = "" if not current else ("\n" if current.endswith("\n") else "\n\n")
    return current + separator + (
        "# BEGIN KNOWLEDGETREES MCP\n[mcp_servers.knowledgetrees]\n"
        f"command = \"python3\"\nargs = [{json.dumps(str(server))}]\n# END KNOWLEDGETREES MCP\n")


def opencode_mcp_text(current: str, server: Path) -> str:
    config = json.loads(current) if current.strip() else {}
    if not isinstance(config, dict) or not isinstance(config.get("mcp", {}), dict):
        raise ValueError("OpenCode configuration must be an object whose mcp field is an object")
    if "knowledgetrees" in config.setdefault("mcp", {}):
        return current
    config["mcp"]["knowledgetrees"] = {"type": "local", "command": ["python3", str(server)], "enabled": True}
    return json.dumps(config, indent=2, ensure_ascii=False) + "\n"


def copilot_mcp_bytes(config_path: Path, server: Path) -> bytes:
    storage = writable_target(config_path)
    current = storage.read_text() if storage.is_file() else ""
    config = json.loads(current) if current.strip() else {}
    if not isinstance(config, dict) or not isinstance(config.get("mcpServers", {}), dict):
        raise ValueError("Copilot MCP configuration must be an object whose mcpServers field is an object")
    if "knowledgetrees" in config.setdefault("mcpServers", {}):
        return current.encode()
    config["mcpServers"]["knowledgetrees"] = {"type": "local", "command": "python3", "args": [str(server)], "tools": ["*"]}
    return (json.dumps(config, indent=2) + "\n").encode()


def register_claude_mcp(target_home: Path, server: Path) -> str:
    """Use Claude Code's own CLI: it rewrites ~/.claude.json constantly, so never edit that file directly."""
    environment = {**os.environ, "HOME": str(target_home)}
    try:
        if subprocess.run(["claude", "mcp", "get", "knowledgetrees"], env=environment, cwd=target_home,
                          capture_output=True, timeout=60).returncode == 0:
            return "already registered"
        added = subprocess.run(["claude", "mcp", "add", "--scope", "user", "knowledgetrees", "--", "python3", str(server)],
                               env=environment, cwd=target_home, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return f"skipped (claude CLI unavailable); run: claude mcp add --scope user knowledgetrees -- python3 {shlex.quote(str(server))}"
    return "registered" if added.returncode == 0 else f"failed: {added.stderr.strip()}"


def permission_consent(target_home: Path) -> bool:
    print("WARNING: Installation will grant OpenCode agents automatic read access to:")
    for name in (".knowledge", ".agents"):
        print(f"  {target_home / name}/**")
    print("Folder contents may be sent to your configured model/provider.")
    print(f"Agents will also be allowed to WRITE to {target_home / '.knowledge'}/**.")
    print("The compatibility skill and four knowledge-tree procedure skills will be enabled; edits in .agents still require approval.")
    print("Default installation adds startup knowledge-tree context; non-startup reminder hooks are disabled.")
    while True:
        try:
            answer = input("Grant these permissions and continue installation? [n/Y] ").strip().lower()
        except EOFError:
            print("\nNo consent received; installation cancelled without changes.")
            return False
        if answer in ("", "y", "yes"):
            return True
        if answer in ("n", "no"):
            print("Installation cancelled without changes.")
            return False
        print("Please answer n or Y.")


def claude_settings_bytes(settings_path: Path, handler: Path) -> tuple[bytes, int]:
    """Merge managed Claude Code hooks into settings.json, preserving everything else."""
    storage = writable_target(settings_path)
    current = storage.read_text() if storage.is_file() else ""
    config = json.loads(current) if current.strip() else {}
    if not isinstance(config, dict) or not isinstance(config.get("hooks", {}), dict):
        raise ValueError("Claude Code settings must be an object whose hooks field is an object")
    original = copy.deepcopy(config)
    hooks = config.setdefault("hooks", {})
    for name, event in (("UserPromptSubmit", "prompt"), ("PostToolUse", "after"),
                        ("PostToolUseFailure", "failed"), ("Stop", "stop")):
        groups = hooks.get(name)
        if groups is None:
            continue
        if not isinstance(groups, list) or any(not isinstance(g, dict) or not isinstance(g.get("hooks", []), list) for g in groups):
            raise ValueError(f"malformed Claude Code {name} hooks")
        command = f"python3 {shlex.quote(str(handler))} claude {event}"
        retained = []
        for group in groups:
            remaining = [h for h in group.get("hooks", [])
                         if not (isinstance(h, dict) and h.get("command") == command)]
            if remaining or not group.get("hooks"):
                retained.append({**group, "hooks": remaining})
        if retained:
            hooks[name] = retained
        else:
            hooks.pop(name, None)
    for name, event, matcher in (("SessionStart", "start", "startup|resume|clear|compact"),):
        groups = hooks.setdefault(name, [])
        if not isinstance(groups, list) or any(not isinstance(g, dict) or not isinstance(g.get("hooks", []), list) for g in groups):
            raise ValueError(f"malformed Claude Code {name} hooks")
        command = f"python3 {shlex.quote(str(handler))} claude {event}"
        if not any(isinstance(h, dict) and h.get("command") == command for g in groups for h in g.get("hooks", [])):
            groups.append({**({"matcher": matcher} if matcher else {}),
                           "hooks": [{"type": "command", "command": command, "timeout": 5,
                                      "statusMessage": "Knowledge-tree reminders"}]})
    mode = storage.stat().st_mode & 0o777 if storage.is_file() else 0o600
    return (current if config == original else json.dumps(config, indent=2) + "\n").encode(), mode


def hook_installs(repository: Path, target_home: Path) -> list[tuple[Path, bytes, int]]:
    """Preflight adapters and merge Codex hooks without replacing unrelated hooks."""
    handler = target_home / ".knowledge/.tools/kt-hooks"
    codex_path = target_home / ".codex/hooks.json"
    storage = writable_target(codex_path)
    current = storage.read_text() if storage.is_file() else ""
    config = json.loads(current) if current.strip() else {}
    if not isinstance(config, dict) or not isinstance(config.get("hooks", {}), dict):
        raise ValueError("Codex hooks configuration must contain a hooks object")
    original = copy.deepcopy(config)
    hooks = config.setdefault("hooks", {})
    # Retire only this installer's managed command-rewriting adapter.
    legacy = f"python3 {shlex.quote(str(handler))} codex before"
    if isinstance(hooks.get("PreToolUse"), list):
        retained = []
        for group in hooks["PreToolUse"]:
            if not isinstance(group, dict) or not isinstance(group.get("hooks", []), list):
                raise ValueError("malformed Codex PreToolUse hooks")
            remaining = [h for h in group.get("hooks", [])
                         if not (isinstance(h, dict) and h.get("command") == legacy)]
            if remaining or not group.get("hooks"):
                retained.append({**group, "hooks": remaining})
        if retained:
            hooks["PreToolUse"] = retained
        else:
            hooks.pop("PreToolUse", None)
    for name, event in (("UserPromptSubmit", "prompt"), ("PostToolUse", "after"), ("Stop", "stop")):
        groups = hooks.get(name)
        if groups is None:
            continue
        if not isinstance(groups, list) or any(not isinstance(g, dict) or not isinstance(g.get("hooks", []), list) for g in groups):
            raise ValueError(f"malformed Codex {name} hooks")
        command = f"python3 {shlex.quote(str(handler))} codex {event}"
        retained = []
        for group in groups:
            remaining = [h for h in group.get("hooks", [])
                         if not (isinstance(h, dict) and h.get("command") == command)]
            if remaining or not group.get("hooks"):
                retained.append({**group, "hooks": remaining})
        if retained:
            hooks[name] = retained
        else:
            hooks.pop(name, None)
    for name, event in (("SessionStart", "start"),):
        groups = hooks.setdefault(name, [])
        if not isinstance(groups, list) or any(not isinstance(g, dict) or not isinstance(g.get("hooks", []), list) for g in groups):
            raise ValueError(f"malformed Codex {name} hooks")
        command = f"python3 {shlex.quote(str(handler))} codex {event}"
        if not any(isinstance(h, dict) and h.get("command") == command for g in groups for h in g.get("hooks", [])):
            groups.append({**({"matcher": "Bash"} if event == "before" else
                             {"matcher": "^(startup|resume|clear|compact)$"} if event == "start" else {}),
                           "hooks": [{"type": "command", "command": command,
                            "timeout": 5, **({"additionalContextLimit": 20000} if event == "start" else {}),
                            "statusMessage": "Knowledge-tree reminders"}]})
    codex_bytes = (current if config == original else json.dumps(config, indent=2) + "\n").encode()
    copilot = {"version": 1, "hooks": {name: [{"type": "command", "exec": "python3",
                  "args": [str(handler), "copilot", event], "timeoutSec": 5}]
               for name, event in (("sessionStart", "start"),)}}
    claude_path = target_home / ".claude/settings.json"
    claude_bytes, claude_mode = claude_settings_bytes(claude_path, handler)
    return [
        (handler, (repository / "tools/kt-hooks").read_bytes(), 0o755),
        (target_home / ".config/opencode/plugins/knowledgetrees.js", (repository / "tools/kt-opencode.mjs").read_bytes(), 0o644),
        (codex_path, codex_bytes, 0o600),
        (claude_path, claude_bytes, claude_mode),
        (target_home / ".copilot/hooks/knowledgetrees.json", (json.dumps(copilot, indent=2) + "\n").encode(), 0o600),
    ]


def initial_orientation() -> bytes:
    header = ("---\nstatus: yellow\nrevised_at: " +
              json.dumps(datetime.now().astimezone().isoformat(timespec="seconds")) +
              "\n---\n\n")
    body = """This user-wide root stores reusable tooling and knowledge-tree procedures. Project
and subsystem facts belong in their nearest local roots; private or restricted
material must not be promoted into public exports.

## How to navigate this tree

- `how/` - procedures: `how/to/use/knowledgetrees.md`,
  `how/should/an/agent/traverse/a/knowledge/tree.md`, `how/to/add/knowledge/leaves.md`.
- `what/` - definitions and standing conditions: `what/is/a/knowledge/tree.md`.
- `where/` - environment and tool locations; add actual local location answers as
  they are verified. No host-specific location routes are recorded here yet.
- `why/` - rationale: `why/do/knowledge/lookups/need/observable/gates.md`.
- `when/` - decision conditions: `when/to/ask/clarification.md`.
- `does/` - yes/no behavior questions: `does/kt/prove/verify/an/entire/leaf.md`.
- `is/` - yes/no classification questions: `is/a/knowledge/tree/a/source/of/authorization.md`.

Describe your local environment here, including scope, topology, tools, boundaries,
priorities, and concrete routes. Verify exemplar paths before adding them.
"""
    return (header + body).encode()


def parser_for_cli() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--home",
        type=Path,
        default=Path.home(),
        help="target user home (default: current user's home)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="check conflicts and describe the installation without writing",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="replace differing managed leaves and hook or skill files; orientation is still preserved",
    )
    parser.add_argument("--hooks-only", action="store_true", help="install/update CLI and hooks without replacing installed leaves or skills")
    parser.add_argument("--no-hooks", action="store_true", help="skip hook installation (does not remove existing hooks)")
    parser.add_argument("--no-mcp", action="store_true", help="skip the MCP server and its harness registrations")
    return parser


def main(arguments: list[str] | None = None) -> int:
    args = parser_for_cli().parse_args(arguments)
    repository = Path(__file__).resolve().parent
    example = repository / "example"
    kt_source = repository / "tools" / "kt"
    if not example.is_dir() or not kt_source.is_file():
        print("error: run the installer from a complete knowledgetrees checkout", file=sys.stderr)
        return 2

    target_home = args.home.expanduser().resolve()
    knowledge_root = target_home / ".knowledge"
    if args.hooks_only and not (knowledge_root / "where/am/i.md").is_file():
        print("error: --hooks-only requires an existing knowledge root; run the full installer first", file=sys.stderr)
        return 2
    kt_target = knowledge_root / ".tools" / "kt"
    kt_command = target_home / ".local" / "bin" / "kt"
    skill_links = [
        (knowledge_root / relative, target_home / harness / "skills" / name / "SKILL.md")
        for name, relative in SKILL_LEAVES.items()
        for harness in (".agents", ".claude")
    ]
    retired_codex_skills = [target_home / ".codex" / "skills" / name / "SKILL.md" for name in SKILL_LEAVES]
    if args.hooks_only:
        skill_links = []
    skill_targets = [destination for _canonical, destination in skill_links]

    link_devices = {
        containing_device(path) for canonical, destination in skill_links for path in (canonical, destination)
    }
    if skill_links and len(link_devices) != 1:
        print(
            "error: the knowledge root and skill destinations must share a filesystem",
            file=sys.stderr,
        )
        return 2

    leaf_installs: list[tuple[Path, Path, bytes]] = []
    for source in ([] if args.hooks_only else sorted(example.rglob("*.md"))):
        relative = source.relative_to(example)
        if relative in EXCLUDED_EXAMPLE_LEAVES:
            continue
        leaf_installs.append((source, knowledge_root / relative, rendered_leaf(source)))
    kt_bytes = kt_source.read_bytes()
    conflicts: list[Path] = []
    file_targets = [destination for _source, destination, _content in leaf_installs]
    file_targets.extend((kt_target, kt_command, *skill_targets, *retired_codex_skills))
    hook_files = []
    if not args.no_hooks:
        try:
            hook_files = hook_installs(repository, target_home)
        except (OSError, ValueError, TypeError) as error:
            print(f"error: cannot safely prepare knowledge-tree hooks: {error}", file=sys.stderr)
            return 2
    mcp_server = knowledge_root / ".tools" / "kt-mcp"
    copilot_mcp = target_home / ".copilot" / "mcp-config.json"
    if not args.no_mcp:
        try:
            hook_files.append((mcp_server, (repository / "tools/kt-mcp").read_bytes(), 0o755))
            hook_files.append((copilot_mcp, copilot_mcp_bytes(copilot_mcp, mcp_server), 0o600))
        except (OSError, ValueError, TypeError) as error:
            print(f"error: cannot safely prepare the knowledge-tree MCP server: {error}", file=sys.stderr)
            return 2
    file_targets.extend(path for path, _content, _mode in hook_files)
    invalid_targets = [
        destination
        for destination in file_targets
        if path_exists(destination) and not destination.is_file()
    ]
    for destination in file_targets:
        invalid_targets.extend(parent for parent in destination.parents
                               if path_exists(parent) and not parent.is_dir())
    opencode_config = target_home / ".config" / "opencode" / "opencode.json"
    for destination in (target_home / "AGENTS.md", target_home / ".codex" / "config.toml", opencode_config):
        if path_exists(destination) and not destination.is_file():
            invalid_targets.append(destination)
    if invalid_targets:
        print("Refusing to replace non-file installation targets:", file=sys.stderr)
        for invalid in invalid_targets:
            print(f"  {invalid}", file=sys.stderr)
        return 2

    for _source, destination, content in leaf_installs:
        if path_exists(destination) and not same_leaf_bytes(destination, content):
            conflicts.append(destination)
    for destination in (kt_target, kt_command):
        if path_exists(destination) and not same_bytes(destination, kt_bytes):
            conflicts.append(destination)
    for destination, content, _mode in hook_files:
        # Codex and Claude Code settings are safe merge targets, not managed source bundles.
        if destination not in (target_home / ".codex/hooks.json", target_home / ".claude/settings.json", copilot_mcp) and path_exists(destination) and not same_bytes(destination, content):
            conflicts.append(destination)
    for canonical, destination in skill_links:
        skill_bytes = rendered_leaf(example / canonical.relative_to(knowledge_root))
        if path_exists(destination) and not same_leaf_bytes(destination, skill_bytes):
            conflicts.append(destination)

    agents_path = target_home / "AGENTS.md"
    agents_storage = writable_target(agents_path)
    agents_current = agents_storage.read_text() if agents_storage.is_file() else ""
    try:
        agents_updated = remove_managed_block(agents_current)
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2

    codex_config = target_home / ".codex" / "config.toml"
    config_storage = writable_target(codex_config)
    config_current = config_storage.read_text() if config_storage.is_file() else ""
    config_updated = codex_config_without_skills(config_current, retired_codex_skills)
    try:
        if not args.no_mcp:
            config_updated = codex_mcp_text(config_updated, mcp_server)
        tomllib.loads(config_updated)
    except tomllib.TOMLDecodeError as error:
        print(f"error: cannot safely merge Codex configuration: {error}", file=sys.stderr)
        return 2

    if not path_exists(opencode_config) and path_exists(opencode_config.with_suffix(".jsonc")):
        print("error: OpenCode JSONC configuration exists; integrate its permissions manually before installation", file=sys.stderr)
        return 2
    opencode_storage = writable_target(opencode_config)
    opencode_current = opencode_storage.read_text() if opencode_storage.is_file() else ""
    try:
        opencode_updated = opencode_current if args.hooks_only else opencode_config_text(opencode_current, target_home)
        opencode_final = opencode_updated if args.no_mcp else opencode_mcp_text(opencode_updated, mcp_server)
    except (ValueError, TypeError) as error:
        print(f"error: cannot safely merge OpenCode configuration: {error}", file=sys.stderr)
        return 2

    if conflicts and not args.force:
        print("Refusing to overwrite differing installed content:", file=sys.stderr)
        for conflict in conflicts:
            print(f"  {conflict}", file=sys.stderr)
        print("Review the differences, or rerun with --force to replace them.", file=sys.stderr)
        return 2

    if args.dry_run:
        print(f"Would install {len(leaf_installs)} reusable leaves into {knowledge_root}")
        print(f"Would install kt at {kt_target} and link {kt_command}")
        for destination, _content, _mode in hook_files:
            print(f"Would install {destination}")
        for canonical, destination in skill_links:
            print(f"Would hard-link {destination} to {canonical}")
        for destination in retired_codex_skills:
            if path_exists(destination):
                print(f"Would remove redundant Codex skill entry {destination}")
        if agents_updated != agents_current:
            print(f"Would remove the managed bootstrap from {agents_path}")
        if not args.no_mcp:
            print("Would register the knowledge-tree MCP server with Claude Code (via `claude mcp add`), Codex, OpenCode, and Copilot CLI")
        if config_updated != config_current:
            print(f"Would remove redundant Codex skill registrations from {codex_config}")
        if opencode_updated != opencode_current:
            print(f"Would update {opencode_config} after a permission warning and [n/Y] consent.")
            print(f"Would allow reads of {knowledge_root}/** and {target_home / '.agents'}/**, plus writes to {knowledge_root}/**.")
        return 0

    if opencode_final != opencode_current:
        print("Adding the knowledge-tree MCP server to OpenCode configuration.")
    if opencode_updated != opencode_current and not permission_consent(target_home):
        return 2

    for branch in ("how", "what", "where", "why", "does", "is"):
        (knowledge_root / branch).mkdir(parents=True, exist_ok=True)
    orientation = knowledge_root / "where" / "am" / "i.md"
    if not path_exists(orientation):
        atomic_write(orientation, initial_orientation(), 0o644)

    for _source, destination, content in leaf_installs:
        if destination.is_symlink() or not same_leaf_bytes(destination, content):
            atomic_write(destination, content, 0o644)
    if kt_target.is_symlink() or not same_bytes(kt_target, kt_bytes):
        atomic_write(kt_target, kt_bytes, 0o755)
    else:
        os.chmod(kt_target, 0o755)
    kt_command.parent.mkdir(parents=True, exist_ok=True)
    if not kt_command.is_symlink() or kt_command.resolve() != kt_target:
        if path_exists(kt_command):
            kt_command.unlink()
        kt_command.symlink_to(kt_target)

    for canonical_skill, destination in skill_links:
        destination.parent.mkdir(parents=True, exist_ok=True)
        try:
            already_linked = not destination.is_symlink() and destination.samefile(
                canonical_skill
            )
        except (FileNotFoundError, OSError):
            already_linked = False
        if already_linked:
            continue
        if path_exists(destination):
            if destination.is_dir() and not destination.is_symlink():
                print(f"error: skill destination is a directory: {destination}", file=sys.stderr)
                return 2
            destination.unlink()
        try:
            os.link(canonical_skill, destination)
        except OSError as error:
            print(f"error: could not hard-link {destination}: {error}", file=sys.stderr)
            return 2

    for destination in retired_codex_skills:
        if destination.is_file() or destination.is_symlink():
            destination.unlink()
            try:
                destination.parent.rmdir()
            except OSError:
                pass

    if agents_updated != agents_current:
        if not agents_updated and not agents_path.is_symlink():
            agents_path.unlink()
        else:
            mode = agents_storage.stat().st_mode & 0o777
            atomic_write(agents_storage, agents_updated.encode(), mode)
    if config_updated != config_current:
        mode = config_storage.stat().st_mode & 0o777 if config_storage.exists() else 0o600
        atomic_write(config_storage, config_updated.encode(), mode)
    if opencode_final != opencode_current:
        mode = opencode_storage.stat().st_mode & 0o777 if opencode_storage.exists() else 0o600
        atomic_write(opencode_storage, opencode_final.encode(), mode)
    for destination, content, mode in hook_files:
        storage = writable_target(destination)
        if not same_bytes(storage, content):
            atomic_write(storage, content, mode)

    claude_mcp = None if args.no_mcp else register_claude_mcp(target_home, mcp_server)

    proof_environment = os.environ.copy()
    proof_environment["HOME"] = str(target_home)
    completed = subprocess.run(
        [str(kt_target), "prove", "--root", str(knowledge_root)],
        cwd=target_home,
        env=proof_environment,
        check=False,
    )
    if completed.returncode:
        print("error: installed knowledge-tree verification failed", file=sys.stderr)
        return completed.returncode

    print(f"Installed {len(leaf_installs)} reusable leaves into {knowledge_root}")
    print(f"Installed kt at {kt_target}; command: {kt_command}")
    if hook_files:
        print("Installed startup knowledge-tree context for Claude Code, Codex, OpenCode, and Copilot CLI; non-startup reminders are disabled.")
        print("Claude Code and Codex: review/trust the new definitions with /hooks. Restart OpenCode to load its plugin.")
    if claude_mcp is not None:
        print(f"Knowledge-tree MCP server (lookup, search, edit, access approval, and more) is configured for Codex, OpenCode, and Copilot CLI; Claude Code: {claude_mcp}.")
        print("Restart each harness to load it.")
    if not args.hooks_only:
        print("Installed hard-linked compatibility skills for shared harnesses and Claude Code; retired redundant Codex copies")
    if agents_updated != agents_current:
        print(f"Removed the managed bootstrap from {agents_path}")
    if not args.hooks_only:
        print(f"OpenCode scoped knowledge-tree permissions configured in {opencode_config}")
    print(f"Next: describe the local environment in {orientation}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
